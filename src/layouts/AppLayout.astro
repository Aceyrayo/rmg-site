---
import '../styles/global.css';
import Chatbot from '../components/chatbot.astro';
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | RMG App</title>
		<script is:inline>
			if (localStorage.getItem('rmg_theme') === 'dark' || (!('rmg_theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-slate-50 dark:bg-[#0b0f19] text-slate-900 dark:text-slate-200 font-sans antialiased flex h-[100dvh] overflow-hidden selection:bg-blue-100 dark:selection:bg-blue-900 selection:text-blue-900 dark:selection:text-white transition-colors duration-200">
		
		<!-- MOBILE OVERLAY -->
		<div id="mobileOverlay" class="fixed inset-0 bg-slate-900/50 z-40 hidden md:hidden transition-opacity" onclick="toggleSidebar()"></div>

		<!-- SIDEBAR -->
		<aside id="sidebar" class="w-[260px] bg-white dark:bg-[#080b12] border-r border-slate-200 dark:border-slate-800 flex flex-col h-[100dvh] shrink-0 fixed md:relative inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
			
			<!-- Workspace Selector -->
			<div class="h-16 flex items-center justify-between px-4 border-b border-slate-200 dark:border-slate-800 shrink-0">
				<div class="flex items-center gap-3 w-full">
					<div class="w-8 h-8 rounded bg-slate-900 dark:bg-white flex items-center justify-center text-white dark:text-slate-900 font-bold">
						<svg width="16" height="16" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M16 2L30 10V22L16 30L2 22V10L16 2Z" stroke="currentColor" stroke-width="2" fill="transparent"/>
							<path d="M16 8L23 12V20L16 24L9 20V12L16 8Z" fill="currentColor"/>
						</svg>
					</div>
					<div class="flex-1">
						<p class="text-sm font-bold text-slate-900 dark:text-white leading-tight">RMG Workspace</p>
						<p class="text-xs text-slate-500 dark:text-slate-400">Enterprise</p>
					</div>
					<button class="md:hidden text-slate-500 hover:text-slate-900 dark:hover:text-white" onclick="toggleSidebar()">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
					</button>
				</div>
			</div>
			
			<!-- Navigation -->
			<nav class="flex-1 overflow-y-auto py-4 px-3 space-y-6 scrollbar-thin scrollbar-thumb-slate-700 scrollbar-track-transparent">
				
				<!-- ================= ADMIN SIDEBAR ================= -->
				<div id="adminSidebar" class="hidden space-y-2">
					<details class="group " open><summary class="px-2 py-1.5 flex items-center justify-between cursor-pointer list-none text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider hover:text-slate-700 dark:hover:text-slate-200">Command Center<svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
						<div class="space-y-0.5 mt-1">
							<a data-nav href="/dashboard" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Global Overview</a>
							<a data-nav href="/admin/analytics" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Deep Analytics</a>
							<a data-nav href="/admin/live-feed" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Live Activity Feed</a>
						</div>
					</details>
					<details class="group "><summary class="px-2 py-1.5 flex items-center justify-between cursor-pointer list-none text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider hover:text-slate-700 dark:hover:text-slate-200">User Management<svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
						<div class="space-y-0.5 mt-1">
							<a data-nav href="/admin/users" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">All Accounts</a>
							<a data-nav href="/admin/roles" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Roles & Permissions</a>
							<a data-nav href="/admin/verification" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">KYC Verification</a>
							<a data-nav href="/admin/sessions" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Active Sessions</a>
						</div>
					</details>
					<details class="group "><summary class="px-2 py-1.5 flex items-center justify-between cursor-pointer list-none text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider hover:text-slate-700 dark:hover:text-slate-200">Deployments<svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
						<div class="space-y-0.5 mt-1">
							<a data-nav href="/admin/trading-engines" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Trading Engines</a>
							<a data-nav href="/admin/defense-protocols" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Defense Protocols</a>
							<a data-nav href="/admin/enterprise-nodes" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Enterprise Nodes</a>
							<a data-nav href="/admin/updates" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">System Updates</a>
							<a data-nav href="/admin/rollbacks" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Rollback Manager</a>
						</div>
					</details>
					<details class="group "><summary class="px-2 py-1.5 flex items-center justify-between cursor-pointer list-none text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider hover:text-slate-700 dark:hover:text-slate-200">Financials<svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
						<div class="space-y-0.5 mt-1">
							<a data-nav href="/admin/revenue" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Revenue Overview</a>
							<a data-nav href="/admin/subscriptions" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Subscriptions</a>
							<a data-nav href="/admin/invoices" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Global Invoices</a>
							<a data-nav href="/admin/transactions" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Transaction Logs</a>
							<a data-nav href="/admin/payouts" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Payout Management</a>
						</div>
					</details>
					<details class="group "><summary class="px-2 py-1.5 flex items-center justify-between cursor-pointer list-none text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider hover:text-slate-700 dark:hover:text-slate-200">Communications<svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
						<div class="space-y-0.5 mt-1">
							<a data-nav href="/admin/marketing-inbox" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Marketing Inbox</a>
							<a data-nav href="/admin/tickets" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Support Tickets</a>
							<a data-nav href="/admin/broadcast" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Broadcast Email</a>
							<a data-nav href="/admin/announcements" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">System Announcements</a>
						</div>
					</details>
					<details class="group lg:hidden"><summary class="px-2 py-1.5 flex items-center justify-between cursor-pointer list-none text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider hover:text-slate-700 dark:hover:text-slate-200">Infrastructure<svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
						<div class="space-y-0.5 mt-1">
							<a data-nav href="/admin/system-health" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Server Health</a>
							<a data-nav href="/admin/database" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Database Manager</a>
							<a data-nav href="/admin/api-gateway" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">API Gateway</a>
							<a data-nav href="/admin/firewall" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Firewall Rules</a>
							<a data-nav href="/admin/encryption-keys" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Encryption Keys</a>
							<a data-nav href="/admin/threat-map" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Global Threat Map</a>
						</div>
					</details>
					<details class="group lg:hidden"><summary class="px-2 py-1.5 flex items-center justify-between cursor-pointer list-none text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider hover:text-slate-700 dark:hover:text-slate-200">Developer Tools<svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></summary>
						<div class="space-y-0.5 mt-1">
							<a data-nav href="/admin/api-logs" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">API Request Logs</a>
							<a data-nav href="/admin/error-tracking" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Error Tracking</a>
							<a data-nav href="/admin/webhooks" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Webhook Logs</a>
							<a data-nav href="/admin/audit-trail" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Audit Trail</a>
						</div>
					</details>
				</div>

				<!-- ================= CLIENT SIDEBAR ================= -->
				<div id="clientSidebar" class="hidden space-y-6">
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Main</p>
						<div class="space-y-0.5">
							<a href="/portal" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Overview</a>
						</div>
					</div>

					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">RMG Divisions</p>
						<div class="space-y-0.5">
							<a href="/portal/trading" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Trading Systems</a>
							<a href="/portal/defence" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Defense & Military</a>
							<a href="/portal/enterprise" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Enterprise Tools</a>
						</div>
					</div>

					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Account</p>
						<div class="space-y-0.5">
							<a href="/portal/api-keys" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">API Credentials</a>
							<a href="/portal/security" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Security Center</a>
						</div>
					</div>

					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Manage</p>
						<div class="space-y-0.5">
							<a href="/portal/billing" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Billing</a>
							<a href="/portal/support" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Support Tickets</a>
							<a href="/portal/settings" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Account Settings</a>
						</div>
					</div>
				</div>
			</nav>

			<!-- User Profile -->
			<div class="p-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 relative shrink-0">
				<div id="profileMenu" class="hidden absolute bottom-full left-4 right-4 mb-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl overflow-hidden z-50">
					<div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700">
						<p class="text-sm font-bold text-slate-900 dark:text-white truncate" id="menuName">Loading...</p>
						<p class="text-xs text-slate-500 dark:text-slate-400 truncate" id="menuEmail">loading@email.com</p>
					</div>
					<div class="border-t border-slate-100 dark:border-slate-700 py-1">
						<button id="menuLogoutBtn" class="w-full text-left flex items-center gap-3 px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
							Sign out
						</button>
					</div>
				</div>

				<button id="profileBtn" class="w-full flex items-center justify-between p-2 -mx-2 rounded-lg hover:bg-slate-200/50 dark:hover:bg-slate-800 transition-colors group text-left">
					<div class="flex items-center gap-3">
						<div class="w-9 h-9 rounded-full bg-blue-100 dark:bg-blue-900/50 border border-blue-200 dark:border-blue-800 flex items-center justify-center text-blue-700 dark:text-blue-400 font-bold text-sm shadow-sm">
							<span id="userInitial">U</span>
						</div>
						<div class="flex-1 overflow-hidden">
							<p id="userNameSidebar" class="text-sm font-bold text-slate-900 dark:text-white truncate">Loading...</p>
						</div>
					</div>
				</button>
			</div>
		</aside>

		<!-- MAIN CONTENT AREA -->
		<div class="flex-1 flex flex-col h-[100dvh] overflow-hidden w-full">
			
			<!-- Top Bar -->
			<header class="h-16 bg-white dark:bg-[#080b12] border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-4 md:px-8 shrink-0 transition-colors duration-200">
				<div class="flex items-center gap-4">
					<button class="md:hidden text-slate-500 hover:text-slate-900 dark:hover:text-white" onclick="toggleSidebar()">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
					</button>
					<div class="hidden sm:flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
						<span>RMG Portal</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						<span class="text-slate-900 dark:text-white font-semibold">{title}</span>
					</div>
				</div>
				<div class="flex items-center gap-4">
				<nav id="adminTopNav" class="hidden lg:flex items-center gap-1 text-sm font-medium">
					<div class="relative group"><button class="px-3 py-1.5 rounded-md text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-1">Infrastructure<svg class="w-4 h-4 transition-transform " fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button><div class="hidden group-hover:block group-focus-within:block absolute right-0 top-full pt-2 w-56 z-50"><div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl py-1"><a data-nav href="/admin/system-health" class="block px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700">Server Health</a><a data-nav href="/admin/database" class="block px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700">Database Manager</a><a data-nav href="/admin/api-gateway" class="block px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700">API Gateway</a><a data-nav href="/admin/firewall" class="block px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700">Firewall Rules</a><a data-nav href="/admin/encryption-keys" class="block px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700">Encryption Keys</a><a data-nav href="/admin/threat-map" class="block px-4 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700">Global Threat Map</a></div></div></div>
