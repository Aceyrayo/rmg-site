---
import '../styles/global.css';
import Chatbot from '../components/chatbot.astro';
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | RMG App</title>
		<script is:inline>
			if (localStorage.getItem('rmg_theme') === 'dark' || (!('rmg_theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-slate-50 dark:bg-[#0b0f19] text-slate-900 dark:text-slate-200 font-sans antialiased flex h-[100dvh] overflow-hidden selection:bg-blue-100 dark:selection:bg-blue-900 selection:text-blue-900 dark:selection:text-white transition-colors duration-200">
		
		<!-- MOBILE OVERLAY -->
		<div id="mobileOverlay" class="fixed inset-0 bg-slate-900/50 z-40 hidden md:hidden transition-opacity" onclick="toggleSidebar()"></div>

		<!-- SIDEBAR -->
		<aside id="sidebar" class="w-[260px] bg-white dark:bg-[#080b12] border-r border-slate-200 dark:border-slate-800 flex flex-col h-[100dvh] shrink-0 fixed md:relative inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
			
			<!-- Workspace Selector -->
			<div class="h-16 flex items-center justify-between px-4 border-b border-slate-200 dark:border-slate-800 shrink-0">
				<div class="flex items-center gap-3 w-full">
					<div class="w-8 h-8 rounded bg-slate-900 dark:bg-white flex items-center justify-center text-white dark:text-slate-900 font-bold">
						<svg width="16" height="16" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M16 2L30 10V22L16 30L2 22V10L16 2Z" stroke="currentColor" stroke-width="2" fill="transparent"/>
							<path d="M16 8L23 12V20L16 24L9 20V12L16 8Z" fill="currentColor"/>
						</svg>
					</div>
					<div class="flex-1">
						<p class="text-sm font-bold text-slate-900 dark:text-white leading-tight">RMG Workspace</p>
						<p class="text-xs text-slate-500 dark:text-slate-400">Enterprise</p>
					</div>
					<button class="md:hidden text-slate-500 hover:text-slate-900 dark:hover:text-white" onclick="toggleSidebar()">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
					</button>
				</div>
			</div>
			
			<!-- Navigation -->
			<nav class="flex-1 overflow-y-auto py-4 px-3 space-y-6 scrollbar-thin scrollbar-thumb-slate-700 scrollbar-track-transparent">
				
				<!-- ================= ADMIN SIDEBAR ================= -->
				<div id="adminSidebar" class="hidden space-y-6">
					
					<!-- Core Command -->
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Command Center</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/dashboard" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Global Overview</a>
							<a data-side-nav href="/admin/analytics" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Deep Analytics</a>
							<a data-side-nav href="/admin/live-feed" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Live Activity Feed</a>
						</div>
					</div>

					<!-- User Management -->
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">User Management</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/admin/users" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">All Accounts</a>
							<a data-side-nav href="/admin/roles" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Roles & Permissions</a>
							<a data-side-nav href="/admin/verification" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">KYC Verification</a>
							<a data-side-nav href="/admin/sessions" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Active Sessions</a>
						</div>
					</div>

					<!-- Deployments & Engines -->
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Deployments</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/admin/trading-engines" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Trading Engines</a>
							<a data-side-nav href="/admin/defense-protocols" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Defense Protocols</a>
							<a data-side-nav href="/admin/enterprise-nodes" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Enterprise Nodes</a>
							<a data-side-nav href="/admin/updates" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">System Updates</a>
							<a data-side-nav href="/admin/rollbacks" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Rollback Manager</a>
						</div>
					</div>

					<!-- Infrastructure & Security -->
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Infrastructure</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/admin/system-health" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Server Health</a>
							<a data-side-nav href="/admin/database" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Database Manager</a>
							<a data-side-nav href="/admin/api-gateway" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">API Gateway</a>
							<a data-side-nav href="/admin/firewall" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Firewall Rules</a>
							<a data-side-nav href="/admin/encryption-keys" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Encryption Keys</a>
							<a data-side-nav href="/admin/threat-map" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Global Threat Map</a>
						</div>
					</div>

					<!-- Financials -->
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Financials</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/admin/revenue" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Revenue Overview</a>
							<a data-side-nav href="/admin/subscriptions" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Subscriptions</a>
							<a data-side-nav href="/admin/invoices" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Global Invoices</a>
							<a data-side-nav href="/admin/transactions" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Transaction Logs</a>
							<a data-side-nav href="/admin/payouts" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Payout Management</a>
						</div>
					</div>

					<!-- Communications & Support -->
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Communications</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/admin/marketing-inbox" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Marketing Inbox</a>
							<a data-side-nav href="/admin/tickets" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Support Tickets</a>
							<a data-side-nav href="/admin/waitlist" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Game Waitlists</a>
							<a data-side-nav href="/admin/broadcast" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Broadcast Email</a>
							<a data-side-nav href="/admin/announcements" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">System Announcements</a>
						</div>
					</div>

					<!-- Dev Tools -->
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Developer Tools</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/admin/api-logs" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">API Request Logs</a>
							<a data-side-nav href="/admin/error-tracking" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Error Tracking</a>
							<a data-side-nav href="/admin/webhooks" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Webhook Logs</a>
							<a data-side-nav href="/admin/audit-trail" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Audit Trail</a>
						</div>
					</div>
				</div>

				<!-- ================= CLIENT SIDEBAR ================= -->
				<div id="clientSidebar" class="hidden space-y-6">
					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Main</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/portal" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Overview</a>
							<a data-side-nav href="/portal/analytics" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Analytics & Reports</a>
							<a href="/biz" class="flex items-center justify-between px-2 py-2 text-sm font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 rounded-md transition-colors">
								<span>BizManager</span>
								<span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-emerald-600 text-white">Open</span>
							</a>
						</div>
					</div>

					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">RMG Divisions</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/portal/bots" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Trading Bots</a>
							<a data-side-nav href="/portal/defense" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Defense & Military</a>
							<a data-side-nav href="/portal/enterprise" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Enterprise Tools</a>
							<a data-side-nav href="/portal/integrations" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Integrations</a>
						</div>
					</div>

					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Account & API</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/portal/api-keys" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">API Credentials</a>
							<a data-side-nav href="/portal/api-docs" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">API Documentation</a>
							<a data-side-nav href="/portal/security" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Security Center</a>
							<a data-side-nav href="/portal/logs" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">System Logs</a>
							<a data-side-nav href="/portal/audit-logs" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Audit Logs</a>
						</div>
					</div>

					<div>
						<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Manage</p>
						<div class="space-y-0.5">
							<a data-side-nav href="/portal/billing" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Billing</a>
							<a data-side-nav href="/portal/support" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Support Tickets</a>
							<a data-side-nav href="/portal/settings" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Account Settings</a>
						</div>
					</div>
				</div>
			</nav>

			<!-- User Profile -->
			<div class="p-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 relative shrink-0">
				<div id="profileMenu" class="hidden absolute bottom-full left-4 right-4 mb-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl overflow-hidden z-50">
					<div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700">
						<p class="text-sm font-bold text-slate-900 dark:text-white truncate" id="menuName">Loading...</p>
						<p class="text-xs text-slate-500 dark:text-slate-400 truncate" id="menuEmail">loading@email.com</p>
					</div>
					<div class="border-t border-slate-100 dark:border-slate-700 py-1">
						<button id="menuLogoutBtn" class="w-full text-left flex items-center gap-3 px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
							Sign out
						</button>
					</div>
				</div>

				<button id="profileBtn" class="w-full flex items-center justify-between p-2 -mx-2 rounded-lg hover:bg-slate-200/50 dark:hover:bg-slate-800 transition-colors group text-left">
					<div class="flex items-center gap-3">
						<div class="w-9 h-9 rounded-full bg-blue-100 dark:bg-blue-900/50 border border-blue-200 dark:border-blue-800 flex items-center justify-center text-blue-700 dark:text-blue-400 font-bold text-sm shadow-sm">
							<span id="userInitial">U</span>
						</div>
						<div class="flex-1 overflow-hidden">
							<p id="userNameSidebar" class="text-sm font-bold text-slate-900 dark:text-white truncate">Loading...</p>
						</div>
					</div>
				</button>
			</div>
		</aside>

		<!-- MAIN CONTENT AREA -->
		<div class="flex-1 flex flex-col h-[100dvh] overflow-hidden w-full">
			
			<!-- Top Bar -->
			<header class="h-16 bg-white dark:bg-[#080b12] border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-4 md:px-8 shrink-0 transition-colors duration-200">
				<div class="flex items-center gap-4">
					<button class="md:hidden text-slate-500 hover:text-slate-900 dark:hover:text-white" onclick="toggleSidebar()">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
					</button>
					<div class="hidden sm:flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
						<span>RMG Portal</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						<span class="text-slate-900 dark:text-white font-semibold">{title}</span>
					</div>
				</div>
				<div class="flex items-center gap-3">
					<a id="topBizBtn" href="/biz" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm transition-colors">
						<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
						<span id="topBizLabel">BizManager</span>
					</a>
					<div class="hidden sm:flex items-center gap-2 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 rounded-full border border-slate-200 dark:border-slate-700">
						<span class="w-2 h-2 rounded-full bg-emerald-500"></span> Online
					</div>
				</div>
			</header>

			<!-- Dynamic Page Content -->
			<main class="flex-1 overflow-y-auto p-4 pb-24 md:p-8 md:pb-8 relative bg-slate-50 dark:bg-[#0b0f19] transition-colors duration-200">
				<slot />
			</main>
		</div>

		<!-- App Logic -->
		<script is:inline>
			function toggleSidebar() {
				const sidebar = document.getElementById('sidebar');
				const overlay = document.getElementById('mobileOverlay');
				if (sidebar.classList.contains('-translate-x-full')) {
					sidebar.classList.remove('-translate-x-full');
					overlay.classList.remove('hidden');
				} else {
					sidebar.classList.add('-translate-x-full');
					overlay.classList.add('hidden');
				}
			}

			document.addEventListener('DOMContentLoaded', () => {
				const token = localStorage.getItem('rmg_token');
				const role = localStorage.getItem('rmg_role');
				const name = localStorage.getItem('rmg_name');
				const email = localStorage.getItem('rmg_email');

				if (!token) {
					window.location.href = '/login';
					return;
				}

				const nameEl = document.getElementById('userNameSidebar');
				const menuNameEl = document.getElementById('menuName');
				const initialEl = document.getElementById('userInitial');
				const emailEl = document.getElementById('menuEmail');

				if (name) {
					if (nameEl) nameEl.innerText = name;
					if (menuNameEl) menuNameEl.innerText = name;
					if (initialEl) initialEl.innerText = name.charAt(0).toUpperCase();
				}
				if (email && emailEl) emailEl.innerText = email;

				// ROLE-BASED SIDEBAR SWITCHING
				if (role === 'admin') {
					document.getElementById('adminSidebar').classList.remove('hidden');
					document.getElementById('clientSidebar').classList.add('hidden');
				} else {
					document.getElementById('clientSidebar').classList.remove('hidden');
					document.getElementById('adminSidebar').classList.add('hidden');
				}

				// Highlight current sidebar link
				const curPath = window.location.pathname.replace(/\/+$/, '') || '/portal';
				document.querySelectorAll('[data-side-nav]').forEach((a) => {
					const href = (a.getAttribute('href') || '').replace(/\/+$/, '');
					if (href === curPath) {
						a.classList.add('bg-blue-50', 'dark:bg-blue-900/20', 'text-blue-700', 'dark:text-blue-400', 'font-semibold');
					}
				});

				// Pre-load user's active BizManager workspace into the top bar button
				const apiBase = typeof API_URL !== 'undefined' ? API_URL : 'https://rmg-api-e46k.onrender.com';
				fetch(`${apiBase}/api/biz/workspaces`, {
					headers: { Authorization: `Bearer ${token}` }
				})
					.then(r => (r.ok ? r.json() : null))
					.then(data => {
						const list = data?.workspaces || [];
						if (!list.length) return;
						const saved = +localStorage.getItem('biz_ws');
						const ws = list.find(w => w.id === saved) || list[0];
						localStorage.setItem('biz_ws', ws.id);
						const lbl = document.getElementById('topBizLabel');
						if (lbl) lbl.textContent = `BizManager · ${ws.name}`;
					})
					.catch(() => {});

				const profileBtn = document.getElementById('profileBtn');
				const profileMenu = document.getElementById('profileMenu');

				if (profileBtn && profileMenu) {
					profileBtn.addEventListener('click', (e) => {
						e.stopPropagation();
						profileMenu.classList.toggle('hidden');
					});

					document.addEventListener('click', (e) => {
						if (!profileMenu.contains(e.target) && !profileBtn.contains(e.target)) {
							profileMenu.classList.add('hidden');
						}
					});
				}

				const logout = () => {
					localStorage.clear();
					window.location.replace('/login');
				};

				const logoutBtn = document.getElementById('menuLogoutBtn');
				if (logoutBtn) logoutBtn.addEventListener('click', logout);
			});
		</script>

		<!-- CHATBOT -->
		<Chatbot />
	</body>
</html>