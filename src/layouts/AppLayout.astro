---
import '../styles/global.css';
import Chatbot from '../components/chatbot.astro'; // Import it here
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | RMG App</title>
		<script is:inline>
			if (localStorage.getItem('rmg_theme') === 'dark' || (!('rmg_theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-slate-50 dark:bg-[#0b0f19] text-slate-900 dark:text-slate-200 font-sans antialiased flex h-screen overflow-hidden selection:bg-blue-100 dark:selection:bg-blue-900 selection:text-blue-900 dark:selection:text-blue-100 transition-colors duration-200">
		
		<!-- MOBILE OVERLAY (Darkens screen when sidebar is open on mobile) -->
		<div id="mobileOverlay" class="fixed inset-0 bg-slate-900/50 z-40 hidden md:hidden transition-opacity" onclick="toggleSidebar()"></div>

		<!-- SIDEBAR (Hidden by default on mobile, slides in) -->
		<aside id="sidebar" class="w-[260px] bg-white dark:bg-[#080b12] border-r border-slate-200 dark:border-slate-800 flex flex-col h-screen shrink-0 fixed md:relative inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
			
			<!-- Workspace Selector -->
			<div class="h-16 flex items-center justify-between px-4 border-b border-slate-200 dark:border-slate-800">
				<div class="flex items-center gap-3 w-full">
					<div class="w-8 h-8 rounded bg-slate-900 dark:bg-white flex items-center justify-center text-white dark:text-slate-900 font-bold">
						<svg width="16" height="16" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M16 2L30 10V22L16 30L2 22V10L16 2Z" stroke="currentColor" stroke-width="2" fill="transparent"/>
							<path d="M16 8L23 12V20L16 24L9 20V12L16 8Z" fill="currentColor"/>
						</svg>
					</div>
					<div class="flex-1">
						<p class="text-sm font-bold text-slate-900 dark:text-white leading-tight">RMG Workspace</p>
						<p class="text-xs text-slate-500 dark:text-slate-400">Enterprise</p>
					</div>
					<!-- Close button (Mobile only) -->
					<button class="md:hidden text-slate-500 hover:text-slate-900 dark:hover:text-white" onclick="toggleSidebar()">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
					</button>
				</div>
			</div>
			
			<!-- Navigation (Scrollable) -->
			<nav class="flex-1 overflow-y-auto py-4 px-3 space-y-6 scrollbar-thin scrollbar-thumb-slate-700 scrollbar-track-transparent">
				
				<div>
					<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Main</p>
					<div class="space-y-0.5">
						<a href="/portal" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Overview</a>
						<a href="/dashboard" id="navAdmin" class="hidden items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Admin Command</a>
					</div>
				</div>

				<div>
					<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">RMG Divisions</p>
					<div class="space-y-0.5">
						<a href="/portal/trading" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Trading Systems</a>
						<a href="/portal/defence" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Defense & Military</a>
						<a href="/portal/enterprise" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Enterprise Tools</a>
					</div>
				</div>

				<div>
					<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Account</p>
					<div class="space-y-0.5">
						<a href="/portal/api-keys" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">API Credentials</a>
						<a href="/portal/security" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Security Center</a>
					</div>
				</div>

				<div>
					<p class="px-2 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Manage</p>
					<div class="space-y-0.5">
						<a href="/portal/billing" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Billing</a>
						<a href="/portal/support" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Support Tickets</a>
						<a href="/portal/settings" class="flex items-center gap-3 px-2 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-colors">Account Settings</a>
					</div>
				</div>
			</nav>

			<!-- Bottom: User Profile -->
			<div class="p-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 relative">
				<div id="profileMenu" class="hidden absolute bottom-full left-4 right-4 mb-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-xl overflow-hidden z-50">
					<div class="px-4 py-3 border-b border-slate-100 dark:border-slate-700">
						<p class="text-sm font-bold text-slate-900 dark:text-white truncate" id="menuName">Loading...</p>
						<p class="text-xs text-slate-500 dark:text-slate-400 truncate" id="menuEmail">loading@email.com</p>
					</div>
					<div class="border-t border-slate-100 dark:border-slate-700 py-1">
						<button id="menuLogoutBtn" class="w-full text-left flex items-center gap-3 px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
							Sign out
						</button>
					</div>
				</div>

				<button id="profileBtn" class="w-full flex items-center justify-between p-2 -mx-2 rounded-lg hover:bg-slate-200/50 dark:hover:bg-slate-800 transition-colors group text-left">
					<div class="flex items-center gap-3">
						<div class="w-9 h-9 rounded-full bg-blue-100 dark:bg-blue-900/50 border border-blue-200 dark:border-blue-800 flex items-center justify-center text-blue-700 dark:text-blue-400 font-bold text-sm shadow-sm">
							<span id="userInitial">U</span>
						</div>
						<div class="flex-1 overflow-hidden">
							<p id="userNameSidebar" class="text-sm font-bold text-slate-900 dark:text-white truncate">Loading...</p>
						</div>
					</div>
				</button>
			</div>
		</aside>

		<!-- MAIN CONTENT AREA -->
		<div class="flex-1 flex flex-col h-screen overflow-hidden w-full">
			
			<!-- Top Bar -->
			<header class="h-16 bg-white dark:bg-[#080b12] border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-4 md:px-8 shrink-0 transition-colors duration-200">
				<div class="flex items-center gap-4">
					<!-- HAMBURGER MENU (Mobile only) -->
					<button class="md:hidden text-slate-500 hover:text-slate-900 dark:hover:text-white" onclick="toggleSidebar()">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
					</button>
					<div class="hidden sm:flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
						<span>RMG Portal</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
						<span class="text-slate-900 dark:text-white font-semibold">{title}</span>
					</div>
				</div>
				<div class="flex items-center gap-4">
					<div class="hidden sm:flex items-center gap-2 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800 px-3 py-1.5 rounded-full border border-slate-200 dark:border-slate-700">
						<span class="w-2 h-2 rounded-full bg-emerald-500"></span> Online
					</div>
				</div>
			</header>

			<!-- Dynamic Page Content -->
			<main class="flex-1 overflow-y-auto p-4 md:p-8 relative bg-slate-50 dark:bg-[#0b0f19] transition-colors duration-200">
				<slot />
			</main>
		</div>

		<!-- App Logic -->
		<script is:inline>
			function toggleSidebar() {
				const sidebar = document.getElementById('sidebar');
				const overlay = document.getElementById('mobileOverlay');
				if (sidebar.classList.contains('-translate-x-full')) {
					sidebar.classList.remove('-translate-x-full');
					overlay.classList.remove('hidden');
				} else {
					sidebar.classList.add('-translate-x-full');
					overlay.classList.add('hidden');
				}
			}

			document.addEventListener('DOMContentLoaded', () => {
				const token = localStorage.getItem('rmg_token');
				const role = localStorage.getItem('rmg_role');
				const name = localStorage.getItem('rmg_name');
				const email = localStorage.getItem('rmg_email');

				if (!token) {
					window.location.href = '/login';
					return;
				}

				const nameEl = document.getElementById('userNameSidebar');
				const menuNameEl = document.getElementById('menuName');
				const initialEl = document.getElementById('userInitial');
				const emailEl = document.getElementById('menuEmail');

				if (name) {
					if (nameEl) nameEl.innerText = name;
					if (menuNameEl) menuNameEl.innerText = name;
					if (initialEl) initialEl.innerText = name.charAt(0).toUpperCase();
				}
				if (email && emailEl) emailEl.innerText = email;

				if (role === 'admin') {
					const adminBtn = document.getElementById('navAdmin');
					if (adminBtn) {
						adminBtn.classList.remove('hidden');
						adminBtn.classList.add('flex');
					}
				}

				const profileBtn = document.getElementById('profileBtn');
				const profileMenu = document.getElementById('profileMenu');

				if (profileBtn && profileMenu) {
					profileBtn.addEventListener('click', (e) => {
						e.stopPropagation();
						profileMenu.classList.toggle('hidden');
					});

					document.addEventListener('click', (e) => {
						if (!profileMenu.contains(e.target) && !profileBtn.contains(e.target)) {
							profileMenu.classList.add('hidden');
						}
					});
				}

				const logout = () => {
					localStorage.clear();
					window.location.replace('/login');
				};

				const logoutBtn = document.getElementById('menuLogoutBtn');
				if (logoutBtn) logoutBtn.addEventListener('click', logout);
			});
		</script>

		<!-- CHATBOT -->
		<Chatbot />
	</body>
</html>