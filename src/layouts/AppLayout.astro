			</main>
		</div>

		<!-- App Logic -->
		<script is:inline>
			function toggleSidebar() {
				const sidebar = document.getElementById('sidebar');
				const overlay = document.getElementById('mobileOverlay');
				if (sidebar.classList.contains('-translate-x-full')) {
					sidebar.classList.remove('-translate-x-full');
					overlay.classList.remove('hidden');
				} else {
					sidebar.classList.add('-translate-x-full');
					overlay.classList.add('hidden');
				}
			}

			document.addEventListener('DOMContentLoaded', () => {
				const token = localStorage.getItem('rmg_token');
				const role = localStorage.getItem('rmg_role');
				const name = localStorage.getItem('rmg_name');
				const email = localStorage.getItem('rmg_email');

				if (!token) {
					window.location.href = '/login';
					return;
				}

				const nameEl = document.getElementById('userNameSidebar');
				const menuNameEl = document.getElementById('menuName');
				const initialEl = document.getElementById('userInitial');
				const emailEl = document.getElementById('menuEmail');

				if (name) {
					if (nameEl) nameEl.innerText = name;
					if (menuNameEl) menuNameEl.innerText = name;
					if (initialEl) initialEl.innerText = name.charAt(0).toUpperCase();
				}
				if (email && emailEl) emailEl.innerText = email;

				// ROLE-BASED SIDEBAR SWITCHING
				if (role === 'admin') {
					document.getElementById('adminSidebar').classList.remove('hidden');
					document.getElementById('clientSidebar').classList.add('hidden');
				} else {
					document.getElementById('clientSidebar').classList.remove('hidden');
					document.getElementById('adminSidebar').classList.add('hidden');
				}

				const tn = document.getElementById('adminTopNav');
				if (tn && role !== 'admin') tn.remove();
				document.querySelectorAll('[data-nav]').forEach(a => {
					if (a.getAttribute('href') === location.pathname.replace(/\/$/, '')) { a.classList.add('bg-blue-50','dark:bg-blue-900/20','text-blue-700','dark:text-blue-400'); a.closest('details')?.setAttribute('open',''); }
				});
				// System announcements (managed in Admin > System Announcements)
				fetch('https://rmg-api-e46k.onrender.com/api/announcements').then(r => r.json()).then(list => {
					const bar = document.getElementById('announceBar'); if (!bar) return;
					const e = s => String(s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
					const col = { info:'bg-blue-50 border-blue-200 text-blue-800 dark:bg-blue-900/20 dark:border-blue-800 dark:text-blue-300', warning:'bg-amber-50 border-amber-200 text-amber-800 dark:bg-amber-900/20 dark:border-amber-800 dark:text-amber-300', critical:'bg-red-50 border-red-200 text-red-800 dark:bg-red-900/20 dark:border-red-800 dark:text-red-300' };
					bar.innerHTML = list.map(a => `<div class="border rounded-lg px-4 py-3 text-sm ${col[a.level] || col.info}"><b>${e(a.title)}</b> — ${e(a.message)}</div>`).join('');
				}).catch(() => {});

				const profileBtn = document.getElementById('profileBtn');
				const profileMenu = document.getElementById('profileMenu');

				if (profileBtn && profileMenu) {
					profileBtn.addEventListener('click', (e) => {
						e.stopPropagation();
						profileMenu.classList.toggle('hidden');
					});

					document.addEventListener('click', (e) => {
						if (!profileMenu.contains(e.target) && !profileBtn.contains(e.target)) {
							profileMenu.classList.add('hidden');
						}
					});
				}

				const logout = () => {
					localStorage.clear();
					window.location.replace('/login');
				};

				const logoutBtn = document.getElementById('menuLogoutBtn');
				if (logoutBtn) logoutBtn.addEventListener('click', logout);
			});
		</script>

		<!-- CHATBOT -->
		<Chatbot />
	</body>
</html>