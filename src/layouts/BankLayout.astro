---
import '../styles/global.css';
import AdminKit from '../components/AdminKit.astro';
const { title = 'RMG SavannaBank' } = Astro.props;

const nav = [
	['Overview', '/bank', 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6'],
	['Send & Wallets', '/bank/transfers', 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4'],
	['Micro-Loans', '/bank/loans', 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z'],
	['Markets (NSE & Crypto)', '/bank/markets', 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'],
	['Security Vault', '/bank/security', 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'],
];
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | RMG SavannaBank</title>
		<script is:inline>
			if (localStorage.getItem('rmg_theme') === 'dark' || (!('rmg_theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-slate-50 dark:bg-[#060a13] text-slate-900 dark:text-slate-100 font-sans antialiased flex h-[100dvh] overflow-hidden">
		<div id="bankOv" class="fixed inset-0 bg-slate-950/60 z-40 hidden md:hidden"></div>

		<aside id="bankSide" class="w-[264px] bg-white dark:bg-[#080d18] border-r border-slate-200 dark:border-slate-800/80 flex flex-col h-[100dvh] shrink-0 fixed md:relative inset-y-0 left-0 z-50 -translate-x-full md:translate-x-0 transition-transform duration-300">
			<div class="h-16 flex items-center gap-3 px-4 border-b border-slate-200 dark:border-slate-800/80 shrink-0">
				<div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-cyan-600 text-white flex items-center justify-center font-black shadow-sm">SB</div>
				<div class="leading-tight">
					<p class="text-sm font-extrabold tracking-tight text-slate-900 dark:text-white">RMG SavannaBank</p>
					<p class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">Pan-African Core Ledger</p>
				</div>
			</div>

			<nav class="flex-1 overflow-y-auto p-3 space-y-1">
				{nav.map(([label, href, d]) => (
					<a data-bank-nav href={href} class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/70 rounded-xl transition-colors">
						<svg class="w-4 h-4 shrink-0 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d}></path>
						</svg>
						<span>{label}</span>
					</a>
				))}
			</nav>

			<div class="p-3 border-t border-slate-200 dark:border-slate-800/80 space-y-1 text-sm">
				<a href="/products" class="block px-3 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/70">All RMG Products</a>
				<a href="/portal" class="block px-3 py-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/70">← RMG Portal</a>
				<button id="bankLogout" class="w-full text-left px-3 py-2 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20">Sign out</button>
			</div>
		</aside>

		<div class="flex-1 flex flex-col h-[100dvh] overflow-hidden min-w-0">
			<header class="h-16 bg-white/90 dark:bg-[#080d18]/90 backdrop-blur border-b border-slate-200 dark:border-slate-800/80 flex items-center justify-between px-4 md:px-8 shrink-0">
				<div class="flex items-center gap-3 min-w-0">
					<button id="bankMenuBtn" class="md:hidden text-slate-500 hover:text-slate-900 dark:hover:text-white">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
					</button>
					<h1 class="font-bold text-slate-900 dark:text-white truncate">{title}</h1>
				</div>
				<div class="flex items-center gap-3">
					<span id="bankAntiPhish" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">
						<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
						<span>Phrase: SAVANNA-GUARD</span>
					</span>
					<a href="/bank/transfers" class="btn btn-p !px-3.5 !py-1.5 text-xs">Send Money</a>
				</div>
			</header>

			<main class="flex-1 overflow-y-auto p-4 md:p-8 pb-24 md:pb-8">
				<AdminKit />
				<script is:inline>
					(() => {
						if (!localStorage.getItem('rmg_token')) {
							location.href = '/login';
							return;
						}
						const side = document.getElementById('bankSide');
						const ov = document.getElementById('bankOv');
						const tog = () => {
							side.classList.toggle('-translate-x-full');
							ov.classList.toggle('hidden');
						};
						document.getElementById('bankMenuBtn').onclick = tog;
						ov.onclick = tog;
						document.getElementById('bankLogout').onclick = () => {
							localStorage.clear();
							location.replace('/login');
						};
						const cur = location.pathname.replace(/\/+$/, '') || '/bank';
						document.querySelectorAll('[data-bank-nav]').forEach(a => {
							const href = (a.getAttribute('href') || '').replace(/\/+$/, '');
							if (href === cur) {
								a.classList.add('bg-emerald-500/10', 'text-emerald-700', 'dark:text-emerald-400', 'font-semibold');
							}
						});
						window.BANK = {
							api: (p, opts) => api('/api/bank' + p, opts),
							json: (method, body) => ({ method, body: JSON.stringify(body) }),
							fmtMoney: (amt, curr = 'KES') => {
								try {
									return new Intl.NumberFormat(undefined, { style: 'currency', currency: curr, maximumFractionDigits: 2 }).format(Number(amt || 0));
								} catch (_) {
									return `${curr} ${Number(amt || 0).toFixed(2)}`;
								}
							}
						};
					})();
				</script>
				<slot />
			</main>
		</div>
	</body>
</html>
