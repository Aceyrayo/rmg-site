---
// Shared admin helpers (api, esc, toast, table, badge, downloadCsv) + small UI styles.
---
<style is:global>
	.card{background:#fff;border:1px solid #e2e8f0;border-radius:.75rem;box-shadow:0 1px 2px #0000000d;overflow:hidden}
	.dark .card{background:#0f172a;border-color:#1e293b}
	.inp{border:1px solid #cbd5e1;background:#fff;border-radius:.5rem;padding:.5rem .75rem;font-size:.875rem;color:inherit;width:100%;outline:none}
	.inp:focus{border-color:#2563eb;box-shadow:0 0 0 3px #2563eb22}
	.dark .inp{background:#020617;border-color:#334155}
	.btn{border:1px solid #cbd5e1;border-radius:.5rem;padding:.4rem .8rem;font-size:.8rem;font-weight:600;cursor:pointer;background:transparent;color:inherit;white-space:nowrap}
	.btn:hover{background:#f1f5f9}.dark .btn{border-color:#334155}.dark .btn:hover{background:#1e293b}
	.btn-p{background:#2563eb;border-color:#2563eb;color:#fff}.btn-p:hover{background:#1d4ed8}
	.btn-d{color:#dc2626}.btn:disabled{opacity:.5;cursor:not-allowed}
</style>
<script is:inline>
	const API_URL = 'https://rmg-api-e46k.onrender.com';
	const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
	async function api(path, opts = {}) {
		const res = await fetch(API_URL + path, { ...opts, headers: { 'Authorization': 'Bearer ' + localStorage.getItem('rmg_token'), 'Content-Type': 'application/json', ...(opts.headers || {}) } });
		if (res.status === 401) { location.href = '/login'; throw new Error('Session expired'); }
		if (res.status === 403) { location.href = '/portal'; throw new Error('Admin access required'); }
		const data = await res.json().catch(() => ({}));
		if (!res.ok) throw new Error(typeof data.detail === 'string' ? data.detail : 'Request failed');
		return data;
	}
	function toast(msg, isErr) {
		const t = document.createElement('div');
		t.textContent = msg;
		t.className = 'fixed bottom-6 right-6 z-[100] px-4 py-3 rounded-lg shadow-xl text-sm font-semibold text-white ' + (isErr ? 'bg-red-600' : 'bg-emerald-600');
		document.body.appendChild(t); setTimeout(() => t.remove(), 3000);
	}
	const BADGES = { red:'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400', green:'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400', amber:'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400', blue:'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400', slate:'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300' };
	const badge = (text, color = 'slate') => `<span class="text-xs font-bold px-2 py-0.5 rounded-full ${BADGES[color]}">${esc(text)}</span>`;
	function table(el, cols, rows) {
		if (!rows.length) { el.innerHTML = '<div class="p-10 text-center text-sm text-slate-500">Nothing here yet.</div>'; return; }
		el.innerHTML = '<table class="w-full text-sm text-left"><thead class="bg-slate-50 dark:bg-slate-900/50 text-xs uppercase text-slate-500"><tr>' + cols.map(c => `<th class="px-4 py-3 font-semibold">${c.h}</th>`).join('') + '</tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-800">' + rows.map((r, i) => '<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30">' + cols.map(c => `<td class="px-4 py-3 align-middle">${c.f(r, i)}</td>`).join('') + '</tr>').join('') + '</tbody></table>';
	}
	function downloadCsv(name, rows) {
		if (!rows.length) return toast('Nothing to export', true);
		const keys = Object.keys(rows[0]);
		const q = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
		const csv = [keys.join(','), ...rows.map(r => keys.map(k => q(r[k])).join(','))].join('\n');
		const a = document.createElement('a');
		a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = name; a.click();
	}

	const money = n => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
	const pageHead = (t, s, extra = '') => `<div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-bold text-slate-900 dark:text-white">${t}</h1><p class="text-sm text-slate-500">${s || ''}</p></div><div class="flex gap-2">${extra}</div></div>`;
	const stat = (l, v, c = '') => `<div class="card p-5"><p class="text-sm font-semibold text-slate-500">${l}</p><p class="text-3xl font-bold mt-1 ${c || 'text-slate-900 dark:text-white'}">${v}</p></div>`;
	const panel = (t, body) => `<div class="card p-5"><h2 class="font-bold text-slate-900 dark:text-white mb-4">${t}</h2>${body}</div>`;
	const bars = (items, fmt = v => v) => { const m = Math.max(1, ...items.map(i => i[1])); return items.length ? items.map(([l, v]) => `<div class="mb-3"><div class="flex justify-between text-xs mb-1"><span class="text-slate-600 dark:text-slate-300">${esc(l)}</span><span class="font-mono text-slate-500">${fmt(v)}</span></div><div class="h-2 rounded bg-slate-100 dark:bg-slate-800"><div class="h-2 rounded bg-blue-600" style="width:${v / m * 100}%"></div></div></div>`).join('') : '<p class="text-sm text-slate-500">No data yet.</p>'; };
	const patchRec = (kind, id, data) => api(`/api/admin/records/${kind}/${id}`, { method: 'PATCH', body: JSON.stringify({ data }) });
	const statusColor = s => ({ Active:'green', Running:'green', Online:'green', Enforced:'green', Released:'green', Completed:'green', Paid:'green', Executed:'green', Approved:'green', Pending:'amber', Planned:'amber', Requested:'amber', Processing:'amber', Degraded:'amber', Monitoring:'amber', Provisioning:'amber', Paused:'amber', Failed:'red', Offline:'red', Stopped:'red', Disabled:'red', Cancelled:'red', Rejected:'red', 'Past Due':'red', Revoked:'red' }[s] || 'slate');

	// Generic CRUD page backed by /api/admin/records/{kind}
	async function crudPage(c) {
		const m = c.mount || 'app', g = s => document.getElementById(m + '-' + s), root = document.getElementById(m);
		let all = [], view = [], users = [], editing = null;
		if (c.fields.some(f => f.t === 'user')) { try { users = (await api('/api/admin/users')).map(u => u.email); } catch (e) {} }
		const sf = c.fields.find(f => f.k === c.status);
		root.innerHTML = pageHead(c.title, `<span id="${m}-cnt">${c.sub || ''}</span>`, `<button id="${m}-exp" class="btn">Export CSV</button><button id="${m}-new" class="btn btn-p">+ New ${c.noun}</button>`) + `
		<div class="card mt-6"><div class="p-4 border-b border-slate-200 dark:border-slate-800"><input id="${m}-q" class="inp sm:max-w-xs" placeholder="Search…"></div><div id="${m}-tbl" class="overflow-x-auto"></div></div>
		<dialog id="${m}-dlg" class="card p-0 w-full max-w-lg backdrop:bg-slate-900/60 text-slate-900 dark:text-slate-200"><form id="${m}-frm" class="p-6 space-y-4"><h2 id="${m}-dt" class="text-lg font-bold"></h2><div id="${m}-flds" class="space-y-3"></div><div class="flex justify-end gap-2 pt-2"><button type="button" id="${m}-cancel" class="btn">Cancel</button><button class="btn btn-p">Save</button></div></form></dialog>`;
		const input = (f, v) => { const b = `id="${m}-f-${f.k}" class="inp" ${f.req ? 'required' : ''}`;
			if (f.t === 'select' || f.t === 'user') return `<select ${b}>${(f.t === 'user' ? users : f.o).map(o => `<option ${o == v ? 'selected' : ''}>${esc(o)}</option>`).join('')}</select>`;
			if (f.t === 'textarea') return `<textarea rows="3" ${b}>${esc(v)}</textarea>`;
			return `<input type="${f.t || 'text'}" ${f.t === 'number' ? 'step="any"' : ''} value="${esc(v)}" placeholder="${esc(f.p || '')}" ${b} />`; };
		const draw = () => {
			const q = g('q').value.toLowerCase(); view = all.filter(r => JSON.stringify(r).toLowerCase().includes(q));
			g('cnt').textContent = view.length + ' records';
			table(g('tbl'), [...c.cols.map(col => ({ h: col.l, f: r => col.k === c.status ? `<select class="inp !py-1 !w-auto" data-s="${r.id}">${sf.o.map(o => `<option ${o === r[col.k] ? 'selected' : ''}>${o}</option>`).join('')}</select>` : esc(r[col.k]) })),
				{ h: '', f: r => `<div class="flex gap-1 justify-end">${(c.actions || []).map((a, i) => `<button class="btn" data-act="${i}" data-id="${r.id}">${a.label}</button>`).join('')}<button class="btn" data-e="${r.id}">Edit</button><button class="btn btn-d" data-d="${r.id}">Delete</button></div>` }], view);
		};
		const load = async () => { try { all = await api('/api/admin/records/' + c.kind); draw(); } catch (e) { toast(e.message, true); } };
		const open = r => { editing = r; g('dt').textContent = (r ? 'Edit ' : 'New ') + c.noun;
			g('flds').innerHTML = c.fields.filter(f => !f.edit || r).map(f => `<div><label class="text-xs font-semibold text-slate-500">${f.l}</label>${input(f, r ? r[f.k] ?? '' : '')}</div>`).join(''); g('dlg').showModal(); };
		g('new').onclick = () => open(null); g('cancel').onclick = () => g('dlg').close(); g('q').oninput = draw;
		g('exp').onclick = () => downloadCsv(c.kind + '.csv', view);
		g('frm').onsubmit = async e => { e.preventDefault(); const data = {};
			c.fields.filter(f => !f.edit || editing).forEach(f => { const v = g('f-' + f.k).value; data[f.k] = f.t === 'number' ? Number(v) : v; });
			try { if (editing) await patchRec(c.kind, editing.id, data); else if (c.onCreate) await c.onCreate(data); else await api('/api/admin/records/' + c.kind, { method: 'POST', body: JSON.stringify({ data }) });
				g('dlg').close(); toast('Saved'); load(); } catch (err) { toast(err.message, true); } };
		g('tbl').addEventListener('click', async e => { const b = e.target.closest('button'); if (!b) return;
			try { if (b.dataset.e) open(all.find(r => r.id == b.dataset.e));
				else if (b.dataset.d) { if (!confirm('Delete this record?')) return; await api(`/api/admin/records/${c.kind}/${b.dataset.d}`, { method: 'DELETE' }); toast('Deleted'); load(); }
				else if (b.dataset.act) { await c.actions[b.dataset.act].run(all.find(r => r.id == b.dataset.id)); toast('Done'); load(); } } catch (err) { toast(err.message, true); } });
		g('tbl').addEventListener('change', async e => { if (!e.target.dataset.s) return;
			try { await patchRec(c.kind, e.target.dataset.s, { [c.status]: e.target.value }); toast('Status updated'); load(); } catch (err) { toast(err.message, true); } });
		load();
	}

	// Read-only list page (logs, routes, sessions…) with search, export, optional polling and row actions
	function listPage(c) {
		const m = c.mount || 'app', g = s => document.getElementById(m + '-' + s); let all = [], view = [];
		document.getElementById(m).innerHTML = pageHead(c.title, `<span id="${m}-cnt"></span>`, `<button id="${m}-exp" class="btn">Export CSV</button><button id="${m}-ref" class="btn">Refresh</button>`) + `<div class="card mt-6"><div class="p-4 border-b border-slate-200 dark:border-slate-800"><input id="${m}-q" class="inp sm:max-w-xs" placeholder="Filter…"></div><div id="${m}-tbl" class="overflow-x-auto"></div></div>`;
		const draw = () => { const q = g('q').value.toLowerCase(); view = all.filter(r => JSON.stringify(r).toLowerCase().includes(q)); g('cnt').textContent = `${view.length} of ${all.length} ${c.sub || ''}`; table(g('tbl'), c.cols, view); };
		const load = async () => { try { all = await api(c.url); draw(); } catch (e) { toast(e.message, true); } };
		g('q').oninput = draw; g('ref').onclick = load; g('exp').onclick = () => downloadCsv((c.file || 'export') + '.csv', view);
		g('tbl').addEventListener('click', async e => { const b = e.target.closest('button[data-ix]'); if (!b || !c.onAction) return; try { await c.onAction(b.dataset.a, view[+b.dataset.ix], load); } catch (err) { toast(err.message, true); } });
		if (c.poll) setInterval(load, c.poll); load(); return load;
	}
</script>
