---
// One template, two studios. Edit the config in reezgames.astro / clutchco.astro.
import StudioLayout from '../layouts/StudioLayout.astro';
const { s } = Astro.props;
const t = s.theme;
const year = new Date().getFullYear();
---
<StudioLayout title={`${s.name} — Coming Soon`} description={s.description} icon={s.icon} themeColor={t.bg}>
<style>
	@keyframes floaty { 0%,100% { transform: translateY(0) rotate(0) } 50% { transform: translateY(-14px) rotate(3deg) } }
	@keyframes marquee { from { transform: translateX(0) } to { transform: translateX(-50%) } }
	@keyframes shine { from { background-position: 0% 50% } to { background-position: 200% 50% } }
	.floaty { animation: floaty 7s ease-in-out infinite }
	.marquee { animation: marquee 28s linear infinite }
	.shine { background-size: 200% auto; animation: shine 6s linear infinite }
	.grid-bg { background-image: linear-gradient(var(--g) 1px, transparent 1px), linear-gradient(90deg, var(--g) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse at 50% 30%, #000 30%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at 50% 30%, #000 30%, transparent 75%) }
</style>

<!-- NAV -->
<header class="sticky top-0 z-40 backdrop-blur-md border-b border-white/10" style={`background:${t.bg}cc`}>
	<div class="max-w-6xl mx-auto px-5 py-3 flex items-center justify-between">
		<a href="#top" class="flex items-center gap-3"><img src={s.icon} alt={`${s.name} logo`} width="38" height="38" class="rounded-xl" /><span class="font-extrabold tracking-tight text-lg">{s.name}</span></a>
		<nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-white/70">
			<a href="#games" class="hover:text-white transition-colors">Games</a>
			<a href="#about" class="hover:text-white transition-colors">About</a>
			<a href="#partner" class="hover:text-white transition-colors">Partner</a>
			<a href="#faq" class="hover:text-white transition-colors">FAQ</a>
		</nav>
		<a href="#notify" class={`text-sm font-bold px-5 py-2 rounded-full text-white transition-all ${t.btn}`}>Notify me</a>
	</div>
</header>

<main id="top" class="relative overflow-hidden">
	<!-- HERO -->
	<section class="relative">
		<div class="grid-bg absolute inset-0 pointer-events-none" style={`--g:${t.grid}`}></div>
		<div class={`absolute -top-32 -left-24 w-[480px] h-[480px] rounded-full blur-[120px] pointer-events-none ${t.glowA}`}></div>
		<div class={`absolute top-20 -right-24 w-[420px] h-[420px] rounded-full blur-[120px] pointer-events-none ${t.glowB}`}></div>
		<div class="relative max-w-4xl mx-auto px-5 pt-20 sm:pt-28 pb-24 text-center">
			<img src={s.icon} alt="" width="112" height="112" class="floaty mx-auto mb-8 rounded-[28px] shadow-2xl" style={`box-shadow:0 20px 70px ${t.shadow}`} />
			<div class={`inline-flex items-center gap-2 rounded-full border px-4 py-1.5 mb-6 text-xs font-bold tracking-[0.2em] uppercase ${t.chip}`}>
				<span class={`w-2 h-2 rounded-full animate-pulse ${t.dot}`}></span> Coming Soon
			</div>
			<h1 class="text-5xl sm:text-7xl font-black tracking-tight leading-[1.05] mb-6">
				{s.headA} <span class={`shine bg-gradient-to-r bg-clip-text text-transparent ${t.grad}`}>{s.headB}</span>{s.headC}
			</h1>
			<p class="text-lg sm:text-xl text-white/70 max-w-2xl mx-auto mb-10 leading-relaxed">{s.sub}</p>

			<form class="waitlist-form max-w-md mx-auto" data-brand={s.name}>
				<div class="flex flex-col sm:flex-row gap-3">
					<input type="email" required placeholder="Your email address" aria-label="Email address" class={`flex-1 rounded-full bg-white/10 border border-white/15 px-5 py-3.5 text-white placeholder-white/40 focus:outline-none focus:ring-2 ${t.ring}`} />
					<button class={`rounded-full px-7 py-3.5 font-bold text-white transition-all shadow-lg ${t.btn}`}>Join the waitlist</button>
				</div>
				<p class="form-msg hidden mt-4 text-sm rounded-xl px-4 py-2 border"></p>
				<p class="join-count hidden mt-3 text-xs text-white/50"></p>
			</form>
		</div>
	</section>

	<!-- MARQUEE -->
	<div class="border-y border-white/10 overflow-hidden py-4 bg-white/[0.03]">
		<div class="marquee flex w-max gap-10 whitespace-nowrap text-sm font-black tracking-[0.3em] uppercase text-white/30">
			{Array.from({ length: 16 }).map(() => <span class="flex items-center gap-10">Coming soon <span class={`w-1.5 h-1.5 rounded-full ${t.dot}`}></span> {s.name}<span class={`w-1.5 h-1.5 rounded-full ${t.dot}`}></span></span>)}
		</div>
	</div>

	<!-- GAMES -->
	<section id="games" class="max-w-6xl mx-auto px-5 py-24">
		<div class="text-center mb-14"><p class={`text-xs font-bold tracking-[0.25em] uppercase mb-3 ${t.link}`}>The lineup</p><h2 class="text-3xl sm:text-5xl font-black tracking-tight">First titles in development</h2><p class="text-white/60 mt-4 max-w-xl mx-auto">Names, trailers and release dates are announced here first. Join the waitlist so you never miss a reveal.</p></div>
		<div class="grid md:grid-cols-3 gap-6">
			{s.games.map((g, i) => (
				<article class="group relative rounded-3xl border border-white/10 overflow-hidden bg-white/[0.04] hover:-translate-y-2 transition-transform duration-300">
					<div class={`relative h-56 bg-gradient-to-br ${g.art} flex items-center justify-center overflow-hidden`}>
						<img src={s.icon} alt="" class="w-28 h-28 opacity-20 blur-[2px] group-hover:opacity-35 group-hover:scale-110 transition-all duration-500" />
						<span class="absolute top-4 left-4 text-[10px] font-black tracking-widest uppercase bg-black/40 backdrop-blur px-3 py-1 rounded-full">Game {String(i + 1).padStart(2, '0')}</span>
						<span class="absolute bottom-4 right-4 flex items-center gap-1.5 text-[10px] font-bold tracking-widest uppercase bg-black/50 backdrop-blur px-3 py-1 rounded-full"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>Locked</span>
					</div>
					<div class="p-6">
						<h3 class="text-xl font-extrabold mb-1">{g.title}</h3>
						<p class="text-white/60 text-sm leading-relaxed mb-4">{g.blurb}</p>
						<div class="flex flex-wrap gap-2">{[g.genre, ...g.tags].map(x => <span class={`text-[11px] font-semibold px-2.5 py-1 rounded-full border ${t.chip}`}>{x}</span>)}</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- ABOUT / PILLARS -->
	<section id="about" class="border-y border-white/10 bg-white/[0.02]">
		<div class="max-w-6xl mx-auto px-5 py-24">
			<div class="text-center mb-14"><p class={`text-xs font-bold tracking-[0.25em] uppercase mb-3 ${t.link}`}>What we stand for</p><h2 class="text-3xl sm:text-5xl font-black tracking-tight">{s.aboutTitle}</h2></div>
			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
				{s.pillars.map(([title, d], i) => (
					<div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6"><div class={`w-10 h-10 rounded-xl flex items-center justify-center font-black mb-4 text-white ${t.btn}`}>{i + 1}</div><h3 class="font-bold mb-2">{title}</h3><p class="text-sm text-white/60 leading-relaxed">{d}</p></div>
				))}
			</div>
		</div>
	</section>

	<!-- PARTNERSHIP -->
	<section id="partner" class="max-w-5xl mx-auto px-5 py-24">
		<div class="relative rounded-[2rem] border border-white/10 bg-gradient-to-br from-white/[0.07] to-white/[0.02] p-8 sm:p-14 overflow-hidden">
			<div class={`absolute -bottom-24 -right-24 w-72 h-72 rounded-full blur-[90px] pointer-events-none ${t.glowA}`}></div>
			<div class="relative flex flex-col md:flex-row items-center gap-10">
				<div class="flex items-center gap-4 shrink-0">
					<img src={s.icon} alt={s.name} width="84" height="84" class="rounded-2xl" />
					<span class="text-2xl text-white/40 font-light">×</span>
					<div class="w-[84px] h-[84px] rounded-2xl bg-white flex items-center justify-center">
						<svg width="46" height="46" viewBox="0 0 32 32" fill="none"><path d="M16 2L30 10V22L16 30L2 22V10L16 2Z" stroke="#0f172a" stroke-width="2"/><path d="M16 8L23 12V20L16 24L9 20V12L16 8Z" fill="#0f172a"/></svg>
					</div>
				</div>
				<div class="text-center md:text-left">
					<p class={`text-xs font-bold tracking-[0.25em] uppercase mb-2 ${t.link}`}>In partnership with</p>
					<h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-3">RMG Technologies</h2>
					<p class="text-white/65 leading-relaxed mb-6">{s.partnerText}</p>
					<a href="/" class="inline-flex items-center gap-2 text-sm font-bold bg-white text-slate-900 px-6 py-2.5 rounded-full hover:bg-white/90 transition-colors">Visit RMG Technologies <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</div>
	</section>

	<!-- WAITLIST CTA -->
	<section id="notify" class="px-5 pb-24">
		<div class={`max-w-4xl mx-auto rounded-[2rem] p-10 sm:p-16 text-center bg-gradient-to-br ${t.cta}`}>
			<h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-3">Be first in line.</h2>
			<p class="text-white/80 mb-8 max-w-lg mx-auto">Get launch news, early-access invites and behind-the-scenes updates from {s.name}. No spam — ever.</p>
			<form class="waitlist-form max-w-md mx-auto" data-brand={s.name}>
				<div class="flex flex-col sm:flex-row gap-3">
					<input type="email" required placeholder="Your email address" aria-label="Email address" class="flex-1 rounded-full bg-white/20 border border-white/30 px-5 py-3.5 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white" />
					<button class="rounded-full px-7 py-3.5 font-bold bg-white text-slate-900 hover:bg-white/90 transition-colors">Notify me</button>
				</div>
				<p class="form-msg hidden mt-4 text-sm rounded-xl px-4 py-2 border"></p>
			</form>
		</div>
	</section>

	<!-- FAQ -->
	<section id="faq" class="max-w-3xl mx-auto px-5 pb-24">
		<h2 class="text-3xl font-black tracking-tight text-center mb-10">Questions</h2>
		<div class="rounded-2xl border border-white/10 divide-y divide-white/10 bg-white/[0.03]">
			{s.faq.map(([q, a]) => (
				<details class="group p-6"><summary class="flex justify-between items-center cursor-pointer list-none font-semibold">{q}<span class="text-white/40 group-open:rotate-45 transition-transform text-2xl leading-none">+</span></summary><p class="text-white/60 text-sm leading-relaxed mt-3">{a}</p></details>
			))}
		</div>
	</section>
</main>

<!-- FOOTER -->
<footer class="border-t border-white/10">
	<div class="max-w-6xl mx-auto px-5 py-12 grid md:grid-cols-3 gap-10 text-sm">
		<div><div class="flex items-center gap-3 mb-3"><img src={s.icon} alt="" width="34" height="34" class="rounded-lg" /><span class="font-extrabold text-lg">{s.name}</span></div><p class="text-white/50 leading-relaxed max-w-xs">{s.tagline}</p></div>
		<div>
			<h4 class="font-bold mb-3">Also in the family</h4>
			<a href={s.sister.href} class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.04] hover:bg-white/[0.08] p-3 transition-colors"><img src={s.sister.icon} alt="" width="40" height="40" class="rounded-lg" /><span><span class="block font-bold">{s.sister.name}</span><span class="text-xs text-white/50">Coming soon →</span></span></a>
		</div>
		<div>
			<h4 class="font-bold mb-3">Links</h4>
			<ul class="space-y-2 text-white/60"><li><a href="/" class="hover:text-white">RMG Technologies</a></li><li><a href="/contact" class="hover:text-white">Contact</a></li><li><a href="/privacy" class="hover:text-white">Privacy Policy</a></li><li><a href="/terms" class="hover:text-white">Terms of Service</a></li></ul>
		</div>
	</div>
	<div class="border-t border-white/10"><div class="max-w-6xl mx-auto px-5 py-5 flex flex-col sm:flex-row justify-between gap-2 text-xs text-white/40"><p>© {year} {s.name}. All rights reserved.</p><p>In partnership with <a href="/" class="underline hover:text-white">RMG Technologies</a></p></div></div>
</footer>

<script is:inline define:vars={{ brand: s.name }}>
	document.querySelectorAll('.waitlist-form').forEach(form => {
		const input = form.querySelector('input'), btn = form.querySelector('button'), msg = form.querySelector('.form-msg'), label = btn.textContent;
		form.addEventListener('submit', async e => {
			e.preventDefault(); btn.disabled = true; btn.textContent = 'Joining…'; msg.classList.add('hidden');
			const r = await RMG.call('/api/waitlist', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value.trim(), brand }) }, () => { btn.textContent = 'Waking up server…'; });
			msg.className = 'form-msg mt-4 text-sm rounded-xl px-4 py-2 border ' + (r.ok ? 'text-emerald-200 bg-emerald-500/15 border-emerald-400/30' : 'text-red-200 bg-red-500/15 border-red-400/30');
			msg.textContent = r.ok ? r.data.message : r.message;
			if (r.ok) input.value = '';
			btn.disabled = false; btn.textContent = label;
		});
	});
	// Show a social-proof line once there are enough sign-ups to look good
	RMG.call('/api/waitlist/count?brand=' + encodeURIComponent(brand)).then(r => {
		const el = document.querySelector('.join-count');
		if (r.ok && r.data.count >= 10 && el) { el.textContent = 'Join ' + r.data.count.toLocaleString() + ' others already on the list'; el.classList.remove('hidden'); }
	});
</script>
</StudioLayout>
