---
import Layout from '../../layouts/layout.astro';
---

<Layout title="RMG BizManager">
	<main class="bg-white dark:bg-[#030712] transition-colors duration-200">
		
		<!-- Hero -->
		<section class="relative max-w-7xl mx-auto px-8 pt-24 pb-20 text-center">
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-blue-500/10 blur-[100px] rounded-full -z-10"></div>
			
			<div class="inline-flex items-center gap-2 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-full px-4 py-1.5 mb-6">
				<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
				<span class="text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider">Version 1.0 is Live</span>
			</div>

			<h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-slate-900 dark:text-white mb-6">
				Run your entire business <br/>
				<span class="text-blue-600 dark:text-blue-500">from one screen.</span>
			</h1>
			
			<p class="text-xl text-slate-500 dark:text-slate-400 max-w-2xl mx-auto mb-10">
				RMG BizManager is the all-in-one dashboard for SMEs. Track sales, manage inventory, monitor expenses, and generate financial reports instantly.
			</p>

			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="/signup" class="w-full sm:w-auto bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-8 py-3 rounded-lg font-bold shadow-lg hover:scale-105 transition-transform">
					Start Free Trial
				</a>
				<a href="/contact" class="w-full sm:w-auto bg-transparent border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white px-8 py-3 rounded-lg font-bold hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
					Request a Demo
				</a>
			</div>
		</section>

		<!-- Features Section -->
		<section class="border-y border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/30 py-24">
			<div class="max-w-7xl mx-auto px-8">
				<div class="text-center mb-16">
					<h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Everything you need to scale.</h2>
					<p class="text-slate-500 dark:text-slate-400">Built for retail shops, wholesalers, and growing enterprises.</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8">
					<!-- Feature 1 -->
					<div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
						<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 text-blue-600 rounded-xl flex items-center justify-center mb-4">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
						</div>
						<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Inventory Tracking</h3>
						<p class="text-sm text-slate-500 dark:text-slate-400">Know exactly what is in stock. Get low-stock alerts before you run out of your best sellers.</p>
					</div>
					<!-- Feature 2 -->
					<div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
						<div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 rounded-xl flex items-center justify-center mb-4">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
						</div>
						<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Real-Time Analytics</h3>
						<p class="text-sm text-slate-500 dark:text-slate-400">See your daily revenue, top-selling products, and cash flow instantly on your dashboard.</p>
					</div>
					<!-- Feature 3 -->
					<div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
						<div class="w-12 h-12 bg-purple-100 dark:bg-purple-900/30 text-purple-600 rounded-xl flex items-center justify-center mb-4">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
						</div>
						<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Invoice Generation</h3>
						<p class="text-sm text-slate-500 dark:text-slate-400">Generate professional PDF invoices for customers with one click, and track who owes you money.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Pricing -->
		<section class="py-24 max-w-7xl mx-auto px-8 text-center">
			<h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-16">Simple, transparent pricing.</h2>
			
			<div class="max-w-md mx-auto bg-slate-900 dark:bg-white rounded-3xl p-8 shadow-2xl relative">
				<div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-blue-600 text-white px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Standard Plan</div>
				
				<div class="text-5xl font-bold text-white dark:text-slate-900 mt-4 mb-2">$29<span class="text-lg text-slate-400 dark:text-slate-500 font-normal">/mo</span></div>
				<p class="text-slate-400 dark:text-slate-500 mb-8">Per business, unlimited staff accounts.</p>
				
				<ul class="text-left space-y-4 mb-8 text-sm text-slate-300 dark:text-slate-600">
					<li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Unlimited Products</li>
					<li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Real-Time Inventory</li>
					<li class="flex items-center gap-2"><span class="text-blue-500">✓</span> Invoice Generator</li>
					<li class="flex items-center gap-2"><span class="text-blue-500">✓</span> 24/7 Support</li>
				</ul>
				
				<a href="/signup" class="block w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl transition-colors">Get Started</a>
			</div>
		</section>

	</main>
</Layout>