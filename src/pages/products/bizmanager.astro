---
import Layout from '../../layouts/layout.astro';
// Add explicit types for the arrays
type Feature = [string, string, string, string];
type FAQ = [string, string];
const features = [
	['Point of sale & receipts', 'Ring up sales in seconds with product search, barcode / SKU entry, discounts, tax and printable receipts.', 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.3 2.3c-.6.6-.2 1.7.7 1.7H17', 'blue'],
	['Inventory you can trust', 'Live stock levels, low-stock alerts, stock history for every product, weighted-average costing and CSV import.', 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4', 'emerald'],
	['Invoices & payments', 'Create professional invoices, take part-payments, email them to customers and see exactly who owes you.', 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.6a1 1 0 01.7.3l5.4 5.4a1 1 0 01.3.7V19a2 2 0 01-2 2z', 'purple'],
	['Customers & receivables', 'Keep every customer\'s history, statements and balances in one place, with overdue invoices flagged automatically.', 'M17 20h5v-2a3 3 0 00-5.4-1.9M17 20H7m10 0v-2m-10 2H2v-2a3 3 0 015.4-1.9M15 7a3 3 0 11-6 0 3 3 0 016 0z', 'amber'],
	['Expenses & profit reports', 'Record expenses and see real profit — revenue, cost of goods, gross and net — by day, month or custom range.', 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z', 'rose'],
	['Team & roles', 'Unlimited staff accounts. Give cashiers, managers and accountants exactly the access they need — nothing more.', 'M12 4.4a4 4 0 110 5.2M16 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2m12-10l2 2 4-4', 'sky']
];
const tone: Record<string, string> = { blue: 'bg-blue-100 dark:bg-blue-900/30 text-blue-600', emerald: 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600', purple: 'bg-purple-100 dark:bg-purple-900/30 text-purple-600', amber: 'bg-amber-100 dark:bg-amber-900/30 text-amber-600', rose: 'bg-rose-100 dark:bg-rose-900/30 text-rose-600', sky: 'bg-sky-100 dark:bg-sky-900/30 text-sky-600' };
const who = ['Retail shops', 'Wholesalers & distributors', 'Pharmacies & clinics', 'Restaurants & cafés', 'Salons & service businesses', 'Hardware & building supplies', 'Online sellers', 'Growing SMEs'];
const faqs = [
	['Is there a free trial?', 'Yes — 14 days, with every feature unlocked and no card required. Create an account, set up your business and start selling.'],
	['What happens when the trial ends?', 'Your data stays safe and you can still view everything. To keep adding sales and stock, our team activates your plan — just contact us.'],
	['How many staff accounts can I add?', 'Unlimited. The $29 plan is per business, not per user, and each person gets a role (Manager, Cashier or Accountant).'],
	['Can I manage more than one business?', 'Yes. You can run up to three businesses from one login and switch between them in a click.'],
	['Can I bring my existing products in?', 'Absolutely. Import your product list from a CSV file (Excel can save to CSV) in under a minute.'],
	['Is my business data secure?', 'BizManager runs on RMG\'s secure infrastructure. Each business is fully isolated, access is role-based and every request is authenticated.']
];
---
<Layout title="RMG BizManager" description="All-in-one business management for SMEs: point of sale, inventory, invoicing, customers, expenses and profit reports. 14-day free trial.">
<main class="bg-white dark:bg-[#030712] transition-colors duration-200">

<!-- Hero -->
<section class="relative max-w-7xl mx-auto px-6 sm:px-8 pt-20 sm:pt-24 pb-16 text-center">
	<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-blue-500/10 blur-[100px] rounded-full -z-10"></div>
	<a href="/products" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900 dark:hover:text-white mb-6">← All products</a><br/>
	<div class="inline-flex items-center gap-2 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-full px-4 py-1.5 mb-6">
		<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
		<span class="text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider">Version 1.0 is Live</span>
	</div>
	<h1 class="text-4xl sm:text-5xl md:text-7xl font-bold tracking-tighter text-slate-900 dark:text-white mb-6">Run your entire business <br class="hidden sm:block"/><span class="text-blue-600 dark:text-blue-500">from one screen.</span></h1>
	<p class="text-lg sm:text-xl text-slate-500 dark:text-slate-400 max-w-2xl mx-auto mb-10">RMG BizManager is the all-in-one platform for small and medium businesses. Sell, track stock, invoice customers, control expenses and see your real profit — instantly.</p>
	<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
		<a data-cta href="/signup?plan=bizmanager" class="w-full sm:w-auto bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-8 py-3 rounded-lg font-bold shadow-lg hover:scale-105 transition-transform">Start Free Trial</a>
		<a href="/contact?topic=Sales%20enquiry" class="w-full sm:w-auto bg-transparent border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white px-8 py-3 rounded-lg font-bold hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">Request a Demo</a>
	</div>
	<p class="text-sm text-slate-500 mt-5">14-day free trial · No credit card · Unlimited staff</p>

	<!-- Product preview (illustration) -->
	<div class="relative max-w-4xl mx-auto mt-16 text-left">
		<div class="absolute -inset-4 bg-gradient-to-r from-blue-500/20 via-purple-500/20 to-emerald-500/20 blur-2xl rounded-3xl -z-10"></div>
		<div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 shadow-2xl overflow-hidden">
			<div class="flex items-center gap-2 px-4 py-3 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950"><span class="w-3 h-3 rounded-full bg-red-400"></span><span class="w-3 h-3 rounded-full bg-amber-400"></span><span class="w-3 h-3 rounded-full bg-emerald-400"></span><span class="ml-3 text-xs text-slate-400">BizManager · Dashboard</span></div>
			<div class="p-5 sm:p-6">
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
					{[['Today\'s sales', '$1,284.50', 'text-slate-900 dark:text-white'], ['This month', '$18,920.00', 'text-slate-900 dark:text-white'], ['Net profit', '$6,310.75', 'text-emerald-500'], ['Customers owe', '$2,140.00', 'text-amber-500']].map(([l, v, c]) => <div class="rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-3"><p class="text-[11px] text-slate-500">{l}</p><p class={`text-lg sm:text-xl font-bold ${c}`}>{v}</p></div>)}
				</div>
				<div class="rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-4">
					<p class="text-xs font-semibold text-slate-500 mb-3">Revenue — last 14 days</p>
					<div class="flex items-end gap-1.5 h-28">{[40, 55, 35, 70, 62, 48, 80, 66, 90, 58, 75, 85, 60, 95].map(h => <div class="flex-1 rounded-t bg-blue-500/80" style={`height:${h}%`}></div>)}</div>
				</div>
			</div>
		</div>
		<p class="text-center text-xs text-slate-400 mt-3">Illustration with sample numbers</p>
	</div>
</section>

<!-- Features -->
<section class="border-y border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/30 py-24">
	<div class="max-w-7xl mx-auto px-6 sm:px-8">
		<div class="text-center mb-16"><h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Everything you need to scale.</h2><p class="text-slate-500 dark:text-slate-400">Built for retail shops, wholesalers, and growing enterprises.</p></div>
		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
			{features.map(([t, d, p, c]) => (
				<div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow">
					<div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-4 ${tone[c]}`}><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={p}></path></svg></div>
					<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{t}</h3><p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{d}</p>
				</div>
			))}
		</div>
	</div>
</section>

<!-- How it works -->
<section class="max-w-7xl mx-auto px-6 sm:px-8 py-24">
	<div class="text-center mb-14"><h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">Up and running in an afternoon</h2><p class="text-slate-500 dark:text-slate-400">No installation. No consultants. Works on any phone, tablet or computer.</p></div>
	<div class="grid md:grid-cols-3 gap-10">
		{[['1', 'Create your account', 'Sign up free, name your business and set your currency and tax rate.'], ['2', 'Add your products', 'Type them in or import a CSV. Set prices, costs and low-stock alerts.'], ['3', 'Start selling', 'Make sales, send invoices and watch your profit update in real time.']].map(([n, t, d]) => <div class="text-center"><div class="w-12 h-12 mx-auto rounded-full bg-blue-600 text-white font-bold flex items-center justify-center mb-4">{n}</div><h3 class="font-bold text-slate-900 dark:text-white mb-2">{t}</h3><p class="text-sm text-slate-500 dark:text-slate-400">{d}</p></div>)}
	</div>
</section>

<!-- Who it's for -->
<section class="border-y border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/30 py-20">
	<div class="max-w-5xl mx-auto px-6 sm:px-8 text-center">
		<h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">Made for businesses like yours</h2>
		<div class="flex flex-wrap justify-center gap-3">{who.map(w => <span class="px-4 py-2 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm font-medium text-slate-700 dark:text-slate-300">{w}</span>)}</div>
	</div>
</section>

<!-- Pricing -->
<section id="pricing" class="py-24 max-w-7xl mx-auto px-6 sm:px-8 text-center">
	<h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-16">Simple, transparent pricing.</h2>
	<div class="max-w-md mx-auto bg-slate-900 dark:bg-white rounded-3xl p-8 shadow-2xl relative">
		<div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-blue-600 text-white px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Standard Plan</div>
		<div class="text-5xl font-bold text-white dark:text-slate-900 mt-4 mb-2">$29<span class="text-lg text-slate-400 dark:text-slate-500 font-normal">/mo</span></div>
		<p class="text-slate-400 dark:text-slate-500 mb-8">Per business, unlimited staff accounts.</p>
		<ul class="text-left space-y-4 mb-8 text-sm text-slate-300 dark:text-slate-600">
			{['Unlimited products & customers', 'Point of sale, receipts & invoices', 'Real-time inventory & low-stock alerts', 'Expenses, profit & receivables reports', 'Team roles for every staff member', 'CSV import & export of your data', '24/7 support'].map(f => <li class="flex items-center gap-2"><span class="text-blue-500">✓</span> {f}</li>)}
		</ul>
		<a data-cta href="/signup?plan=bizmanager" class="block w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl transition-colors">Start 14-Day Free Trial</a>
		<p class="text-xs text-slate-500 mt-3">No credit card required</p>
	</div>
</section>

<!-- FAQ -->
<section class="max-w-3xl mx-auto px-6 sm:px-8 pb-24">
	<h2 class="text-3xl font-bold text-slate-900 dark:text-white text-center mb-10">Frequently asked questions</h2>
	<div class="rounded-2xl border border-slate-200 dark:border-slate-800 divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
		{faqs.map(([q, a]) => <details class="group p-6"><summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-slate-900 dark:text-white">{q}<span class="text-slate-400 group-open:rotate-45 transition-transform text-xl leading-none">+</span></summary><p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mt-3">{a}</p></details>)}
	</div>
</section>

<!-- Final CTA -->
<section class="px-6 sm:px-8 pb-24"><div class="max-w-5xl mx-auto bg-slate-900 rounded-3xl p-10 sm:p-14 text-center">
	<h2 class="text-3xl font-bold text-white mb-3">Take control of your business today.</h2><p class="text-slate-400 mb-8">Join the businesses running smarter on RMG BizManager.</p>
	<div class="flex flex-col sm:flex-row gap-4 justify-center"><a data-cta href="/signup?plan=bizmanager" class="bg-white text-slate-900 font-bold px-8 py-3 rounded-lg hover:bg-slate-100">Start Free Trial</a><a href="/contact?topic=Sales%20enquiry" class="border border-slate-600 text-white font-bold px-8 py-3 rounded-lg hover:bg-slate-800">Talk to us</a></div>
</div></section>

</main>
<script is:inline>
	// Signed-in visitors go straight into the app
	if (localStorage.getItem('rmg_token')) document.querySelectorAll('[data-cta]').forEach(a => { a.href = '/biz'; a.textContent = 'Open BizManager'; });
</script>
</Layout>
