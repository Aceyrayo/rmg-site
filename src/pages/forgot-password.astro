---
import Layout from '../layouts/layout.astro';
const inp = 'w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all';
---
<Layout title="Forgot Password" hideChat>
<main class="max-w-md mx-auto px-6 sm:px-8 py-28">
	<div class="text-center mb-10">
		<h1 id="h" class="text-3xl font-bold text-slate-900 mb-2">Reset Password</h1>
		<p id="sub" class="text-slate-500">Enter your account email and we'll send a 6-digit reset code.</p>
	</div>

	<form id="step1" class="space-y-6 bg-white p-8 rounded-xl border border-slate-200 shadow-xl">
		<div><label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label><input type="email" id="email" required class={inp}></div>
		<button id="b1" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-4 rounded-lg transition-all shadow-md">Send reset code</button>
		<p class="text-center text-sm text-slate-500">Remembered it? <a href="/login" class="text-slate-900 font-semibold hover:underline">Back to login</a></p>
	</form>

	<form id="step2" class="hidden space-y-5 bg-white p-8 rounded-xl border border-slate-200 shadow-xl">
		<div><label for="code" class="block text-sm font-semibold text-slate-700 mb-2 text-center">6-digit code</label><input type="text" id="code" maxlength="6" inputmode="numeric" required class={inp + ' text-center text-2xl tracking-[0.6em] font-bold'}></div>
		<div><label for="np" class="block text-sm font-semibold text-slate-700 mb-2">New password</label><input type="password" id="np" minlength="8" required autocomplete="new-password" class={inp}></div>
		<div><label for="np2" class="block text-sm font-semibold text-slate-700 mb-2">Confirm new password</label><input type="password" id="np2" minlength="8" required autocomplete="new-password" class={inp}></div>
		<button id="b2" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-4 rounded-lg transition-all shadow-md">Update password</button>
		<p class="text-center text-sm text-slate-500">Code expires in 15 minutes. <button type="button" id="back" class="text-slate-900 font-semibold hover:underline">Use a different email</button></p>
	</form>
	<p id="msg" class="hidden mt-4 text-sm text-center py-2 rounded-lg border"></p>
</main>
<script is:inline>
	const g = id => document.getElementById(id); let mail = '';
	const show = (ok, t) => { const m = g('msg'); m.className = 'mt-4 text-sm text-center py-2 rounded-lg border ' + (ok ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-red-600 bg-red-50 border-red-200'); m.innerText = t; };
	g('step1').addEventListener('submit', async e => {
		e.preventDefault(); g('b1').disabled = true; g('b1').innerText = 'Sending…'; g('msg').classList.add('hidden'); mail = g('email').value.trim();
		const r = await RMG.call('/api/forgot-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: mail }) }, () => { g('b1').innerText = 'Waking up the server…'; });
		g('b1').disabled = false; g('b1').innerText = 'Send reset code';
		if (!r.ok) return show(false, r.message);
		g('step1').classList.add('hidden'); g('step2').classList.remove('hidden'); g('sub').innerText = 'If that email has an account, a code is on its way to ' + mail + '.'; g('h').innerText = 'Enter your code';
	});
	g('back').onclick = () => { g('step2').classList.add('hidden'); g('step1').classList.remove('hidden'); g('msg').classList.add('hidden'); };
	g('step2').addEventListener('submit', async e => {
		e.preventDefault(); g('msg').classList.add('hidden');
		if (g('np').value !== g('np2').value) return show(false, 'Passwords do not match.');
		g('b2').disabled = true; g('b2').innerText = 'Updating…';
		const r = await RMG.call('/api/reset-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: mail, code: g('code').value.trim(), new_password: g('np').value }) });
		g('b2').disabled = false; g('b2').innerText = 'Update password';
		if (!r.ok) return show(false, r.message);
		show(true, 'Password updated. Redirecting to sign in…'); setTimeout(() => location.href = '/login', 1800);
	});
</script>
</Layout>
