---
import Layout from '../layouts/layout.astro';
---

<Layout title="Contact">
	<main class="max-w-3xl mx-auto px-8 py-24">
		<div class="text-center mb-12">
			<h1 class="text-4xl font-bold text-white mb-4">Contact Sales</h1>
			<p class="text-slate-400">Let's discuss how we can build your next system.</p>
		</div>

		<!-- This form doesn't submit anywhere yet, we will build the API for it next! -->
		<form class="space-y-6 bg-slate-900 p-8 rounded-xl border border-slate-800">
			<div>
				<label for="name" class="block text-sm font-medium text-slate-300 mb-2">Name</label>
				<input type="text" id="name" class="w-full bg-slate-950 border border-slate-700 rounded-md px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors">
			</div>
			<div>
				<label for="email" class="block text-sm font-medium text-slate-300 mb-2">Email</label>
				<input type="email" id="email" class="w-full bg-slate-950 border border-slate-700 rounded-md px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors">
			</div>
			<div>
				<label for="message" class="block text-sm font-medium text-slate-300 mb-2">Message</label>
				<textarea id="message" rows="4" class="w-full bg-slate-950 border border-slate-700 rounded-md px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition-colors"></textarea>
			</div>
			<button type="button" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-4 rounded-md transition-colors">
				Send Message
			</button>
		</form>
	</main>
	<script>
		// Grab the form and the button
		const form = document.querySelector('form');
		const button = document.querySelector('button');

		// When the button is clicked...
		button.addEventListener('click', async (e) => {
			e.preventDefault(); // Stop the page from refreshing

			// Grab the values the user typed
			const name = document.getElementById('name').value;
			const email = document.getElementById('email').value;
			const message = document.getElementById('message').value;

			// Change button text so the user knows it's loading
			button.innerText = "Sending...";

			try {
				// This is the waiter running to the kitchen!
				// Notice the URL is the Python server, and we are using POST
				const response = await fetch('https://rmg-api-e46k.onrender.com/api/contact', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json'
					},
					body: JSON.stringify({ name, email, message })
				});

				if (response.ok) {
					button.innerText = "Message Sent!";
					button.classList.replace('bg-blue-600', 'bg-emerald-600');
					form.reset(); // clear the form
				}
			} catch (error) {
				button.innerText = "Error. Try again.";
				button.classList.replace('bg-blue-600', 'bg-red-600');
			}
		});
	</script>
</Layout>