---
import Layout from '../layouts/layout.astro';
const topics = ['Sales enquiry', 'Enterprise quote', 'Technical question', 'Partnership', 'Defense division', 'Other'];
const inp = 'w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all';
---
<Layout title="Contact">
<main class="max-w-6xl mx-auto px-6 sm:px-8 py-28 sm:py-32 relative bg-slate-50">
	<div class="text-center mb-12">
		<h1 class="text-4xl font-bold tracking-tight text-slate-900 mb-4">Contact Sales</h1>
		<p class="text-slate-500 text-lg">Let's discuss how we can build your next mission-critical system.</p>
	</div>

	<div class="grid lg:grid-cols-3 gap-8">
		<form id="contactForm" class="lg:col-span-2 space-y-6 bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-xl shadow-slate-200/50">
			<div class="grid md:grid-cols-2 gap-6">
				<div><label for="name" class="block text-sm font-semibold text-slate-700 mb-2">Full Name</label><input type="text" id="name" required maxlength="100" class={inp}></div>
				<div><label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Work Email</label><input type="email" id="email" required class={inp}></div>
			</div>
			<div class="grid md:grid-cols-2 gap-6">
				<div><label for="company" class="block text-sm font-semibold text-slate-700 mb-2">Company <span class="font-normal text-slate-400">(optional)</span></label><input type="text" id="company" maxlength="100" class={inp}></div>
				<div><label for="topic" class="block text-sm font-semibold text-slate-700 mb-2">Topic</label><select id="topic" class={inp}>{topics.map(t => <option>{t}</option>)}</select></div>
			</div>
			<div><label for="message" class="block text-sm font-semibold text-slate-700 mb-2">How can we help?</label><textarea id="message" rows="5" required minlength="10" maxlength="3000" class={inp}></textarea></div>
			<button type="submit" id="sendBtn" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-4 rounded-lg transition-all shadow-md flex justify-center items-center gap-2">Send Message</button>
			<p id="formMsg" class="hidden text-sm text-center py-2 rounded-lg border"></p>
		</form>

		<aside class="space-y-5">
			<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm"><h3 class="font-bold text-slate-900 mb-1">Email us</h3><p class="text-sm text-slate-500 mb-2">For general and sales enquiries.</p><a href="mailto:support@rmgtechnologies.com" class="text-sm font-semibold text-blue-600 hover:underline">support@rmgtechnologies.com</a></div>
			<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm"><h3 class="font-bold text-slate-900 mb-1">Already a client?</h3><p class="text-sm text-slate-500 mb-2">Open a ticket for faster, tracked support.</p><a href="/portal/support" class="text-sm font-semibold text-blue-600 hover:underline">Go to Support Center →</a></div>
			<div class="bg-slate-900 rounded-2xl p-6"><h3 class="font-bold text-white mb-1">Just want to try it?</h3><p class="text-sm text-slate-400 mb-3">Create a free account — no sales call needed.</p><a href="/signup" class="inline-block bg-white text-slate-900 text-sm font-semibold px-4 py-2 rounded-md hover:bg-slate-100">Sign up free</a></div>
		</aside>
	</div>
</main>
<script is:inline>
	const t = new URLSearchParams(location.search).get('topic');
	if (t) { const sel = document.getElementById('topic'); [...sel.options].forEach(o => { if (o.text === t) sel.value = t; }); }
	const f = document.getElementById('contactForm'), b = document.getElementById('sendBtn'), m = document.getElementById('formMsg');
	const show = (ok, text) => { m.className = 'text-sm text-center py-2 rounded-lg border ' + (ok ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-red-600 bg-red-50 border-red-200'); m.innerText = text; };
	f.addEventListener('submit', async e => {
		e.preventDefault(); b.disabled = true; b.innerText = 'Sending…'; m.classList.add('hidden');
		const company = document.getElementById('company').value.trim();
		const message = `[${document.getElementById('topic').value}]${company ? ' Company: ' + company : ''}\n\n` + document.getElementById('message').value.trim();
		const r = await RMG.call('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: document.getElementById('name').value.trim(), email: document.getElementById('email').value.trim(), message }) }, () => { b.innerText = 'Waking up the server…'; });
		if (r.ok) { show(true, 'Thank you — your message was sent. We will reply by email.'); f.reset(); } else show(false, r.message);
		b.disabled = false; b.innerText = 'Send Message';
	});
</script>
</Layout>
