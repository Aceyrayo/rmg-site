---
import Layout from '../../layouts/layout.astro';
---

<Layout title="ReezGames">
	<main class="bg-[#0a0a0a] text-white min-h-screen flex flex-col items-center py-20 relative overflow-hidden">
		
		<!-- Abstract Background Glow -->
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-purple-600/20 blur-[120px] rounded-full pointer-events-none"></div>
		<div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20 pointer-events-none"></div>

		<div class="relative z-10 text-center px-4 w-full max-w-lg">
			<!-- Custom ReezGames Icon -->
			<div class="w-24 h-24 mx-auto mb-6 relative">
				<div class="absolute inset-0 bg-gradient-to-tr from-purple-600 to-pink-500 rounded-3xl rotate-12 blur-md opacity-50 animate-pulse"></div>
				<div class="absolute inset-0 bg-gradient-to-tr from-purple-600 to-pink-500 rounded-3xl rotate-12 flex items-center justify-center border border-white/20 shadow-2xl">
					<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/>
						<path d="M17.32 5H6.68a4 4 0 0 0-3.98 3.61c-.05.46-.07.92-.07 1.39v3c0 .47.02.93.07 1.39A4 4 0 0 0 6.68 18h10.64a4 4 0 0 0 3.98-3.61c.05-.46.07-.92.07-1.39v-3c0-.47-.02-.93-.07-1.39A4 4 0 0 0 17.32 5z"/>
					</svg>
				</div>
			</div>

			<h1 class="text-5xl md:text-7xl font-black tracking-tighter mb-2 text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-300">
				REEZGAMES
			</h1>
			<p class="text-slate-400 mb-12 text-sm">Next-generation gaming experiences.</p>

			<!-- THE GAME -->
			<div class="bg-slate-900/80 border border-slate-700 backdrop-blur-md rounded-3xl p-8 shadow-2xl">
				<h2 class="text-2xl font-bold mb-6">Rock, Paper, Scissors</h2>
				
				<!-- Scoreboard -->
				<div class="flex justify-between items-center bg-slate-950 rounded-xl p-4 mb-8 border border-slate-800">
					<div class="text-center">
						<p class="text-xs text-slate-500 uppercase tracking-widest font-bold mb-1">You</p>
						<p id="playerScore" class="text-3xl font-black text-emerald-400">0</p>
					</div>
					<div class="text-slate-600 font-bold text-xl">VS</div>
					<div class="text-center">
						<p class="text-xs text-slate-500 uppercase tracking-widest font-bold mb-1">CPU</p>
						<p id="cpuScore" class="text-3xl font-black text-red-400">0</p>
					</div>
				</div>

				<!-- Result Display -->
				<div class="h-24 flex flex-col items-center justify-center mb-8">
					<div id="resultText" class="text-xl font-bold text-white transition-opacity duration-300 opacity-100">Choose your move!</div>
				</div>

				<!-- Action Buttons (Custom Icons) -->
				<div class="grid grid-cols-3 gap-4 mb-8">
					<button onclick="playGame('rock')" class="group bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-emerald-500 p-4 rounded-2xl transition-all hover:scale-105 flex flex-col items-center gap-2">
						<svg class="w-10 h-10 text-slate-400 group-hover:text-emerald-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 2L3 7v10l9 5 9-5V7l-9-5z"></path>
						</svg>
						<span class="text-xs font-bold text-slate-300">Rock</span>
					</button>
					<button onclick="playGame('paper')" class="group bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-blue-500 p-4 rounded-2xl transition-all hover:scale-105 flex flex-col items-center gap-2">
						<svg class="w-10 h-10 text-slate-400 group-hover:text-blue-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>
						</svg>
						<span class="text-xs font-bold text-slate-300">Paper</span>
					</button>
					<button onclick="playGame('scissors')" class="group bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-purple-500 p-4 rounded-2xl transition-all hover:scale-105 flex flex-col items-center gap-2">
						<svg class="w-10 h-10 text-slate-400 group-hover:text-purple-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><line x1="20" y1="4" x2="8.12" y2="15.88"></line><line x1="14.47" y1="14.48" x2="20" y2="20"></line><line x1="8.12" y1="8.12" x2="12" y2="12"></line>
						</svg>
						<span class="text-xs font-bold text-slate-300">Scissors</span>
					</button>
				</div>

				<button onclick="resetGame()" class="text-xs font-bold text-slate-500 hover:text-white transition-colors uppercase tracking-widest">Reset Match</button>
			</div>

			<!-- Partnership Badge -->
			<div class="flex items-center justify-center gap-3 text-sm font-medium text-slate-500 mt-12">
				<span>In partnership with</span>
				<a href="/" class="flex items-center gap-2 text-white hover:text-purple-400 transition-colors">
					<svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M16 2L30 10V22L16 30L2 22V10L16 2Z" stroke="currentColor" stroke-width="2" fill="transparent"/>
						<path d="M16 8L23 12V20L16 24L9 20V12L16 8Z" fill="currentColor"/>
					</svg>
					<span class="font-bold tracking-widest uppercase">RMG TECHNOLOGIES</span>
				</a>
			</div>
		</div>
	</main>

	<script is:inline>
		let playerScore = 0;
		let cpuScore = 0;

		function playGame(playerChoice) {
			const choices = ['rock', 'paper', 'scissors'];
			const cpuChoice = choices[Math.floor(Math.random() * 3)];
			
			const resultText = document.getElementById('resultText');
			resultText.style.opacity = '0';
			
			setTimeout(() => {
				let result = '';
				
				if (playerChoice === cpuChoice) {
					result = "It's a Tie!";
					resultText.className = "text-xl font-bold text-amber-400";
				} else if (
					(playerChoice === 'rock' && cpuChoice === 'scissors') ||
					(playerChoice === 'paper' && cpuChoice === 'rock') ||
					(playerChoice === 'scissors' && cpuChoice === 'paper')
				) {
					result = "You Win!";
					resultText.className = "text-xl font-bold text-emerald-400";
					playerScore++;
				} else {
					result = "You Lose!";
					resultText.className = "text-xl font-bold text-red-400";
					cpuScore++;
				}

				resultText.innerText = `${playerChoice.toUpperCase()} vs ${cpuChoice.toUpperCase()} - ${result}`;
				resultText.style.opacity = '1';
				
				document.getElementById('playerScore').innerText = playerScore;
				document.getElementById('cpuScore').innerText = cpuScore;
			}, 300);
		}

		function resetGame() {
			playerScore = 0;
			cpuScore = 0;
			document.getElementById('playerScore').innerText = 0;
			document.getElementById('cpuScore').innerText = 0;
			const resultText = document.getElementById('resultText');
			resultText.innerText = "Choose your move!";
			resultText.className = "text-xl font-bold text-white";
		}
	</script>
</Layout>