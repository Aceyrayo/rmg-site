---
import Layout from '../layouts/layout.astro';
---

<Layout title="Register">
	<div class="bg-[#05080f] min-h-screen w-full py-12">
		<main class="max-w-6xl mx-auto px-8 flex flex-col md:flex-row gap-12">
			
			<!-- Left Side: Marketing -->
			<div class="md:w-1/3 pt-8">
				<h1 class="text-4xl font-bold tracking-tight text-white mb-4">Create your enterprise account.</h1>
				<p class="text-slate-400 mb-8 leading-relaxed">Get access to high-performance trading APIs, military-grade security protocols, and dedicated support.</p>
				
				<ul class="space-y-4 text-sm text-slate-300">
					<li class="flex items-center gap-3"><span class="text-emerald-500">✓</span> 99.99% Uptime SLA</li>
					<li class="flex items-center gap-3"><span class="text-emerald-500">✓</span> End-to-end encryption</li>
					<li class="flex items-center gap-3"><span class="text-emerald-500">✓</span> 24/7 dedicated support</li>
				</ul>
			</div>

			<!-- Right Side: Form -->
			<div class="md:w-2/3">
				<form id="signupForm" class="space-y-5 bg-slate-900 p-8 rounded-2xl border border-slate-800 shadow-2xl">
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="block text-sm font-medium text-slate-300 mb-1">First Name</label>
							<input type="text" id="first_name" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none transition-colors" required>
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-300 mb-1">Last Name</label>
							<input type="text" id="last_name" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none transition-colors" required>
						</div>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="block text-sm font-medium text-slate-300 mb-1">Company Name</label>
							<input type="text" id="company_name" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none transition-colors" required>
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-300 mb-1">Job Title</label>
							<input type="text" id="job_title" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none transition-colors" required>
						</div>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="block text-sm font-medium text-slate-300 mb-1">Work Email</label>
							<input type="email" id="email" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none transition-colors" required>
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-300 mb-1">Phone Number</label>
							<input type="tel" id="phone" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none transition-colors" required>
						</div>
					</div>

					<div>
						<label class="block text-sm font-medium text-slate-300 mb-1">Desired Username</label>
						<input type="text" id="username" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none transition-colors" required>
					</div>

					<div>
						<label class="block text-sm font-medium text-slate-300 mb-1">Password</label>
						<div class="relative">
							<input type="password" id="password" onkeyup="checkStrength()" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:border-blue-500 focus:outline-none transition-colors pr-12" required>
							<button type="button" id="togglePassword" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-500 hover:text-slate-300">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
							</button>
						</div>
						<div class="mt-2 flex gap-1 h-1">
							<div id="bar1" class="flex-1 bg-slate-800 rounded"></div>
							<div id="bar2" class="flex-1 bg-slate-800 rounded"></div>
							<div id="bar3" class="flex-1 bg-slate-800 rounded"></div>
							<div id="bar4" class="flex-1 bg-slate-800 rounded"></div>
						</div>
						<p id="strengthText" class="text-xs text-slate-500 mt-1">Password must be at least 8 characters with numbers and symbols.</p>
					</div>

					<div class="flex items-start pt-2">
						<input id="terms" type="checkbox" required class="mt-1 w-4 h-4 rounded border-slate-700 bg-slate-950 focus:ring-blue-500">
						<label for="terms" class="ml-3 text-sm text-slate-400">I agree to the <a href="#" class="text-blue-400 hover:underline">Terms of Service</a> and <a href="#" class="text-blue-400 hover:underline">Privacy Policy</a>.</label>
					</div>
					
					<button type="submit" id="submitBtn" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-4 rounded-lg transition-colors mt-2 shadow-lg shadow-blue-900/20">
						Register Account
					</button>
					
					<p id="errorMsg" class="text-red-400 text-sm text-center hidden bg-red-900/20 py-2 rounded border border-red-900/50"></p>
					
					<div class="text-center text-sm text-slate-400 mt-4 border-t border-slate-800 pt-4">
						Already have an account? <a href="/login" class="text-blue-400 hover:underline">Log in</a>
					</div>
				</form>
			</div>
		</main>
	</div>

	<script is:inline>
		const togglePassword = document.getElementById('togglePassword');
		const passwordInput = document.getElementById('password');
		togglePassword.addEventListener('click', () => {
			const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
			passwordInput.setAttribute('type', type);
			togglePassword.classList.toggle('text-blue-400');
		});

		function checkStrength() {
			const val = passwordInput.value;
			const bars = [document.getElementById('bar1'), document.getElementById('bar2'), document.getElementById('bar3'), document.getElementById('bar4')];
			const text = document.getElementById('strengthText');
			
			bars.forEach(bar => { bar.className = 'flex-1 bg-slate-800 rounded'; });
			
			let strength = 0;
			if (val.length >= 8) strength++;
			if (val.match(/[A-Z]/)) strength++;
			if (val.match(/[0-9]/)) strength++;
			if (val.match(/[^A-Za-z0-9]/)) strength++;

			if (val.length === 0) {
				text.innerText = "Password must be at least 8 characters with numbers and symbols.";
				text.className = "text-xs text-slate-500 mt-1";
				return;
			}

			if (strength <= 1) {
				bars[0].className = 'flex-1 bg-red-500 rounded';
				text.innerText = "Weak password"; text.className = "text-xs text-red-500 mt-1";
			} else if (strength === 2) {
				bars[0].className = 'flex-1 bg-yellow-500 rounded'; bars[1].className = 'flex-1 bg-yellow-500 rounded';
				text.innerText = "Fair password"; text.className = "text-xs text-yellow-500 mt-1";
			} else if (strength === 3) {
				bars[0].className = 'flex-1 bg-blue-500 rounded'; bars[1].className = 'flex-1 bg-blue-500 rounded'; bars[2].className = 'flex-1 bg-blue-500 rounded';
				text.innerText = "Good password"; text.className = "text-xs text-blue-500 mt-1";
			} else if (strength === 4) {
				bars.forEach(bar => bar.className = 'flex-1 bg-emerald-500 rounded');
				text.innerText = "Strong password"; text.className = "text-xs text-emerald-500 mt-1";
			}
		}

		const form = document.getElementById('signupForm');
		const submitBtn = document.getElementById('submitBtn');
		const errorMsg = document.getElementById('errorMsg');

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			submitBtn.innerText = "Processing...";
			errorMsg.classList.add('hidden');

			const payload = {
				first_name: document.getElementById('first_name').value,
				last_name: document.getElementById('last_name').value,
				company_name: document.getElementById('company_name').value,
				job_title: document.getElementById('job_title').value,
				email: document.getElementById('email').value,
				phone: document.getElementById('phone').value,
				username: document.getElementById('username').value,
				password: document.getElementById('password').value
			};

			try {
				const response = await fetch('https://rmg-api-e46k.onrender.com/api/register', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload)
				});
				const data = await response.json();

				if (response.ok) {
					alert("Enterprise account created! Please log in.");
					window.location.href = '/login';
				} else {
					errorMsg.innerText = data.detail || "Registration failed.";
					errorMsg.classList.remove('hidden');
					submitBtn.innerText = "Register Account";
				}
			} catch (error) {
				errorMsg.innerText = "Cannot connect to server.";
				errorMsg.classList.remove('hidden');
				submitBtn.innerText = "Register Account";
			}
		});
	</script>
</Layout>