---
import Layout from '../layouts/layout.astro';
const values = [
	['Reliability first', 'If it can fail, we design it so failure is contained, observable and recoverable.'],
	['Security by default', 'Encryption, least-privilege access and audit trails are built in — never bolted on.'],
	['Lean by design', 'No bloat. Every feature earns its place and has to be fast, simple and dependable.']
];
---
<Layout title="About Us">
<main class="max-w-5xl mx-auto px-6 sm:px-8 py-28 sm:py-32 relative bg-slate-50">
	<div class="mb-16 text-center">
		<h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-slate-900 mb-6">Built for the real world.</h1>
		<p class="text-xl text-slate-700 max-w-2xl mx-auto">We engineer software that operates flawlessly when the stakes are highest.</p>
	</div>

	<div class="max-w-3xl mx-auto space-y-8 text-lg text-slate-800">
		<p><strong class="text-slate-900 font-semibold">RMG TECHNOLOGIES INC</strong> was founded on a simple principle: software should be built for high stakes. Whether it's a financial trading algorithm executing in milliseconds, or a defense system that absolutely cannot go down, we build it to work.</p>
		<p>We do not build bloated software. We build lean, secure, and fast applications. From complex military-grade systems to the day-to-day tools that keep modern businesses running, our baseline is always the same: it must work.</p>
	</div>

	<div class="grid sm:grid-cols-3 gap-6 mt-16">
		{values.map(([t, d]) => <div class="bg-white border border-slate-200 rounded-2xl p-7 shadow-sm"><h3 class="font-bold text-slate-900 mb-2">{t}</h3><p class="text-sm text-slate-500 leading-relaxed">{d}</p></div>)}
	</div>

	<div class="mt-16 bg-white border border-slate-200 p-10 rounded-3xl shadow-sm">
		<h2 class="text-2xl font-bold text-slate-900 mb-4">Our Philosophy</h2>
		<p class="text-slate-800">We believe that the best technology is the technology you don't have to think about. It just works.</p>
	</div>

	<div class="mt-16">
		<h2 class="text-2xl font-bold text-slate-900 text-center mb-8">What we build</h2>
		<div class="grid sm:grid-cols-3 gap-6">
			{[['Trading Systems', 'Algorithmic engines, market data and execution infrastructure.'], ['Defense & Military', 'Encrypted, resilient software for mission-critical operations.'], ['Enterprise Tools', 'CRM, automation and APIs for modern businesses.']].map(([t, d]) => (
				<a href="/signup" class="group bg-white border border-slate-200 rounded-2xl p-6 hover:border-slate-900 hover:shadow-md transition-all"><h3 class="font-bold text-slate-900 mb-1">{t}</h3><p class="text-sm text-slate-500 mb-3">{d}</p><span class="text-sm font-semibold text-blue-600 group-hover:underline">Get started →</span></a>
			))}
		</div>
	</div>

	<div class="mt-16 bg-slate-900 rounded-3xl p-10 text-center">
		<h2 class="text-2xl font-bold text-white mb-3">Let's build something that doesn't fail.</h2>
		<p class="text-slate-400 mb-6">Create an account in minutes, or speak with our team.</p>
		<div class="flex flex-col sm:flex-row gap-3 justify-center"><a href="/signup" class="bg-white text-slate-900 font-semibold px-6 py-2.5 rounded-md hover:bg-slate-100">Create account</a><a href="/contact" class="border border-slate-600 text-white font-semibold px-6 py-2.5 rounded-md hover:bg-slate-800">Contact us</a></div>
	</div>
</main>
</Layout>
