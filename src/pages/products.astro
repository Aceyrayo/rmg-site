---
import Layout from '../layouts/layout.astro';
---

<Layout title="Our Software">
	<main class="bg-white dark:bg-[#030712] transition-colors duration-200">
		
		<!-- Hero -->
		<div class="max-w-7xl mx-auto px-8 pt-24 pb-16 text-center">
			<h1 class="text-5xl md:text-6xl font-bold tracking-tighter text-slate-900 dark:text-white mb-6">
				Software built to <span class="text-blue-600 dark:text-blue-500">scale.</span>
			</h1>
			<p class="text-xl text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">
				Explore the enterprise-grade tools we build at RMG Technologies. From business management to high-frequency trading engines.
			</p>
		</div>

		<!-- Product Grid -->
		<div class="max-w-7xl mx-auto px-8 pb-32">
			<div class="grid md:grid-cols-2 gap-8">
				
				<!-- Product 1: BizManager (Active) -->
				<a href="/products/bizmanager" class="group relative bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 hover:shadow-2xl hover:border-blue-500/50 transition-all duration-300 overflow-hidden">
					<div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 blur-3xl rounded-full -mr-20 -mt-20 pointer-events-none"></div>
					<div class="flex items-center justify-between mb-8 relative z-10">
						<div class="w-14 h-14 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-2xl flex items-center justify-center">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.423 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
						</div>
						<span class="bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-xs font-bold px-3 py-1 rounded-full border border-emerald-200 dark:border-emerald-800">Available Now</span>
					</div>
					<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 relative z-10 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">RMG BizManager</h2>
					<p class="text-slate-500 dark:text-slate-400 mb-6 relative z-10">A complete business management platform for retail and SMEs. Track inventory, manage sales, and view financial reports in real-time.</p>
					<div class="flex items-center text-blue-600 dark:text-blue-400 font-bold text-sm relative z-10">
						View Product Details <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
					</div>
				</a>

				<!-- Product 2: School System -->
				<div class="relative bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 opacity-75 overflow-hidden">
					<div class="flex items-center justify-between mb-8 relative z-10">
						<div class="w-14 h-14 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-2xl flex items-center justify-center">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
						</div>
						<span class="bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-bold px-3 py-1 rounded-full">In Development</span>
					</div>
					<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 relative z-10">RMG School Manager</h2>
					<p class="text-slate-500 dark:text-slate-400 mb-6 relative z-10">Complete school administration. Manage students, teachers, attendance, exam records, and fees.</p>
				</div>

				<!-- Product 3: Gym & Spa -->
				<div class="relative bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 opacity-75 overflow-hidden">
					<div class="flex items-center justify-between mb-8 relative z-10">
						<div class="w-14 h-14 bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-400 rounded-2xl flex items-center justify-center">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
						</div>
						<span class="bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-bold px-3 py-1 rounded-full">In Development</span>
					</div>
					<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 relative z-10">RMG Gym & Spa</h2>
					<p class="text-slate-500 dark:text-slate-400 mb-6 relative z-10">Membership tracking, attendance, spa bookings, and payment management for fitness centers.</p>
				</div>

				<!-- Product 4: Inventory & POS -->
				<div class="relative bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 opacity-75 overflow-hidden">
					<div class="flex items-center justify-between mb-8 relative z-10">
						<div class="w-14 h-14 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-2xl flex items-center justify-center">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
						</div>
						<span class="bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-bold px-3 py-1 rounded-full">In Development</span>
					</div>
					<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 relative z-10">RMG POS</h2>
					<p class="text-slate-500 dark:text-slate-400 mb-6 relative z-10">Point of Sale and inventory system with barcode scanning and low-stock alerts for supermarkets and pharmacies.</p>
				</div>

				<!-- Product 5: AI Solutions -->
				<div class="relative bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 opacity-75 overflow-hidden">
					<div class="flex items-center justify-between mb-8 relative z-10">
						<div class="w-14 h-14 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded-2xl flex items-center justify-center">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
						</div>
						<span class="bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-bold px-3 py-1 rounded-full">Planned</span>
					</div>
					<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 relative z-10">RMG AI Solutions</h2>
					<p class="text-slate-500 dark:text-slate-400 mb-6 relative z-10">AI customer support assistants, document processing, and automated report generation.</p>
				</div>
				
				<!-- Product 6: Trading Systems -->
				<div class="relative bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 opacity-75 overflow-hidden">
					<div class="flex items-center justify-between mb-8 relative z-10">
						<div class="w-14 h-14 bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 rounded-2xl flex items-center justify-center">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
						</div>
						<span class="bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-bold px-3 py-1 rounded-full">Planned</span>
					</div>
					<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3 relative z-10">RMG Alpha Trade</h2>
					<p class="text-slate-500 dark:text-slate-400 mb-6 relative z-10">Ultra-low latency algorithmic trading engine for cryptocurrency and forex markets.</p>
				</div>

			</div>
		</div>
	</main>
</Layout>