---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="Defense & Military">
	<div class="max-w-6xl mx-auto"><div id="app"></div></div>
	<script is:inline>
const app=document.getElementById('app'); const g=id=>document.getElementById(id); const V='/api/me/records/vault'; let files=[];
const enc=new TextEncoder(); const b64=u=>{let s='';for(let i=0;i<u.length;i+=0x8000)s+=String.fromCharCode.apply(null,u.subarray(i,i+0x8000));return btoa(s);}; const unb64=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
async function deriveKey(pass,salt){ const km=await crypto.subtle.importKey('raw',enc.encode(pass),'PBKDF2',false,['deriveKey']); return crypto.subtle.deriveKey({name:'PBKDF2',salt,iterations:250000,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,['encrypt','decrypt']); }
function askPass(title){ return new Promise(res=>{ const d=document.createElement('dialog'); d.className='card p-0 w-full max-w-sm backdrop:bg-slate-900/60 text-slate-900 dark:text-slate-200';
 d.innerHTML=`<form method="dialog" class="p-6 space-y-4"><h2 class="font-bold">${esc(title)}</h2><input type="password" class="inp" placeholder="Vault passphrase" required autofocus><div class="flex justify-end gap-2"><button value="x" class="btn" type="button" data-x>Cancel</button><button class="btn btn-p">Continue</button></div></form>`;
 document.body.appendChild(d); d.showModal(); const done=v=>{d.close();d.remove();res(v);}; d.querySelector('form').onsubmit=e=>{e.preventDefault();done(d.querySelector('input').value);}; d.querySelector('[data-x]').onclick=()=>done(null); }); }
app.innerHTML=pageHead('Defense & Military Systems','Encrypted storage and secure infrastructure monitoring','<a href="/portal/threat-intel" class="btn">Threat intelligence →</a>')+`
<div class="grid lg:grid-cols-5 gap-6 mt-6"><div class="lg:col-span-3 card p-6"><div class="flex items-center gap-3 mb-3"><div class="w-10 h-10 rounded-lg bg-slate-900 dark:bg-slate-800 text-white flex items-center justify-center">🔒</div><div><h2 class="font-bold text-slate-900 dark:text-white">AES-256 Encrypted Vault</h2><p class="text-xs text-slate-500">Files are encrypted <b>in your browser</b> before upload. We never see your passphrase.</p></div></div>
<div class="grid sm:grid-cols-5 gap-3 items-end mt-4"><div class="sm:col-span-2"><label class="text-xs font-semibold text-slate-500">File (max 2.5 MB)</label><input id="file" type="file" class="inp !p-1.5 text-xs"></div><div class="sm:col-span-2"><label class="text-xs font-semibold text-slate-500">Passphrase (min 8)</label><input id="pw" type="password" class="inp" autocomplete="new-password"></div><button id="up" class="btn btn-p !py-2.5">Encrypt & upload</button></div>
<p class="text-xs text-amber-600 dark:text-amber-400 mt-3">⚠ Passphrases cannot be recovered. Lose it and the file is unreadable.</p><div id="vt" class="overflow-x-auto mt-4 border-t border-slate-100 dark:border-slate-800"></div></div>
<div class="lg:col-span-2 card p-6"><h2 class="font-bold text-slate-900 dark:text-white mb-1">Network infrastructure</h2><p class="text-xs text-slate-500 mb-4">Live checks from the platform</p><div id="net" class="space-y-3 text-sm"></div></div></div>`;
async function loadVault(){ try{ files=await api(V); table(g('vt'),[{h:'File',f:f=>'<b>'+esc(f.name)+'</b>'},{h:'Size',f:f=>(f.size/1024).toFixed(1)+' KB'},{h:'Added',f:f=>esc(f.created_at)},{h:'',f:f=>`<div class="flex gap-1 justify-end"><button class="btn" data-dl="${f.id}">Decrypt & download</button><button class="btn btn-d" data-rm="${f.id}">Delete</button></div>`}],files); if(!files.length) g('vt').innerHTML='<div class="p-8 text-center text-sm text-slate-500">Your vault is empty.</div>'; }catch(e){toast(e.message,true);} }
async function loadNet(){ try{ const s=await api('/api/status'); g('net').innerHTML=s.components.map(c=>`<div class="flex justify-between items-center"><div><div class="font-medium text-slate-800 dark:text-slate-200">${esc(c.name)}</div><div class="text-xs text-slate-500">${esc(c.detail)}</div></div>${badge(c.status,statusColor(c.status))}</div>`).join('')+`<div class="pt-3 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500">Requests blocked by the firewall (24h): <b>${s.blocked_24h}</b></div>`; }catch(e){ g('net').textContent='Unavailable'; } }
g('up').onclick=async()=>{ const f=g('file').files[0],pw=g('pw').value; if(!f)return toast('Choose a file',true); if(pw.length<8)return toast('Passphrase must be at least 8 characters',true); if(f.size>2.5*1024*1024)return toast('Maximum file size is 2.5 MB',true);
 g('up').disabled=true; g('up').textContent='Encrypting…';
 try{ const salt=crypto.getRandomValues(new Uint8Array(16)),iv=crypto.getRandomValues(new Uint8Array(12)); const key=await deriveKey(pw,salt); const ct=new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv},key,await f.arrayBuffer()));
  await api('/api/me/vault',{method:'POST',body:JSON.stringify({name:f.name,size:f.size,iv:b64(iv),salt:b64(salt),blob:b64(ct)})}); toast('Encrypted and stored'); g('file').value=''; g('pw').value=''; loadVault(); }catch(e){toast(e.message,true);}
 g('up').disabled=false; g('up').textContent='Encrypt & upload'; };
g('vt').onclick=async e=>{ const b=e.target.closest('button'); if(!b)return;
 try{ if(b.dataset.rm){ if(!confirm('Permanently delete this file?'))return; await api(V+'/'+b.dataset.rm,{method:'DELETE'}); toast('Deleted'); loadVault(); }
  if(b.dataset.dl){ const pw=await askPass('Enter the passphrase for this file'); if(!pw)return; const r=await api('/api/me/vault/'+b.dataset.dl); const key=await deriveKey(pw,unb64(r.salt));
   let pt; try{ pt=await crypto.subtle.decrypt({name:'AES-GCM',iv:unb64(r.iv)},key,unb64(r.blob)); }catch(x){ return toast('Wrong passphrase — could not decrypt',true); }
   const a=document.createElement('a'); a.href=URL.createObjectURL(new Blob([pt])); a.download=r.name; a.click(); toast('Decrypted'); } }catch(err){toast(err.message,true);} };
loadVault(); loadNet(); setInterval(loadNet,30000);
	</script>
</PortalLayout>
