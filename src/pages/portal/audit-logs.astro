---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="Audit Logs">
	<div class="max-w-6xl mx-auto"><div id="app"></div></div>
	<script is:inline>
const col=a=>/FAILED|DELETE|REVOKED/.test(a)?'red':/^LOGIN/.test(a)?'green':/CREATE|UPLOAD/.test(a)?'blue':'slate';
listPage({ title:'Audit Logs', url:'/api/me/activity?limit=500', sub:'events on your account', file:'audit-logs', poll:20000,
 cols:[{h:'Time (UTC)',f:r=>'<span class="font-mono text-xs text-slate-500">'+esc(r.time)+'</span>'},{h:'Action',f:r=>badge(r.action.replace(/_/g,' '),col(r.action))},{h:'Detail',f:r=>'<span class="text-slate-600 dark:text-slate-400">'+esc(r.detail)+'</span>'}] });
	</script>
</PortalLayout>
