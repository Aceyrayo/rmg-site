---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Defense & Military">
	<div class="max-w-5xl mx-auto space-y-8">
		
		<div class="flex justify-between items-end">
			<div>
				<h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Defense & Military Systems</h1>
				<p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Top-secret, air-gapped, and encrypted infrastructure.</p>
			</div>
			<span class="bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-sm font-bold px-3 py-1.5 rounded-lg border border-emerald-200 dark:border-emerald-800 flex items-center gap-2">
				<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Secure Link Active
			</span>
		</div>

		<div class="grid md:grid-cols-2 gap-6">
			<!-- Encryption Vault -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
				<div class="w-12 h-12 rounded-lg bg-slate-900 dark:bg-slate-800 text-white flex items-center justify-center mb-4">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
				</div>
				<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">AES-256 Encrypted Vault</h3>
				<p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Upload and share classified documents with military-grade end-to-end encryption.</p>
				<button class="bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-semibold px-4 py-2 rounded-lg transition-colors text-sm w-full">Open Secure Vault</button>
			</div>

			<!-- Network Status -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
				<div class="w-12 h-12 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center mb-4 border border-slate-200 dark:border-slate-700">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
				</div>
				<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Network Infrastructure</h3>
				<p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Monitor secure API endpoints and VPN tunnels connected to defense systems.</p>
				<div class="space-y-2">
					<div class="flex justify-between text-xs font-medium text-slate-600 dark:text-slate-400"><span>Primary Node (US-East)</span> <span class="text-emerald-500">Online</span></div>
					<div class="flex justify-between text-xs font-medium text-slate-600 dark:text-slate-400"><span>Backup Node (EU-West)</span> <span class="text-emerald-500">Online</span></div>
					<div class="flex justify-between text-xs font-medium text-slate-600 dark:text-slate-400"><span>VPN Tunnel</span> <span class="text-amber-500">Standby</span></div>
				</div>
			</div>
		</div>

		<!-- Live Threat Map (Placeholder) -->
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
			<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Real-Time Threat Intelligence</h3>
			<div class="h-64 bg-slate-950 rounded-lg flex items-center justify-center border border-slate-800 relative overflow-hidden">
				<div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
				<p class="text-slate-500 font-mono text-sm animate-pulse">Monitoring global threat vectors...</p>
			</div>
		</div>
	</div>
</AppLayout>