---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="Roles & Permissions">
	<div class="max-w-5xl mx-auto space-y-8">
		<div><h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Roles & Permissions</h1><p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Control what your users can access.</p></div>
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm text-slate-500">Admin, Developer, and Read-Only roles are available.</div>
	</div>
