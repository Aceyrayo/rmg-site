---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="API Credentials">
	<div class="max-w-6xl mx-auto"><div class="mb-6 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-900/50 rounded-lg p-4 text-amber-800 dark:text-amber-400 text-sm">Keys are shown <b>once</b> when created and stored only as a hash. Never put them in client-side code, GitHub or forums. Revoke any key you suspect is exposed.</div><div id="app"></div></div>
	<script is:inline>
crudPage({ base:'/api/me/records', kind:'key', title:'API Credentials', noun:'Key', status:'status', sub:'Authenticate with the X-API-Key header',
 fields:[{k:'name',l:'Key name',req:1,p:'e.g. Production server'},{k:'scope',l:'Permissions',t:'select',o:['read','write']},{k:'status',l:'Status',t:'select',o:['Active','Revoked'],edit:1}],
 cols:[{k:'name',l:'Name'},{k:'scope',l:'Scope',f:r=>badge(r.scope,r.scope==='write'?'amber':'slate')},{k:'prefix',l:'Key',f:r=>'<span class="font-mono text-xs">'+esc(r.prefix)+'</span>'},{k:'status',l:'Status'},{k:'calls',l:'Calls'},{k:'last_used',l:'Last used'},{k:'created_at',l:'Created'}],
 onCreate: async d => { const r = await api('/api/me/keys',{method:'POST',body:JSON.stringify(d)}); showSecret('Your new API key','' + r.key,'Copy it now — for security it will never be shown again.'); } });
	</script>
</PortalLayout>
