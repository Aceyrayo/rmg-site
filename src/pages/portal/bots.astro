---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Trading Bots">
	<div class="max-w-5xl mx-auto space-y-8">
		
		<div class="flex justify-between items-end">
			<div>
				<h1 class="text-2xl font-bold text-slate-900 tracking-tight">Trading Bots</h1>
				<p class="text-slate-500 mt-1 text-sm">Deploy and manage algorithmic trading engines.</p>
			</div>
			<button class="bg-slate-900 hover:bg-slate-800 text-white font-semibold px-5 py-2.5 rounded-lg shadow-sm transition-all text-sm">
				+ Create Custom Bot
			</button>
		</div>

		<!-- Available Bots Grid -->
		<h2 class="text-lg font-bold text-slate-900 mt-8 mb-4">Available Engines</h2>
		<div class="grid md:grid-cols-2 gap-6">
			
			<!-- Bot 1 -->
			<div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-slate-300 transition-colors">
				<div class="flex justify-between items-start mb-4">
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
						</div>
						<div>
							<h3 class="font-bold text-slate-900">Alpha Momentum</h3>
							<p class="text-xs text-slate-500">Crypto / High Frequency</p>
						</div>
					</div>
					<span class="bg-emerald-50 text-emerald-600 text-xs font-bold px-2 py-1 rounded border border-emerald-200">Active</span>
				</div>
				<p class="text-sm text-slate-600 mb-6">Executes trades based on volume-weighted average price (VWAP) and momentum indicators.</p>
				<button class="w-full border border-slate-200 text-slate-700 font-semibold py-2 rounded-lg hover:bg-slate-50 transition-colors text-sm">Configure Engine</button>
			</div>

			<!-- Bot 2 -->
			<div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-slate-300 transition-colors">
				<div class="flex justify-between items-start mb-4">
					<div class="flex items-center gap-3">
						<div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
						</div>
						<div>
							<h3 class="font-bold text-slate-900">Arbitrage Hunter</h3>
							<p class="text-xs text-slate-500">Forex / Cross-Exchange</p>
						</div>
					</div>
					<span class="bg-slate-100 text-slate-600 text-xs font-bold px-2 py-1 rounded border border-slate-200">Inactive</span>
				</div>
				<p class="text-sm text-slate-600 mb-6">Scans multiple exchanges for price discrepancies and executes simultaneous buy/sell orders.</p>
				<button class="w-full bg-slate-900 text-white font-semibold py-2 rounded-lg hover:bg-slate-800 transition-colors text-sm shadow-sm">Deploy Engine</button>
			</div>

		</div>
	</div>
</AppLayout>