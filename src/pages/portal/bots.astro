---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="Trading Bots">
	<div class="max-w-6xl mx-auto"><div id="app"></div></div>
	<script is:inline>
const app=document.getElementById('app'); const B='/api/me/records/bot'; let bots=[],editing=null,tpl=null;
const TPL=[{n:'Alpha Momentum',c:'Crypto / High Frequency',d:'Trades volume-weighted average price (VWAP) breakouts with momentum confirmation.',p:'BTC/USDT',i:'1m',col:'blue'},
 {n:'Arbitrage Hunter',c:'Forex / Cross-Exchange',d:'Scans multiple venues for price discrepancies and pairs simultaneous buy/sell orders.',p:'EUR/USD',i:'1m',col:'purple'},
 {n:'Mean Reversion',c:'Crypto / Swing',d:'Fades extended moves back toward a moving average using volatility bands.',p:'ETH/USDT',i:'15m',col:'emerald'},
 {n:'Grid Trader',c:'Crypto / Range',d:'Places layered buy/sell orders across a price range to harvest sideways markets.',p:'SOL/USDT',i:'5m',col:'amber'},
 {n:'DCA Accumulator',c:'Crypto / Long-term',d:'Accumulates a position in equal slices on a fixed schedule to smooth entry price.',p:'BTC/USDT',i:'1h',col:'slate'}];
const PAIRS=['BTC/USDT','ETH/USDT','SOL/USDT','BNB/USDT','EUR/USD','GBP/USD','USD/JPY'],INT=['1m','5m','15m','1h'];
app.innerHTML=pageHead('Trading Bots','Deploy, pause and configure your algorithmic engines','<button id="nw" class="btn btn-p">+ Create Custom Bot</button>')+`
<div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-900/50 rounded-lg p-4 text-sm text-blue-800 dark:text-blue-300">Engines are managed here in <b>paper-trading mode</b>. Contact support to enable live order routing on your account.</div>
<h2 class="text-lg font-bold text-slate-900 dark:text-white mt-8 mb-4">My engines</h2><div id="mine" class="grid md:grid-cols-2 gap-6"></div>
<h2 class="text-lg font-bold text-slate-900 dark:text-white mt-8 mb-4">Available engines</h2><div id="tpls" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
<dialog id="dlg" class="card p-0 w-full max-w-lg backdrop:bg-slate-900/60 text-slate-900 dark:text-slate-200"><form id="frm" class="p-6 space-y-4"><h2 id="dt" class="text-lg font-bold"></h2><div class="grid grid-cols-2 gap-3">
<div class="col-span-2"><label class="text-xs font-semibold text-slate-500">Name</label><input id="f-name" class="inp" required></div>
<div><label class="text-xs font-semibold text-slate-500">Market pair</label><select id="f-pair" class="inp">${PAIRS.map(p=>`<option>${p}</option>`).join('')}</select></div>
<div><label class="text-xs font-semibold text-slate-500">Interval</label><select id="f-interval" class="inp">${INT.map(p=>`<option>${p}</option>`).join('')}</select></div>
<div><label class="text-xs font-semibold text-slate-500">Allocation (USD)</label><input id="f-allocation" type="number" min="10" value="1000" class="inp" required></div>
<div><label class="text-xs font-semibold text-slate-500">Max drawdown stop (%)</label><input id="f-risk" type="number" min="1" max="100" value="5" class="inp" required></div></div>
<div class="flex justify-end gap-2"><button type="button" id="cx" class="btn">Cancel</button><button class="btn btn-p">Save</button></div></form></dialog>`;
const g=id=>document.getElementById(id), save=(id,data)=>patchRec('bot',id,data,'/api/me/records');
function draw(){ g('mine').innerHTML=bots.length?bots.map(b=>`<div class="card p-6"><div class="flex justify-between items-start mb-3"><div><h3 class="font-bold text-slate-900 dark:text-white">${esc(b.name)}</h3><p class="text-xs text-slate-500">${esc(b.strategy||'Custom')} · ${esc(b.pair)} · every ${esc(b.interval)}</p></div>${badge(b.status,statusColor(b.status))}</div>
 <div class="grid grid-cols-3 gap-2 text-center text-xs mb-4"><div class="bg-slate-50 dark:bg-slate-950 rounded p-2"><div class="text-slate-500">Allocation</div><b>${money(b.allocation)}</b></div><div class="bg-slate-50 dark:bg-slate-950 rounded p-2"><div class="text-slate-500">Stop</div><b>${esc(b.risk)}%</b></div><div class="bg-slate-50 dark:bg-slate-950 rounded p-2"><div class="text-slate-500">Mode</div><b>Paper</b></div></div>
 <div class="flex gap-2 flex-wrap">${b.status==='Running'?`<button class="btn" data-a="Paused" data-id="${b.id}">Pause</button>`:`<button class="btn btn-p" data-a="Running" data-id="${b.id}">${b.status==='Paused'?'Resume':'Deploy'}</button>`}${b.status!=='Stopped'?`<button class="btn" data-a="Stopped" data-id="${b.id}">Stop</button>`:''}<button class="btn" data-e="${b.id}">Configure</button><button class="btn btn-d" data-d="${b.id}">Delete</button></div></div>`).join(''):'<div class="card p-8 text-center text-sm text-slate-500 md:col-span-2">No engines yet — deploy one below or create a custom bot.</div>';
 g('tpls').innerHTML=TPL.map((t,i)=>`<div class="card p-6"><h3 class="font-bold text-slate-900 dark:text-white">${t.n}</h3><p class="text-xs text-slate-500 mb-3">${t.c}</p><p class="text-sm text-slate-600 dark:text-slate-400 mb-5">${t.d}</p><button class="btn btn-p w-full" data-tpl="${i}">Deploy engine</button></div>`).join(''); }
async function load(){ try{ bots=await api(B); draw(); }catch(e){toast(e.message,true);} }
const open=b=>{ editing=b; g('dt').textContent=b?'Configure engine':'Create custom bot'; g('f-name').value=b?.name||''; g('f-pair').value=b?.pair||PAIRS[0]; g('f-interval').value=b?.interval||'5m'; g('f-allocation').value=b?.allocation??1000; g('f-risk').value=b?.risk??5; g('dlg').showModal(); };
g('nw').onclick=()=>open(null); g('cx').onclick=()=>g('dlg').close();
g('frm').onsubmit=async e=>{ e.preventDefault(); const d={name:g('f-name').value,pair:g('f-pair').value,interval:g('f-interval').value,allocation:+g('f-allocation').value,risk:+g('f-risk').value};
 try{ if(editing) await save(editing.id,d); else await api(B,{method:'POST',body:JSON.stringify({data:{...d,strategy:'Custom',status:'Stopped'}})}); g('dlg').close(); toast('Saved'); load(); }catch(err){toast(err.message,true);} };
app.onclick=async e=>{ const b=e.target.closest('button'); if(!b)return; try{
 if(b.dataset.tpl){ const t=TPL[b.dataset.tpl]; await api(B,{method:'POST',body:JSON.stringify({data:{name:t.n,strategy:t.c,pair:t.p,interval:t.i,allocation:1000,risk:5,status:'Running'}})}); toast(t.n+' deployed'); load(); }
 else if(b.dataset.a){ await save(b.dataset.id,{status:b.dataset.a}); toast('Engine '+b.dataset.a.toLowerCase()); load(); }
 else if(b.dataset.e) open(bots.find(x=>x.id==b.dataset.e));
 else if(b.dataset.d){ if(!confirm('Delete this engine?'))return; await api(B+'/'+b.dataset.d,{method:'DELETE'}); toast('Deleted'); load(); } }catch(err){toast(err.message,true);} };
load();
	</script>
</PortalLayout>
