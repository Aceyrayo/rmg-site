---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Support Tickets">
	<div class="max-w-5xl mx-auto space-y-8">
		
		<div>
			<h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Support Center</h1>
			<p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Submit a request to our enterprise support team.</p>
		</div>

		<div class="grid md:grid-cols-3 gap-8">
			<!-- New Ticket Form -->
			<div class="md:col-span-2 space-y-8">
				<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm p-6">
					<h2 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Open a New Ticket</h2>
					
					<div id="successAlert" class="hidden bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-900/20 dark:text-emerald-400 dark:border-emerald-900/50 p-3 rounded-lg mb-4 text-sm">
						Ticket submitted successfully! Our team will review it shortly.
					</div>

					<form id="ticketForm" class="space-y-4">
						<div>
							<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Subject</label>
							<input type="text" id="subject" required placeholder="Brief summary of the issue" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Category</label>
							<select id="category" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
								<option>Technical Issue</option>
								<option>API Integration</option>
								<option>Billing Question</option>
								<option>Other</option>
							</select>
						</div>
						<div>
							<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Description</label>
							<textarea id="description" rows="4" required placeholder="Please provide as much detail as possible..." class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"></textarea>
						</div>
						<button type="submit" id="submitBtn" class="bg-slate-900 dark:bg-white hover:bg-slate-800 dark:hover:bg-slate-200 text-white dark:text-slate-900 font-semibold px-6 py-2 rounded-lg shadow-sm transition-all text-sm w-full">Submit Ticket</button>
					</form>
				</div>

				<!-- Previous Tickets -->
				<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
					<div class="p-6 border-b border-slate-200 dark:border-slate-800">
						<h2 class="text-lg font-bold text-slate-900 dark:text-white">Your Tickets</h2>
					</div>
					<div id="ticketsList" class="divide-y divide-slate-100 dark:divide-slate-800">
						<div class="p-6 text-center text-slate-500 dark:text-slate-400 text-sm animate-pulse">Loading tickets...</div>
					</div>
				</div>
			</div>

			<!-- Contact Info -->
			<div>
				<div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-900/50 rounded-xl p-6">
					<h3 class="text-blue-800 dark:text-blue-400 font-bold mb-2">Direct Support</h3>
					<p class="text-blue-600 dark:text-blue-300 text-sm mb-4">Enterprise clients get priority 24/7 support.</p>
					<div class="flex items-center gap-2 text-sm text-blue-800 dark:text-blue-400 font-medium">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
						support@rmgtechnologies.com
					</div>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		const token = localStorage.getItem('rmg_token');
		const API_URL = 'https://rmg-api-e46k.onrender.com';
		const form = document.getElementById('ticketForm');
		const submitBtn = document.getElementById('submitBtn');
		const successAlert = document.getElementById('successAlert');
		const ticketsList = document.getElementById('ticketsList');

		// Fetch Tickets on Load
		async function fetchTickets() {
			try {
				const res = await fetch(`${API_URL}/api/tickets`, {
					headers: { 'Authorization': `Bearer ${token}` }
				});
				const data = await res.json();
				
				if (data.length === 0) {
					ticketsList.innerHTML = '<div class="p-6 text-center text-slate-500 dark:text-slate-400 text-sm">No tickets found. Open one above.</div>';
					return;
				}

				ticketsList.innerHTML = data.map(t => `
					<div class="p-4 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
						<div class="flex justify-between items-start mb-1">
							<h4 class="text-sm font-bold text-slate-900 dark:text-white">${t.subject}</h4>
							<span class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs px-2 py-1 rounded border border-slate-200 dark:border-slate-700">${t.status}</span>
						</div>
						<p class="text-xs text-slate-500 dark:text-slate-400 mb-2">${t.category} &bull; ${t.created_at}</p>
					</div>
				`).join('');
			} catch (e) { console.error(e); }
		}

		// Submit Ticket
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			submitBtn.innerText = "Submitting...";
			submitBtn.disabled = true;

			const payload = {
				subject: document.getElementById('subject').value,
				category: document.getElementById('category').value,
				description: document.getElementById('description').value
			};

			try {
				const res = await fetch(`${API_URL}/api/tickets`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
					body: JSON.stringify(payload)
				});

				if (res.ok) {
					successAlert.classList.remove('hidden');
					form.reset();
					fetchTickets(); // Refresh list
					setTimeout(() => successAlert.classList.add('hidden'), 5000);
				}
			} catch (e) { alert("Failed to submit"); }
			finally {
				submitBtn.innerText = "Submit Ticket";
				submitBtn.disabled = false;
			}
		});

		fetchTickets();
	</script>
</AppLayout>