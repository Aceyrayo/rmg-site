---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="Support Center">
	<div class="max-w-6xl mx-auto"><div id="app"></div></div>
	<script is:inline>
const app=document.getElementById('app'); let all=[]; const g=id=>document.getElementById(id);
const FAQ=[['How quickly will I get a reply?','Enterprise tickets are triaged within a few hours, 24/7. Critical issues should be marked "Technical Issue" with full details.'],['Where do I find my API keys?','Open API Credentials in the sidebar. Keys are shown once on creation — create a new one if you lost it.'],['How do I change my plan?','Go to Billing & Plans and click "Request change" — it opens a ticket with our billing team automatically.'],['Can I reopen a closed ticket?','Yes — expand the ticket in the list below and use the Reopen button.']];
app.innerHTML=pageHead('Support Center','Submit a request to our enterprise support team')+`<div class="grid lg:grid-cols-3 gap-6 mt-6"><div class="lg:col-span-2 space-y-6">
<div class="card p-6"><h2 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Open a new ticket</h2><form id="f" class="space-y-4"><div class="grid sm:grid-cols-3 gap-3"><div class="sm:col-span-2"><label class="text-xs font-semibold text-slate-500">Subject</label><input id="s" class="inp" required maxlength="120" placeholder="Brief summary of the issue"></div><div><label class="text-xs font-semibold text-slate-500">Category</label><select id="c" class="inp"><option>Technical Issue</option><option>API Integration</option><option>Billing Question</option><option>Other</option></select></div></div><div><label class="text-xs font-semibold text-slate-500">Description</label><textarea id="d" rows="5" required class="inp" placeholder="Include steps to reproduce, error messages and what you expected…"></textarea></div><div class="flex justify-end"><button id="sb" class="btn btn-p !px-6 !py-2">Submit ticket</button></div></form></div>
<div class="card"><div class="p-4 border-b border-slate-200 dark:border-slate-800 flex flex-wrap gap-3 items-center"><h2 class="font-bold text-slate-900 dark:text-white mr-auto">Your tickets <span id="cnt" class="text-xs font-normal text-slate-500"></span></h2><input id="q" class="inp !w-48" placeholder="Search…"><select id="st" class="inp !w-32"><option value="">All</option><option>Open</option><option>In Progress</option><option>Resolved</option><option>Closed</option></select></div><div id="list" class="divide-y divide-slate-100 dark:divide-slate-800"></div></div></div>
<div class="space-y-6"><div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-900/50 rounded-xl p-6"><h3 class="text-blue-800 dark:text-blue-400 font-bold mb-2">Direct support</h3><p class="text-blue-600 dark:text-blue-300 text-sm mb-4">Enterprise clients get priority 24/7 support.</p><a href="mailto:support@rmgtechnologies.com" class="text-sm font-semibold text-blue-800 dark:text-blue-400 hover:underline">support@rmgtechnologies.com</a></div>
<div class="card p-5"><h3 class="font-bold text-slate-900 dark:text-white mb-3">FAQ</h3>${FAQ.map(([q,a])=>`<details class="py-2 border-b border-slate-100 dark:border-slate-800 last:border-0"><summary class="cursor-pointer text-sm font-medium text-slate-800 dark:text-slate-200">${q}</summary><p class="text-sm text-slate-500 mt-2">${a}</p></details>`).join('')}</div></div></div>`;
const sc=s=>statusColor(s==='Resolved'?'Completed':s);
function draw(){ const q=g('q').value.toLowerCase(),s=g('st').value; const rows=all.filter(t=>(!s||t.status===s)&&(t.subject+t.category+t.description).toLowerCase().includes(q)); g('cnt').textContent='('+rows.length+')';
 g('list').innerHTML=rows.length?rows.map(t=>`<details class="p-4 group"><summary class="flex justify-between items-start gap-3 cursor-pointer list-none"><div><div class="text-sm font-bold text-slate-900 dark:text-white">${esc(t.subject)}</div><div class="text-xs text-slate-500 mt-0.5">#${t.id} · ${esc(t.category)} · ${esc(t.created_at)}</div></div>${badge(t.status,sc(t.status))}</summary><p class="text-sm text-slate-600 dark:text-slate-400 mt-3 whitespace-pre-wrap bg-slate-50 dark:bg-slate-950 rounded-lg p-3">${esc(t.description)}</p><div class="mt-3">${t.status==='Closed'?`<button class="btn" data-s="Open" data-id="${t.id}">Reopen</button>`:`<button class="btn" data-s="Closed" data-id="${t.id}">Close ticket</button>`}</div></details>`).join(''):'<div class="p-8 text-center text-sm text-slate-500">No tickets found.</div>'; }
async function load(){ try{ all=await api('/api/tickets'); draw(); }catch(e){toast(e.message,true);} }
g('f').onsubmit=async e=>{ e.preventDefault(); g('sb').disabled=true; g('sb').textContent='Submitting…';
 try{ await api('/api/tickets',{method:'POST',body:JSON.stringify({subject:g('s').value,category:g('c').value,description:g('d').value})}); toast('Ticket submitted — our team will review it shortly'); e.target.reset(); load(); }catch(err){toast(err.message,true);}
 g('sb').disabled=false; g('sb').textContent='Submit ticket'; };
g('q').oninput=draw; g('st').oninput=draw;
g('list').onclick=async e=>{ const b=e.target.closest('button[data-s]'); if(!b)return; try{ await api('/api/tickets/'+b.dataset.id+'/status',{method:'PATCH',body:JSON.stringify({status:b.dataset.s})}); toast('Ticket updated'); load(); }catch(err){toast(err.message,true);} };
load();
	</script>
</PortalLayout>
