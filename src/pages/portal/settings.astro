---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Account Settings">
	<div class="max-w-4xl mx-auto space-y-8 pb-20">
		
		<div class="mb-8">
			<h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Account settings</h1>
			<p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Manage your profile, security, and appearance preferences.</p>
		</div>

		<!-- Success Toast -->
		<div id="successToast" class="hidden fixed top-4 right-4 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 px-6 py-4 rounded-lg shadow-lg flex items-center gap-3 z-50">
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
			<span class="font-medium">Changes saved successfully!</span>
		</div>

		<!-- PROFILE SECTION -->
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm transition-colors duration-200">
			<div class="p-6 md:p-8 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
				<h2 class="text-lg font-bold text-slate-900 dark:text-white">Profile</h2>
				<button id="toggleEditBtn" class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 flex items-center gap-1.5 transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg> 
					Edit Profile
				</button>
			</div>
			
			<div class="p-6 md:p-8 space-y-6">
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<label class="w-48 text-sm font-bold text-slate-900 dark:text-slate-200 shrink-0">First Name</label>
					<div class="flex-1">
						<input type="text" id="firstName" class="profile-input w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" value="Loading..." disabled>
					</div>
				</div>
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<label class="w-48 text-sm font-bold text-slate-900 dark:text-slate-200 shrink-0">Last Name</label>
					<div class="flex-1">
						<input type="text" id="lastName" class="profile-input w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" value="" disabled>
					</div>
				</div>
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<label class="w-48 text-sm font-bold text-slate-900 dark:text-slate-200 shrink-0">Email Address</label>
					<div class="flex-1">
						<input type="email" id="email" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-500 dark:text-slate-400 cursor-not-allowed" value="Loading..." disabled>
						<p class="text-xs text-slate-400 dark:text-slate-500 mt-1">To change your email, contact support.</p>
					</div>
				</div>
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<label class="w-48 text-sm font-bold text-slate-900 dark:text-slate-200 shrink-0">Phone Number</label>
					<div class="flex-1">
						<input type="tel" id="phone" class="profile-input w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" value="" disabled>
					</div>
				</div>
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<label class="w-48 text-sm font-bold text-slate-900 dark:text-slate-200 shrink-0">Company Name</label>
					<div class="flex-1">
						<input type="text" id="companyName" class="profile-input w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" value="" disabled>
					</div>
				</div>
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<label class="w-48 text-sm font-bold text-slate-900 dark:text-slate-200 shrink-0">Job Title</label>
					<div class="flex-1">
						<input type="text" id="jobTitle" class="profile-input w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" value="" disabled>
					</div>
				</div>

				<div id="saveBtnContainer" class="hidden flex justify-end pt-4 border-t border-slate-100 dark:border-slate-800">
					<button id="saveBtn" class="bg-slate-900 dark:bg-white hover:bg-slate-800 dark:hover:bg-slate-200 text-white dark:text-slate-900 font-semibold px-6 py-2 rounded-lg shadow-sm transition-all text-sm">
						Save Changes
					</button>
				</div>
			</div>
		</div>

		<!-- ACCOUNT SECURITY -->
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm transition-colors duration-200">
			<div class="p-6 md:p-8 border-b border-slate-200 dark:border-slate-800">
				<h2 class="text-lg font-bold text-slate-900 dark:text-white">Account Security</h2>
			</div>
			<div class="p-6 md:p-8 space-y-8">
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<label class="w-48 text-sm font-bold text-slate-900 dark:text-slate-200 shrink-0">Password</label>
					<div class="flex-1">
						<button id="openPwdBtn" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-semibold px-4 py-2 rounded-md transition-colors text-sm shadow-sm">Change Password</button>
					</div>
				</div>
			</div>
		</div>

		<!-- APPEARANCE -->
		<div id="appearance" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm transition-colors duration-200">
			<div class="p-6 md:p-8 border-b border-slate-200 dark:border-slate-800">
				<h2 class="text-lg font-bold text-slate-900 dark:text-white">Appearance</h2>
			</div>
			<div class="p-6 md:p-8 space-y-8">
				<div class="flex flex-col md:flex-row md:items-center gap-4">
					<label class="w-48 text-sm font-bold text-slate-900 dark:text-slate-200 shrink-0">Dashboard Theme</label>
					<div class="flex-1">
						<select id="themeSelect" class="w-full appearance-none bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
							<option value="light">Light Mode (Default)</option>
							<option value="dark">Dark Mode</option>
						</select>
					</div>
				</div>
			</div>
		</div>

		<!-- DELETE ACCOUNT -->
		<div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-900/50 rounded-xl p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 transition-colors duration-200">
			<div>
				<h3 class="text-red-800 dark:text-red-400 font-bold">Delete Account</h3>
				<p class="text-red-600 dark:text-red-500 text-sm mt-1">Once you delete your account, there is no going back. Please be certain.</p>
			</div>
			<button id="deleteAccountBtn" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-5 py-2 rounded-lg transition-colors text-sm shadow-sm shrink-0">Delete RMG Account</button>
		</div>

	</div>

	<!-- PASSWORD MODAL -->
	<div id="passwordModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
		<div class="bg-white dark:bg-slate-900 rounded-xl shadow-xl w-full max-w-md overflow-hidden">
			<div class="p-6 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
				<h3 class="text-lg font-bold text-slate-900 dark:text-white">Change Password</h3>
				<button id="closeModalBtn" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
			</div>
			<div class="p-6 space-y-4">
				<div>
					<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Current Password</label>
					<input type="password" id="oldPassword" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-500">
				</div>
				<div>
					<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">New Password</label>
					<input type="password" id="newPassword" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-500">
				</div>
				<p id="pwdError" class="text-red-500 text-xs hidden"></p>
			</div>
			<div class="p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 flex justify-end gap-3">
				<button id="cancelPwdBtn" class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">Cancel</button>
				<button id="savePwdBtn" class="bg-slate-900 dark:bg-white hover:bg-slate-800 dark:hover:bg-slate-200 text-white dark:text-slate-900 px-5 py-2 rounded-lg text-sm font-semibold shadow-sm transition-all">Update Password</button>
			</div>
		</div>
	</div>

	<!-- DELETE MODAL -->
	<div id="deleteModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
		<div class="bg-white dark:bg-slate-900 rounded-xl shadow-xl w-full max-w-md overflow-hidden">
			<div class="p-6 border-b border-red-200 dark:border-red-900/50 flex justify-between items-center bg-red-50 dark:bg-red-900/20">
				<h3 class="text-lg font-bold text-red-800 dark:text-red-400 flex items-center gap-2">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
					Delete Account
				</h3>
				<button id="closeDeleteBtn" class="text-red-400 hover:text-red-600"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
			</div>
			<div class="p-6 space-y-4">
				<p class="text-sm text-slate-600 dark:text-slate-400">This action is permanent and cannot be undone. All your data, API keys, and trading bots will be immediately destroyed.</p>
				<div>
					<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Confirm your password to continue</label>
					<input type="password" id="deletePassword" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-700 rounded-md px-4 py-2 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500">
				</div>
				<p id="deleteError" class="text-red-500 text-xs hidden"></p>
			</div>
			<div class="p-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50 flex justify-end gap-3">
				<button id="cancelDeleteBtn" class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">Cancel</button>
				<button id="confirmDeleteBtn" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-lg text-sm font-semibold shadow-sm transition-all">Permanently Delete</button>
			</div>
		</div>
	</div>

	<script is:inline>
		const token = localStorage.getItem('rmg_token');
		const inputs = document.querySelectorAll('.profile-input');
		const toggleEditBtn = document.getElementById('toggleEditBtn');
		const saveBtnContainer = document.getElementById('saveBtnContainer');
		const saveBtn = document.getElementById('saveBtn');
		const successToast = document.getElementById('successToast');
		const API_URL = 'https://rmg-api-e46k.onrender.com'; 

		// 1. Fetch User Data on Load
		async function fetchProfile() {
			try {
				const response = await fetch(`${API_URL}/api/profile`, {
					headers: { 'Authorization': `Bearer ${token}` }
				});
				const data = await response.json();

				if (response.ok) {
					document.getElementById('firstName').value = data.first_name || '';
					document.getElementById('lastName').value = data.last_name || '';
					document.getElementById('email').value = data.email || '';
					document.getElementById('phone').value = data.phone || '';
					document.getElementById('companyName').value = data.company_name || '';
					document.getElementById('jobTitle').value = data.job_title || '';
				}
			} catch (error) {
				console.error("Failed to load profile", error);
			}
		}

		// 2. Toggle Edit Mode
		toggleEditBtn.addEventListener('click', () => {
			inputs.forEach(input => {
				input.disabled = !input.disabled;
			});
			
			if (toggleEditBtn.innerText.includes('Edit')) {
				toggleEditBtn.innerHTML = 'Cancel';
				saveBtnContainer.classList.remove('hidden');
				document.getElementById('firstName').focus();
			} else {
				toggleEditBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg> Edit Profile';
				saveBtnContainer.classList.add('hidden');
				fetchProfile(); // Reset values
			}
		});

		// 3. Save Profile
		saveBtn.addEventListener('click', async () => {
			saveBtn.innerText = "Saving...";
			const payload = {
				first_name: document.getElementById('firstName').value,
				last_name: document.getElementById('lastName').value,
				phone: document.getElementById('phone').value,
				company_name: document.getElementById('companyName').value,
				job_title: document.getElementById('jobTitle').value
			};

			try {
				const response = await fetch(`${API_URL}/api/profile`, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
					body: JSON.stringify(payload)
				});

				if (response.ok) {
					successToast.classList.remove('hidden');
					setTimeout(() => successToast.classList.add('hidden'), 3000);
					
					// Update Sidebar instantly
					localStorage.setItem('rmg_name', payload.first_name);
					document.getElementById('userNameSidebar').innerText = payload.first_name;
					document.getElementById('menuName').innerText = payload.first_name;
					document.getElementById('userInitial').innerText = payload.first_name.charAt(0).toUpperCase();
					
					toggleEditBtn.click(); // Lock inputs again
				}
			} catch (error) {
				alert("Failed to update profile.");
			} finally {
				saveBtn.innerText = "Save Changes";
			}
		});

		// 4. Password Modal Logic
		const pwdModal = document.getElementById('passwordModal');
		const closePwd = () => { pwdModal.classList.add('hidden'); document.getElementById('pwdError').classList.add('hidden'); };
		
		document.getElementById('openPwdBtn').addEventListener('click', () => pwdModal.classList.remove('hidden'));
		document.getElementById('closeModalBtn').addEventListener('click', closePwd);
		document.getElementById('cancelPwdBtn').addEventListener('click', closePwd);

		document.getElementById('savePwdBtn').addEventListener('click', async () => {
			const oldPwd = document.getElementById('oldPassword').value;
			const newPwd = document.getElementById('newPassword').value;
			const errorEl = document.getElementById('pwdError');
			const btn = document.getElementById('savePwdBtn');

			if (!oldPwd || !newPwd) {
				errorEl.innerText = "Please fill in both fields."; errorEl.classList.remove('hidden'); return;
			}

			btn.innerText = "Updating...";
			try {
				const response = await fetch(`${API_URL}/api/change-password`, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
					body: JSON.stringify({ old_password: oldPwd, new_password: newPwd })
				});
				const data = await response.json();
				
				if (response.ok) {
					alert("Password updated successfully!");
					closePwd();
					document.getElementById('oldPassword').value = '';
					document.getElementById('newPassword').value = '';
				} else {
					errorEl.innerText = data.detail || "Failed."; errorEl.classList.remove('hidden');
				}
			} catch (e) {
				errorEl.innerText = "Server error."; errorEl.classList.remove('hidden');
			} finally {
				btn.innerText = "Update Password";
			}
		});

		// 5. Theme Selector
		const themeSelect = document.getElementById('themeSelect');
		themeSelect.value = localStorage.getItem('rmg_theme') || 'light';
		
		themeSelect.addEventListener('change', (e) => {
			const newTheme = e.target.value;
			localStorage.setItem('rmg_theme', newTheme);
			
			if (newTheme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		});

		// 6. Delete Account Modal Logic
		const deleteModal = document.getElementById('deleteModal');
		const closeDelete = () => { 
			deleteModal.classList.add('hidden'); 
			document.getElementById('deleteError').classList.add('hidden'); 
			document.getElementById('deletePassword').value = '';
		};

		document.getElementById('deleteAccountBtn').addEventListener('click', () => deleteModal.classList.remove('hidden'));
		document.getElementById('closeDeleteBtn').addEventListener('click', closeDelete);
		document.getElementById('cancelDeleteBtn').addEventListener('click', closeDelete);

		document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
			const password = document.getElementById('deletePassword').value;
			const errorEl = document.getElementById('deleteError');
			const btn = document.getElementById('confirmDeleteBtn');

			if (!password) {
				errorEl.innerText = "Please enter your password."; 
				errorEl.classList.remove('hidden'); 
				return;
			}

			btn.innerText = "Deleting...";
			btn.disabled = true;

			try {
				const response = await fetch(`${API_URL}/api/profile`, {
					method: 'DELETE',
					headers: { 
						'Content-Type': 'application/json',
						'Authorization': `Bearer ${token}` 
					},
					body: JSON.stringify({ password: password })
				});
				
				const data = await response.json();

				if (response.ok) {
					localStorage.clear();
					window.location.href = '/signup';
				} else {
					errorEl.innerText = data.detail || "Incorrect password.";
					errorEl.classList.remove('hidden');
					btn.innerText = "Permanently Delete";
					btn.disabled = false;
				}
			} catch (error) {
				errorEl.innerText = "Cannot connect to server.";
				errorEl.classList.remove('hidden');
				btn.innerText = "Permanently Delete";
				btn.disabled = false;
			}
		});

		// Initialize
		fetchProfile();
	</script>
</AppLayout>