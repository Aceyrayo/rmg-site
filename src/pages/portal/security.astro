---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="Security Center">
	<div class="max-w-5xl mx-auto space-y-8">
		<div><h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Security Center</h1><p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Manage your encryption and authentication protocols.</p></div>
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm space-y-4">
			<div class="flex justify-between items-center p-4 bg-slate-50 dark:bg-slate-950 rounded-lg"><span class="font-bold text-slate-900 dark:text-white">Two-Factor Auth</span><span class="text-emerald-500 text-sm font-bold">Enabled</span></div>
			<div class="flex justify-between items-center p-4 bg-slate-50 dark:bg-slate-950 rounded-lg"><span class="font-bold text-slate-900 dark:text-white">IP Whitelisting</span><button class="text-blue-500 text-sm font-bold hover:underline">Configure</button></div>
			<div class="flex justify-between items-center p-4 bg-slate-50 dark:bg-slate-950 rounded-lg"><span class="font-bold text-slate-900 dark:text-white">Session Timeout</span><span class="text-slate-500 text-sm">30 Minutes</span></div>
		</div>
	</div>
</AppLayout>