---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="System Status">
	<div class="max-w-6xl mx-auto"><div id="app"></div></div>
	<script is:inline>
const app=document.getElementById('app'),g=id=>document.getElementById(id); const hist=[];
app.innerHTML=pageHead('System Status','Live health of the RMG platform · checks every 15s','<button id="rf" class="btn">Check now</button>')+'<div id="banner" class="mt-6"></div><div id="comp" class="card mt-6 divide-y divide-slate-100 dark:divide-slate-800"></div><div class="grid md:grid-cols-2 gap-6 mt-6"><div id="lat"></div><div id="meta"></div></div>';
const dur=s=>`${Math.floor(s/3600)}h ${Math.floor(s%3600/60)}m`;
async function tick(){ try{ const t0=performance.now(); const s=await api('/api/status'); const ms=Math.round(performance.now()-t0); hist.push(ms); if(hist.length>24)hist.shift();
 const ok=s.components.every(c=>c.status==='Operational'||c.status==='Unknown'||c.status==='Not configured');
 g('banner').innerHTML=`<div class="card p-4 flex items-center gap-3"><span class="w-3 h-3 rounded-full ${ok?'bg-emerald-500':'bg-amber-500'} animate-pulse"></span><b class="text-slate-900 dark:text-white">${ok?'All systems operational':'Some systems are degraded'}</b></div>`;
 g('comp').innerHTML=s.components.map(c=>`<div class="p-4 flex justify-between items-center"><div><div class="font-semibold text-slate-900 dark:text-white">${esc(c.name)}</div><div class="text-xs text-slate-500">${esc(c.detail)}</div></div>${badge(c.status,statusColor(c.status))}</div>`).join('');
 const mx=Math.max(...hist,1); g('lat').innerHTML=panel('Your round-trip latency',`<div class="flex items-end gap-1 h-24">${hist.map(v=>`<div class="flex-1 rounded-t bg-blue-500/80" style="height:${v/mx*100}%" title="${v} ms"></div>`).join('')}</div><p class="text-xs text-slate-500 mt-3">Latest <b>${ms} ms</b> · average ${Math.round(hist.reduce((a,b)=>a+b,0)/hist.length)} ms</p>`);
 g('meta').innerHTML=panel('Platform',`<div class="space-y-2 text-sm"><div class="flex justify-between"><span class="text-slate-500">Uptime since last deploy</span><b>${dur(s.uptime_s)}</b></div><div class="flex justify-between"><span class="text-slate-500">Threats blocked (24h)</span><b>${s.blocked_24h}</b></div><div class="flex justify-between"><span class="text-slate-500">Last checked (UTC)</span><b>${esc(s.checked_at)}</b></div></div>`);
 }catch(e){ g('banner').innerHTML='<div class="card p-4 text-red-500 font-semibold">Cannot reach the API right now.</div>'; } }
g('rf').onclick=tick; tick(); setInterval(tick,15000);
	</script>
</PortalLayout>
