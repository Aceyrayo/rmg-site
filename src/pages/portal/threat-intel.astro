---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="Threat Intelligence">
	<div class="max-w-5xl mx-auto space-y-8">
		<div><h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Threat Intelligence</h1><p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Global cyber threat map and military defense monitoring.</p></div>
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
			<div class="h-96 bg-slate-950 rounded-lg flex flex-col items-center justify-center border border-slate-800 relative overflow-hidden">
				<div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
				<span class="w-3 h-3 bg-red-500 rounded-full animate-ping absolute top-1/4 left-1/3"></span>
				<span class="w-3 h-3 bg-emerald-500 rounded-full animate-pulse absolute bottom-1/3 right-1/4"></span>
				<p class="text-emerald-400 font-mono text-sm relative z-10">Monitoring global endpoints... 0 threats detected.</p>
			</div>
		</div>
	</div>
</AppLayout>