---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="Threat Intelligence">
	<div class="max-w-6xl mx-auto"><div id="app"></div></div>
	<script is:inline>
const app=document.getElementById('app'),g=id=>document.getElementById(id);
(async()=>{ try{ const [ses,st,o]=await Promise.all([api('/api/me/sessions'),api('/api/status'),api('/api/me/overview')]);
 const bad=ses.filter(x=>!x.ok); const ips={}; ses.forEach(x=>{const r=ips[x.ip]=ips[x.ip]||{ip:x.ip,ok:0,fail:0,last:x.time}; x.ok?r.ok++:r.fail++;}); const list=Object.values(ips).sort((a,b)=>b.fail-a.fail);
 const byDay={}; bad.forEach(x=>{const d=x.time.slice(5,10); byDay[d]=(byDay[d]||0)+1;});
 const level=bad.length>=5?['High','red']:bad.length?['Elevated','amber']:['Low','green'];
 app.innerHTML=pageHead('Threat Intelligence','Hostile activity targeting your account and the platform','<a href="/portal/security" class="btn">Security settings</a><button id="lock" class="btn btn-d">Lock down (sign out all)</button>')+`
 <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">${stat('Threat level',level[0],level[1]==='red'?'text-red-500':level[1]==='amber'?'text-amber-500':'text-emerald-500')}${stat('Failed sign-ins',bad.length,bad.length?'text-red-500':'')}${stat('Unique IPs seen',list.length)}${stat('Platform threats blocked (24h)',st.blocked_24h)}</div>
 <div class="grid lg:grid-cols-3 gap-6 mt-6"><div class="lg:col-span-2 card"><div class="p-5 font-bold text-slate-900 dark:text-white">Source IPs</div><div id="ipt" class="overflow-x-auto"></div></div>${panel('Failed attempts by day',bars(Object.entries(byDay).sort()))}</div>
 <p class="text-xs text-slate-500 mt-4">Based on the last 40 sign-in events for your account. Unfamiliar IP with failures? Sign out everywhere, change your password, and add an IP allowlist in Security settings.</p>`;
 table(g('ipt'),[{h:'IP address',f:r=>'<span class="font-mono text-xs">'+esc(r.ip)+'</span>'},{h:'Successful',f:r=>r.ok},{h:'Failed',f:r=>r.fail?badge(r.fail,'red'):0},{h:'Last seen (UTC)',f:r=>esc(r.last)}],list);
 g('lock').onclick=async()=>{ if(!confirm('Sign out on all devices now?'))return; try{ await api('/api/me/sessions/revoke',{method:'POST'}); localStorage.clear(); location.href='/login'; }catch(e){toast(e.message,true);} };
 }catch(e){toast(e.message,true);} })();
	</script>
</PortalLayout>
