---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="Team Management">
	<div class="max-w-6xl mx-auto"><div id="app"></div></div>
	<script is:inline>
const ROLES=['Admin','Developer','Read-Only'];
crudPage({ base:'/api/me/records', kind:'team', title:'Team Management', noun:'Member', status:'status', sub:'Invite colleagues — they receive an email invitation',
 fields:[{k:'name',l:'Full name',req:1},{k:'email',l:'Email',t:'email',req:1},{k:'role',l:'Role',t:'select',o:ROLES},{k:'status',l:'Status',t:'select',o:['Invited','Active','Suspended'],edit:1}],
 cols:[{k:'name',l:'Member',f:r=>'<b>'+esc(r.name)+'</b><div class="text-xs text-slate-500">'+esc(r.email)+'</div>'},{k:'role',l:'Role',f:r=>badge(r.role,r.role==='Admin'?'red':r.role==='Developer'?'blue':'slate')},{k:'status',l:'Status'},{k:'created_at',l:'Added'}],
 actions:[{label:'Resend invite',run:async r=>{await api('/api/me/records/team/'+r.id,{method:'PATCH',body:JSON.stringify({data:{status:'Invited'}})}); toast('Invite re-sent');}}] });
	</script>
</PortalLayout>
