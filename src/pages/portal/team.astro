---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="Team Management">
	<div class="max-w-5xl mx-auto space-y-8">
		<div class="flex justify-between items-end"><div><h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Team Management</h1><p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Invite colleagues to your workspace.</p></div><button class="bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold px-4 py-2 rounded-lg text-sm shadow-sm">+ Invite Member</button></div>
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm text-center text-slate-500">No team members added yet.</div>
	</div>
</AppLayout>