---
import PortalLayout from '../../layouts/PortalLayout.astro';
---
<PortalLayout title="Trading Systems">
	<div class="max-w-6xl mx-auto"><div id="app"></div></div>
	<script is:inline>
(async()=>{ const app=document.getElementById('app'); try{
 const [o,bots,m]=await Promise.all([api('/api/me/overview'),api('/api/me/records/bot'),api('/api/market-data').catch(()=>null)]);
 const movers=m?[...m.crypto].sort((a,b)=>Math.abs(b.change_24h)-Math.abs(a.change_24h)).slice(0,6):[];
 app.innerHTML=pageHead('Trading Systems','Your engines and the market at a glance','<a href="/portal/market-data" class="btn">Market data</a><a href="/portal/bots" class="btn btn-p">Manage bots</a>')+`
 <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">${stat('Engines',o.bots.total)}${stat('Running',o.bots.running,'text-emerald-500')}${stat('Paused',o.bots.paused,'text-amber-500')}${stat('Stopped',o.bots.stopped)}</div>
 <div class="grid lg:grid-cols-2 gap-6 mt-6"><div class="card"><div class="p-5 font-bold text-slate-900 dark:text-white">Your engines</div><div id="bt" class="overflow-x-auto"></div></div>
 ${panel('Top movers (24h)',movers.length?'<div class="divide-y divide-slate-100 dark:divide-slate-800">'+movers.map(c=>`<div class="flex justify-between py-2 text-sm"><span><b>${esc(c.symbol)}</b> <span class="text-slate-500">${esc(c.name)}</span></span><span>${price(c.price)} &nbsp; ${chg(c.change_24h)}</span></div>`).join('')+'</div>':'<p class="text-sm text-slate-500">Market feed unavailable.</p>')}</div>`;
 table(document.getElementById('bt'),[{h:'Name',f:b=>'<b>'+esc(b.name)+'</b>'},{h:'Pair',f:b=>esc(b.pair)},{h:'Allocation',f:b=>money(b.allocation)},{h:'Status',f:b=>badge(b.status,statusColor(b.status))}],bots);
 }catch(e){toast(e.message,true);} })();
	</script>
</PortalLayout>
