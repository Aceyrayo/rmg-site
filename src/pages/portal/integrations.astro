---
import AppLayout from '../../layouts/AppLayout.astro';
---
<AppLayout title="Integrations">
	<div class="max-w-5xl mx-auto space-y-8">
		<div><h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Integrations</h1><p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Connect RMG to your favorite tools.</p></div>
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-xl shadow-sm text-center font-bold text-slate-400">Slack</div>
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-xl shadow-sm text-center font-bold text-slate-400">Discord</div>
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-xl shadow-sm text-center font-bold text-slate-400">Zapier</div>
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-xl shadow-sm text-center font-bold text-slate-400">GitHub</div>
		</div>
	</div>
</AppLayout>