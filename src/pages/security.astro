---
import Layout from '../layouts/layout.astro';
const core = [
	['End-to-End Encryption', 'All data in transit is encrypted using TLS 1.3. Data at rest is encrypted with AES-256, the same standard used by government agencies.'],
	['Role-Based Access Control', 'Granular permissions ensure that users only have access to the systems and data they strictly require to perform their duties.'],
	['99.99% Uptime SLA', 'Our infrastructure is distributed across multiple availability zones, ensuring zero single points of failure for mission-critical deployments.']
];
const controls = [
	['Encrypted vault', 'Files are encrypted in your browser (AES-GCM) before upload. We never see your passphrase or the contents.'],
	['IP allowlisting', 'Restrict sign-in and API access to the networks you trust.'],
	['Session control', 'Set a maximum session length and sign out every device instantly.'],
	['Hashed credentials', 'Passwords use bcrypt and API keys are stored only as one-way hashes — shown once, never recoverable.'],
	['Signed webhooks', 'Every webhook is signed with HMAC-SHA256 so your servers can verify it came from us.'],
	['Complete audit trail', 'Every sign-in, key change and setting update is logged and exportable.']
];
---
<Layout title="Security">
<main class="max-w-5xl mx-auto px-6 sm:px-8 py-28 sm:py-32 relative bg-slate-50">
	<div class="text-center mb-16">
		<div class="inline-flex items-center justify-center w-20 h-20 bg-white rounded-3xl border border-slate-200 mb-8 shadow-sm">
			<svg class="w-10 h-10 text-slate-900" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
		</div>
		<h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-slate-900 mb-6">Security by design.</h1>
		<p class="text-xl text-slate-500">We build for environments where failure is not an option.</p>
	</div>

	<div class="space-y-6">
		{core.map(([t, d]) => (
			<div class="flex gap-6 items-start bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:border-slate-300 transition-colors">
				<div class="w-12 h-12 bg-slate-50 text-slate-900 rounded-xl flex items-center justify-center shrink-0 border border-slate-200 font-bold">✓</div>
				<div><h3 class="text-xl font-bold text-slate-900 mb-2">{t}</h3><p class="text-slate-500 leading-relaxed">{d}</p></div>
			</div>
		))}
	</div>

	<h2 class="text-2xl font-bold text-slate-900 text-center mt-20 mb-8">Controls you manage yourself</h2>
	<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
		{controls.map(([t, d]) => <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm"><h3 class="font-bold text-slate-900 mb-2">{t}</h3><p class="text-sm text-slate-500 leading-relaxed">{d}</p></div>)}
	</div>

	<div class="mt-16 bg-white border border-slate-200 rounded-2xl p-8 shadow-sm flex flex-col sm:flex-row gap-6 items-center justify-between">
		<div><h3 class="font-bold text-slate-900 mb-1">Found a vulnerability?</h3><p class="text-sm text-slate-500">We welcome responsible disclosure. Email us with details and we will respond promptly.</p></div>
		<a href="mailto:support@rmgtechnologies.com?subject=Security%20disclosure" class="shrink-0 bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold px-5 py-2.5 rounded-md">Report an issue</a>
	</div>
	<p class="text-center text-sm text-slate-500 mt-8">See also our <a href="/compliance" class="text-blue-600 hover:underline">compliance</a> and <a href="/privacy" class="text-blue-600 hover:underline">privacy</a> pages.</p>
</main>
</Layout>
