---
import PortalLayout from '../layouts/PortalLayout.astro';
const groups = [
	['Trading', [['Trading Systems', '/portal/trading', 'Engines and market at a glance'], ['Trading Bots', '/portal/bots', 'Deploy and manage algorithmic engines'], ['Live Market Data', '/portal/market-data', 'Crypto prices and forex rates']]],
	['Developers', [['API Credentials', '/portal/api-keys', 'Create and revoke API keys'], ['API Documentation', '/portal/api-docs', 'Endpoints with live testing'], ['Webhooks', '/portal/webhooks', 'Signed event delivery + logs'], ['Integrations', '/portal/integrations', 'Slack, Discord, Teams, Zapier']]],
	['Security', [['Security Center', '/portal/security', 'IP allowlist, sessions, sign-out'], ['Defense & Military', '/portal/defence', 'Encrypted vault and infrastructure'], ['Threat Intelligence', '/portal/threat-intel', 'Hostile activity on your account'], ['System Logs', '/portal/logs', 'Live event stream'], ['Audit Logs', '/portal/audit-logs', 'Every action, searchable']]],
	['Workspace', [['Team', '/portal/team', 'Invite colleagues'], ['Roles & Permissions', '/portal/roles', 'Admin, Developer, Read-Only'], ['Enterprise Tools', '/portal/enterprise', 'CRM, workflows, reports'], ['Analytics', '/portal/analytics', 'Metrics and exports']]],
	['Account', [['Billing & Plans', '/portal/billing', 'Plan, invoices, PDFs'], ['Support Center', '/portal/support', 'Open and track tickets'], ['System Status', '/portal/status', 'Live platform health'], ['Account Settings', '/portal/settings', 'Profile, password, theme']]]
];
---
<PortalLayout title="Overview">
<div class="max-w-6xl mx-auto space-y-10">
	<div>
		<h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Welcome back<span id="welcomeName"></span></h1>
		<p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Manage your trading infrastructure, API credentials, security and support from one place.</p>
	</div>

	<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
		<div class="card p-5"><p class="text-sm font-semibold text-slate-500">Running bots</p><p id="sBots" class="text-3xl font-bold text-slate-900 dark:text-white mt-1">…</p></div>
		<div class="card p-5"><p class="text-sm font-semibold text-slate-500">Active API keys</p><p id="sKeys" class="text-3xl font-bold text-slate-900 dark:text-white mt-1">…</p></div>
		<div class="card p-5"><p class="text-sm font-semibold text-slate-500">Open tickets</p><p id="sTix" class="text-3xl font-bold text-slate-900 dark:text-white mt-1">…</p></div>
		<div class="card p-5"><p class="text-sm font-semibold text-slate-500">Account status</p><p class="text-3xl font-bold text-emerald-500 mt-1">Verified</p><p id="sLast" class="text-xs text-slate-500 mt-1"></p></div>
	</div>

	<div class="grid lg:grid-cols-3 gap-8">
		<div class="lg:col-span-2 space-y-8">
			{groups.map(([title, items]) => (
				<section>
					<h2 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-3">{title}</h2>
					<div class="grid sm:grid-cols-2 gap-3">
						{items.map(([t, href, d]) => (
							<a href={href} class="group card p-4 hover:!border-blue-400 dark:hover:!border-blue-600 transition-colors block">
								<h3 class="font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{t}</h3>
								<p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{d}</p>
							</a>
						))}
					</div>
				</section>
			))}
		</div>
		<aside>
			<div class="card sticky top-0">
				<div class="p-4 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center"><h2 class="font-bold text-slate-900 dark:text-white">Recent activity</h2><a href="/portal/audit-logs" class="text-xs text-blue-500 hover:underline">View all</a></div>
				<div id="recent" class="divide-y divide-slate-100 dark:divide-slate-800"><div class="p-6 text-center text-sm text-slate-500 animate-pulse">Loading…</div></div>
			</div>
		</aside>
	</div>
</div>
<script is:inline>
	(async () => {
		const n = localStorage.getItem('rmg_name'); if (n) document.getElementById('welcomeName').textContent = ', ' + n;
		try {
			const [o, act] = await Promise.all([api('/api/me/overview'), api('/api/me/activity?limit=7')]);
			document.getElementById('sBots').textContent = o.bots.running;
			document.getElementById('sKeys').textContent = o.keys.active;
			document.getElementById('sTix').textContent = o.tickets.open;
			if (o.last_login) document.getElementById('sLast').textContent = 'Last sign-in ' + o.last_login + ' UTC';
			document.getElementById('recent').innerHTML = act.length ? act.map(a => `<div class="p-3"><div class="flex justify-between items-center gap-2">${badge(a.action.replace(/_/g, ' '), /FAILED|DELETE|REVOKED/.test(a.action) ? 'red' : /^LOGIN/.test(a.action) ? 'green' : 'blue')}<span class="text-[10px] font-mono text-slate-500">${esc(a.time.slice(5, 16))}</span></div><p class="text-xs text-slate-500 mt-1 truncate">${esc(a.detail)}</p></div>`).join('') : '<div class="p-6 text-center text-sm text-slate-500">No activity yet.</div>';
		} catch (e) { document.getElementById('recent').innerHTML = '<div class="p-6 text-center text-sm text-red-500">Could not load data.</div>'; }
	})();
</script>
</PortalLayout>
