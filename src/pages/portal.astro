---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Overview">
	<div class="max-w-5xl mx-auto space-y-8">
		
		<div>
			<h1 class="text-2xl font-bold text-slate-900 tracking-tight">Welcome back, <span id="welcomeName">Client</span>.</h1>
			<p class="text-slate-500 mt-1 text-sm">Here is a summary of your enterprise workspace.</p>
		</div>

		<!-- Stats Grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
				<div class="flex items-center justify-between mb-4">
					<h3 class="text-sm font-semibold text-slate-500">Active Bots</h3>
					<div class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg></div>
				</div>
				<p class="text-3xl font-bold text-slate-900">0</p>
			</div>
			
			<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
				<div class="flex items-center justify-between mb-4">
					<h3 class="text-sm font-semibold text-slate-500">API Requests (24h)</h3>
					<div class="w-8 h-8 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg></div>
				</div>
				<p class="text-3xl font-bold text-slate-900">0</p>
			</div>

			<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
				<div class="flex items-center justify-between mb-4">
					<h3 class="text-sm font-semibold text-slate-500">Account Status</h3>
					<div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
				</div>
				<p class="text-3xl font-bold text-slate-900">Verified</p>
			</div>
		</div>

		<!-- Quick Links -->
		<div class="grid md:grid-cols-2 gap-6">
			<a href="/portal/bots" class="group bg-white border border-slate-200 p-6 rounded-xl shadow-sm hover:border-blue-300 hover:shadow-md transition-all flex items-start gap-4">
				<div class="w-12 h-12 rounded-lg bg-slate-100 text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-600 flex items-center justify-center shrink-0 transition-colors">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
				</div>
				<div>
					<h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition-colors">Deploy Trading Bot</h3>
					<p class="text-sm text-slate-500">Browse available algorithmic engines and deploy them to your infrastructure.</p>
				</div>
			</a>

			<a href="/portal/api-keys" class="group bg-white border border-slate-200 p-6 rounded-xl shadow-sm hover:border-purple-300 hover:shadow-md transition-all flex items-start gap-4">
				<div class="w-12 h-12 rounded-lg bg-slate-100 text-slate-600 group-hover:bg-purple-50 group-hover:text-purple-600 flex items-center justify-center shrink-0 transition-colors">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
				</div>
				<div>
					<h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-purple-600 transition-colors">Manage API Keys</h3>
					<p class="text-sm text-slate-500">Generate secure access tokens to connect your custom software to the RMG network.</p>
				</div>
			</a>
		</div>
	</div>

	<script is:inline>
		const name = localStorage.getItem('rmg_name');
		if (name) document.getElementById('welcomeName').innerText = name;
	</script>
</AppLayout>