---
import Layout from '../layouts/layout.astro';
---

<Layout title="Client Portal">
	<main class="max-w-4xl mx-auto px-8 py-24">
		<div class="flex justify-between items-center mb-8">
			<div>
				<h1 class="text-3xl font-bold text-white">Client Portal</h1>
				<p class="text-slate-400">Welcome to your secure area.</p>
			</div>
			<button id="logoutBtn" class="bg-red-900/50 text-red-400 hover:bg-red-900 border border-red-900/50 px-4 py-2 rounded-md transition-colors text-sm font-medium">
				Log Out
			</button>
		</div>

		<div class="bg-slate-900 border border-slate-800 p-8 rounded-xl">
			<h2 class="text-xl font-bold text-white mb-4">Your Software</h2>
			<p class="text-slate-400 mb-6">You don't have any active licenses yet. Contact sales to get started.</p>
			<a href="/contact" class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-2 rounded-md transition-colors inline-block">Contact Sales</a>
		</div>
	</main>

	<script is:inline>
		// Security Check
		const token = localStorage.getItem('rmg_token');
		if (!token) {
			window.location.href = '/login';
		}

		// Logout
		document.getElementById('logoutBtn').addEventListener('click', () => {
			localStorage.removeItem('rmg_token');
			localStorage.removeItem('rmg_role');
			window.location.href = '/login';
		});
	</script>
</Layout>