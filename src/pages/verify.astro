---
import Layout from '../layouts/layout.astro';
---

<Layout title="Verify Email" hideChat>
	<main class="max-w-md mx-auto px-8 py-32">
		<div class="text-center mb-10">
			<h1 class="text-3xl font-bold text-slate-900 mb-2">Check your email</h1>
			<p class="text-slate-500">We sent a 6-digit security code to <br/><strong id="emailDisplay" class="text-slate-900"></strong></p>
		</div>

				<form id="verifyForm" class="space-y-6 bg-white p-8 rounded-xl border border-slate-200 shadow-xl relative overflow-hidden">
			<!-- Success Overlay (Hidden by default) -->
			<div id="successOverlay" class="absolute inset-0 bg-white/95 backdrop-blur-sm flex flex-col items-center justify-center z-10 hidden transition-opacity duration-300">
				<div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
				</div>
				<h3 class="text-xl font-bold text-slate-900 mb-2">Account Verified!</h3>
				<p class="text-slate-500">Redirecting to login...</p>
			</div>

			<div>
				<label class="block text-sm font-medium text-slate-700 mb-2 text-center">Security Code</label>
				<input type="text" id="code" maxlength="6" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-3 text-center text-3xl tracking-[1em] font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" placeholder="000000" required>
			</div>
			
			<button type="submit" id="submitBtn" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-4 rounded-lg transition-all shadow-md mt-4">
				Verify Account
			</button>
			
			<p id="errorMsg" class="text-red-600 text-sm text-center hidden bg-red-50 py-2 rounded-lg border border-red-200"></p>
		</form>
	</main>

	<script is:inline>
const email = localStorage.getItem('verify_email');
if (!email) window.location.href = '/signup';
document.getElementById('emailDisplay').innerText = email;
const form = document.getElementById('verifyForm'), submitBtn = document.getElementById('submitBtn'), errorMsg = document.getElementById('errorMsg');
const successOverlay = document.getElementById('successOverlay'), resendBtn = document.getElementById('resendBtn'), codeInput = document.getElementById('code');
const note = (ok, t) => { errorMsg.className = 'text-sm text-center py-2 rounded-lg border ' + (ok ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-red-600 bg-red-50 border-red-200'); errorMsg.innerText = t; };
codeInput.addEventListener('input', () => { codeInput.value = codeInput.value.replace(/\D/g, ''); });
form.addEventListener('submit', async (e) => {
	e.preventDefault(); errorMsg.classList.add('hidden');
	submitBtn.disabled = true; submitBtn.innerText = 'Verifying...';
	const r = await RMG.call('/api/verify-email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, code: codeInput.value.trim() }) }, () => { submitBtn.innerText = 'Waking up server…'; });
	submitBtn.disabled = false; submitBtn.innerText = 'Verify Account';
	if (!r.ok) return note(false, r.message);
	successOverlay.classList.remove('hidden'); localStorage.removeItem('verify_email');
	setTimeout(() => { window.location.href = '/login?verified=1'; }, 1800);
});
let cool = 0, timer;
resendBtn.addEventListener('click', async () => {
	if (cool > 0) return; resendBtn.disabled = true;
	const r = await RMG.call('/api/resend-verification', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
	note(r.ok, r.ok ? 'A new code is on its way. Check your inbox (and spam folder).' : r.message);
	cool = 60; timer = setInterval(() => { cool--; resendBtn.innerText = cool > 0 ? 'Resend in ' + cool + 's' : 'Resend code'; if (cool <= 0) { clearInterval(timer); resendBtn.disabled = false; } }, 1000);
});
</script>
</Layout>