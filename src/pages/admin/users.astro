---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Users">
	<div class="max-w-7xl mx-auto space-y-6">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div><h1 class="text-2xl font-bold text-slate-900 dark:text-white">Users</h1><p id="count" class="text-sm text-slate-500">Loading…</p></div>
			<button id="exportBtn" class="btn">Export CSV</button>
		</div>
		<div class="card">
			<div class="p-4 border-b border-slate-200 dark:border-slate-800 flex flex-wrap gap-3">
				<input id="q" class="inp sm:max-w-xs" placeholder="Search name, email, company…" />
				<select id="role" class="inp sm:max-w-[160px]"><option value="">All roles</option><option value="client">Clients</option><option value="admin">Admins</option></select>
				<select id="ver" class="inp sm:max-w-[160px]"><option value="">All status</option><option value="1">Verified</option><option value="0">Pending</option></select>
			</div>
			<div id="tbl" class="overflow-x-auto"><div class="p-10 text-center text-sm text-slate-500 animate-pulse">Loading…</div></div>
		</div>
	</div>
	<script is:inline>
		const $ = id => document.getElementById(id); let all = [], view = [];
		async function load() { try { all = await api('/api/admin/users'); draw(); } catch (e) { toast(e.message, true); } }
		function draw() {
			const q = $('q').value.toLowerCase(), r = $('role').value, v = $('ver').value;
			view = all.filter(u => (!r || u.role === r) && (!v || String(+u.is_verified) === v) && [u.first_name, u.last_name, u.email, u.username, u.company_name].join(' ').toLowerCase().includes(q));
			$('count').textContent = `${view.length} of ${all.length} accounts`;
			table($('tbl'), [
				{ h: 'User', f: u => `<div class="font-semibold text-slate-900 dark:text-white">${esc(u.first_name)} ${esc(u.last_name)}</div><div class="text-xs text-slate-500">${esc(u.email)}</div>` },
				{ h: 'Company', f: u => `${esc(u.company_name)}<div class="text-xs text-slate-500">${esc(u.job_title)}</div>` },
				{ h: 'Role', f: u => badge(u.role, u.role === 'admin' ? 'red' : 'slate') },
				{ h: 'Status', f: u => badge(u.is_verified ? 'Verified' : 'Pending', u.is_verified ? 'green' : 'amber') },
				{ h: '', f: u => `<div class="flex gap-1 justify-end"><button class="btn" data-a="verify" data-id="${u.id}">${u.is_verified ? 'Unverify' : 'Verify'}</button><button class="btn" data-a="role" data-id="${u.id}">${u.role === 'admin' ? 'Make client' : 'Make admin'}</button><button class="btn btn-d" data-a="del" data-id="${u.id}">Delete</button></div>` }
			], view);
		}
		$('tbl').addEventListener('click', async e => {
			const b = e.target.closest('button[data-a]'); if (!b) return;
			const u = all.find(x => x.id == b.dataset.id), a = b.dataset.a, url = '/api/admin/users/' + u.id;
			try {
				if (a === 'verify') await api(url, { method: 'PATCH', body: JSON.stringify({ is_verified: !u.is_verified }) });
				if (a === 'role') { if (!confirm(`Change role for ${u.email}?`)) return; await api(url, { method: 'PATCH', body: JSON.stringify({ role: u.role === 'admin' ? 'client' : 'admin' }) }); }
				if (a === 'del') { if (!confirm(`Permanently delete ${u.email}?`)) return; await api(url, { method: 'DELETE' }); }
				toast('Done'); load();
			} catch (err) { toast(err.message, true); }
		});
		['q', 'role', 'ver'].forEach(id => $(id).addEventListener('input', draw));
		$('exportBtn').addEventListener('click', () => downloadCsv('users.csv', view));
		load();
	</script>
</AdminLayout>
