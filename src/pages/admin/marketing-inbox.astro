---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Marketing Inbox">
	<div class="max-w-4xl mx-auto space-y-6">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div><h1 class="text-2xl font-bold text-slate-900 dark:text-white">Marketing Inbox</h1><p id="count" class="text-sm text-slate-500">Loading…</p></div>
			<div class="flex gap-2"><button id="refresh" class="btn">Refresh</button><button id="exportBtn" class="btn">Export CSV</button></div>
		</div>
		<input id="q" class="inp" placeholder="Search messages…" />
		<div id="list" class="space-y-3"></div>
	</div>
	<script is:inline>
		const $ = id => document.getElementById(id); let all = [], view = [];
		async function load() { try { all = await api('/api/messages'); draw(); } catch (e) { toast(e.message, true); } }
		function draw() {
			const q = $('q').value.toLowerCase();
			view = all.filter(m => [m.name, m.email, m.message].join(' ').toLowerCase().includes(q));
			$('count').textContent = `${view.length} of ${all.length} messages`;
			$('list').innerHTML = view.length ? view.map(m => `
				<div class="card p-5">
					<div class="flex justify-between gap-3 mb-3">
						<div class="flex items-center gap-3">
							<div class="w-9 h-9 rounded-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center font-bold text-sm">${esc(m.name).charAt(0).toUpperCase()}</div>
							<div><div class="font-semibold text-slate-900 dark:text-white text-sm">${esc(m.name)}</div><div class="text-xs text-slate-500">${esc(m.email)}</div></div>
						</div>
						<span class="text-xs font-mono text-slate-500">#${m.id}</span>
					</div>
					<p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">${esc(m.message)}</p>
					<div class="flex gap-2 mt-4"><a class="btn btn-p" href="mailto:${esc(m.email)}?subject=Re:%20Your%20enquiry%20to%20RMG">Reply</a><button class="btn btn-d" data-id="${m.id}">Delete</button></div>
				</div>`).join('') : '<div class="card p-10 text-center text-sm text-slate-500">No messages found.</div>';
		}
		$('list').addEventListener('click', async e => {
			const b = e.target.closest('button[data-id]'); if (!b || !confirm('Delete this message?')) return;
			try { await api('/api/messages/' + b.dataset.id, { method: 'DELETE' }); toast('Message deleted'); load(); } catch (err) { toast(err.message, true); }
		});
		$('q').addEventListener('input', draw); $('refresh').addEventListener('click', load);
		$('exportBtn').addEventListener('click', () => downloadCsv('messages.csv', view));
		load();
	</script>
</AdminLayout>
