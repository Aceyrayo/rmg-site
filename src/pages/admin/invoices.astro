---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Invoices">
	<div class="max-w-7xl mx-auto space-y-6">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div><h1 class="text-2xl font-bold text-slate-900 dark:text-white">Invoices</h1><p id="count" class="text-sm text-slate-500">Loading…</p></div>
			<button id="exportBtn" class="btn">Export CSV</button>
		</div>
		<form id="form" class="card p-4 grid grid-cols-1 md:grid-cols-5 gap-3 items-end">
			<div class="md:col-span-2"><label class="text-xs font-semibold text-slate-500">Client</label><select id="user" class="inp" required></select></div>
			<div><label class="text-xs font-semibold text-slate-500">Invoice #</label><input id="num" class="inp" required placeholder="RMG-2026-002" /></div>
			<div><label class="text-xs font-semibold text-slate-500">Amount</label><input id="amt" class="inp" required placeholder="$299.00" /></div>
			<div><label class="text-xs font-semibold text-slate-500">Date</label><input id="date" type="date" class="inp" required /></div>
			<button class="btn btn-p md:col-span-5 md:justify-self-end !px-6 !py-2">Create invoice</button>
		</form>
		<div class="card"><div class="p-4 border-b border-slate-200 dark:border-slate-800"><input id="q" class="inp sm:max-w-xs" placeholder="Search invoices…" /></div><div id="tbl" class="overflow-x-auto"></div></div>
	</div>
	<script is:inline>
		const $ = id => document.getElementById(id); let all = [], view = [];
		const fmtDate = d => new Date(d + 'T00:00').toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
		async function load() {
			try {
				const [inv, users] = await Promise.all([api('/api/admin/invoices'), api('/api/admin/users')]);
				all = inv; $('user').innerHTML = users.map(u => `<option value="${u.id}">${esc(u.first_name)} ${esc(u.last_name)} — ${esc(u.email)}</option>`).join(''); draw();
			} catch (e) { toast(e.message, true); }
		}
		function draw() {
			const q = $('q').value.toLowerCase();
			view = all.filter(i => [i.invoice_number, i.user_email].join(' ').toLowerCase().includes(q));
			const total = view.reduce((s, i) => s + (parseFloat(String(i.amount).replace(/[^0-9.]/g, '')) || 0), 0);
			$('count').textContent = `${view.length} invoices · total ${total.toLocaleString('en-US', { style: 'currency', currency: 'USD' })}`;
			table($('tbl'), [
				{ h: 'Invoice', f: i => `<span class="font-mono font-semibold">${esc(i.invoice_number)}</span>` },
				{ h: 'Client', f: i => esc(i.user_email) }, { h: 'Amount', f: i => `<span class="font-semibold">${esc(i.amount)}</span>` },
				{ h: 'Date', f: i => esc(i.date) }, { h: '', f: i => `<div class="text-right"><button class="btn btn-d" data-id="${i.id}">Delete</button></div>` }
			], view);
		}
		$('form').addEventListener('submit', async e => {
			e.preventDefault();
			try {
				await api('/api/admin/invoices', { method: 'POST', body: JSON.stringify({ user_id: +$('user').value, invoice_number: $('num').value.trim(), amount: $('amt').value.trim(), date: fmtDate($('date').value) }) });
				toast('Invoice created'); e.target.reset(); load();
			} catch (err) { toast(err.message, true); }
		});
		$('tbl').addEventListener('click', async e => {
			const b = e.target.closest('button[data-id]'); if (!b || !confirm('Delete this invoice?')) return;
			try { await api('/api/admin/invoices/' + b.dataset.id, { method: 'DELETE' }); toast('Invoice deleted'); load(); } catch (err) { toast(err.message, true); }
		});
		$('q').addEventListener('input', draw); $('exportBtn').addEventListener('click', () => downloadCsv('invoices.csv', view));
		load();
	</script>
</AdminLayout>
