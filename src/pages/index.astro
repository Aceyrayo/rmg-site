---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<!-- HERO SECTION -->
	<main class="max-w-7xl mx-auto px-8 pt-32 pb-24 text-center">
		<div class="inline-flex items-center space-x-2 bg-slate-900 border border-slate-800 rounded-full px-4 py-1.5 mb-8">
			<span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
			<span class="text-xs font-medium text-slate-300">Engineering the future</span>
		</div>
		
		<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
			Software built for <br class="hidden md:block" />
			<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">
				high stakes.
			</span>
		</h1>
		
		<p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
			RMG Technologies builds high-performance trading systems, military-grade software, and everyday tools that never fail.
		</p>

		<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
			<a href="#solutions" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-500 text-white px-8 py-3 rounded-md font-medium transition-colors">
				Explore our systems
			</a>
			<a href="/contact" class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 border border-slate-700 text-white px-8 py-3 rounded-md font-medium transition-colors">
				Contact Sales
			</a>
		</div>
	</main>

	<!-- FEATURES / SOLUTIONS SECTION -->
	<section id="solutions" class="border-t border-slate-800 bg-slate-900/50 w-full">
		<div class="max-w-7xl mx-auto px-8 py-24">
			<div class="mb-16">
				<h2 class="text-3xl font-bold text-white mb-4">Our Core Divisions</h2>
				<p class="text-slate-400">Reliability isn't a feature. It's the baseline.</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				<div class="p-8 border border-slate-800 rounded-xl bg-slate-950 hover:border-slate-600 transition-colors">
					<div class="w-12 h-12 bg-blue-500/10 text-blue-400 rounded-lg flex items-center justify-center mb-6 text-xl">⚡</div>
					<h3 class="text-xl font-bold text-white mb-3">Trading Systems</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Ultra-low latency execution engines and algorithmic trading infrastructure built for financial markets.</p>
				</div>

				<div class="p-8 border border-slate-800 rounded-xl bg-slate-950 hover:border-slate-600 transition-colors">
					<div class="w-12 h-12 bg-emerald-500/10 text-emerald-400 rounded-lg flex items-center justify-center mb-6 text-xl">🛡️</div>
					<h3 class="text-xl font-bold text-white mb-3">Defense & Military</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Secure, encrypted, and resilient software solutions for mission-critical defense operations.</p>
				</div>

				<div class="p-8 border border-slate-800 rounded-xl bg-slate-950 hover:border-slate-600 transition-colors">
					<div class="w-12 h-12 bg-purple-500/10 text-purple-400 rounded-lg flex items-center justify-center mb-6 text-xl">💻</div>
					<h3 class="text-xl font-bold text-white mb-3">Enterprise Tools</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Day-to-day software, custom APIs, and automation that streamline operations for modern businesses.</p>
				</div>
			</div>
		</div>
	</section>
</Layout>