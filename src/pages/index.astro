---
import Layout from '../layouts/layout.astro';
---

<Layout title="Enterprise Software">
	<main class="w-full relative overflow-hidden bg-slate-50">
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-blue-100/50 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

		<div class="relative max-w-7xl mx-auto px-8 pt-32 pb-24 flex flex-col items-center text-center">
			<div class="inline-flex items-center space-x-2 bg-white border border-slate-200 rounded-full px-4 py-1.5 mb-8 shadow-sm">
				<span class="w-2 h-2 rounded-full bg-blue-500"></span>
				<span class="text-xs font-semibold text-slate-600 tracking-widest uppercase">Systems Operational</span>
			</div>
			
			<h1 class="text-6xl md:text-8xl font-bold tracking-tighter text-slate-900 mb-8 leading-[1.05]">
				Software built for <br class="hidden md:block" />
				<span class="text-slate-400">high stakes.</span>
			</h1>
			
			<p class="text-lg md:text-xl text-slate-500 max-w-2xl mx-auto mb-12 leading-relaxed">
				RMG Technologies builds high-performance trading systems, military-grade software, and everyday tools that never fail. Engineered for zero downtime.
			</p>

			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
				<a href="/signup" class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white px-8 py-3 rounded-md font-semibold transition-all shadow-md">
					Deploy Now
				</a>
				<a href="/contact" class="w-full sm:w-auto bg-white border border-slate-200 hover:border-slate-300 text-slate-900 px-8 py-3 rounded-md font-semibold transition-all shadow-sm">
					Talk to Sales
				</a>
			</div>

			<div class="w-full max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 mb-24">
				<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
					<p id="liveUsers" class="text-3xl font-bold text-slate-900 mb-1 animate-pulse">...</p>
					<p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Global Users</p>
				</div>
				<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
					<p class="text-3xl font-bold text-slate-900 mb-1">99.99%</p>
					<p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Uptime SLA</p>
				</div>
				<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
					<p class="text-3xl font-bold text-slate-900 mb-1">&lt; 10ms</p>
					<p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Latency</p>
				</div>
				<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
					<p class="text-3xl font-bold text-slate-900 mb-1">AES-256</p>
					<p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Encryption</p>
				</div>
			</div>
		</div>

		<section id="solutions" class="max-w-7xl mx-auto px-8 py-24">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">Our Core Divisions</h2>
				<p class="text-slate-500 max-w-2xl mx-auto">We don't build bloated software. We build lean, secure, and fast applications for environments where failure is not an option.</p>
			</div>

			<!-- THE COOL BLACK HOVER CARDS -->
			<div class="grid md:grid-cols-3 gap-6">
				<!-- Card 1 -->
				<div class="group p-8 rounded-2xl bg-white border border-slate-200 shadow-sm hover:bg-slate-900 hover:border-slate-900 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl cursor-pointer">
					<div class="w-12 h-12 bg-blue-50 text-blue-600 group-hover:bg-slate-800 group-hover:text-white rounded-lg flex items-center justify-center mb-6 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" /></svg>
					</div>
					<h3 class="text-xl font-bold text-slate-900 group-hover:text-white mb-3 transition-colors">Trading Systems</h3>
					<p class="text-slate-500 group-hover:text-slate-400 text-sm leading-relaxed transition-colors">Ultra-low latency execution engines and algorithmic trading infrastructure built for financial markets.</p>
				</div>

				<!-- Card 2 -->
				<div class="group p-8 rounded-2xl bg-white border border-slate-200 shadow-sm hover:bg-slate-900 hover:border-slate-900 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl cursor-pointer">
					<div class="w-12 h-12 bg-emerald-50 text-emerald-600 group-hover:bg-slate-800 group-hover:text-white rounded-lg flex items-center justify-center mb-6 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
					</div>
					<h3 class="text-xl font-bold text-slate-900 group-hover:text-white mb-3 transition-colors">Defense & Military</h3>
					<p class="text-slate-500 group-hover:text-slate-400 text-sm leading-relaxed transition-colors">Secure, encrypted, and resilient software solutions for mission-critical defense operations.</p>
				</div>

				<!-- Card 3 -->
				<div class="group p-8 rounded-2xl bg-white border border-slate-200 shadow-sm hover:bg-slate-900 hover:border-slate-900 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl cursor-pointer">
					<div class="w-12 h-12 bg-purple-50 text-purple-600 group-hover:bg-slate-800 group-hover:text-white rounded-lg flex items-center justify-center mb-6 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
					</div>
					<h3 class="text-xl font-bold text-slate-900 group-hover:text-white mb-3 transition-colors">Enterprise Tools</h3>
					<p class="text-slate-500 group-hover:text-slate-400 text-sm leading-relaxed transition-colors">Day-to-day software, custom APIs, and automation that streamline operations for modern businesses.</p>
				</div>
			</div>
		</section>
	</main>

	<script is:inline>
		async function fetchStats() {
			const userDisplay = document.getElementById('liveUsers');
			try {
				const response = await fetch('https://rmg-api-e46k.onrender.com/api/stats');
				const data = await response.json();
				userDisplay.innerText = data.global_users.toLocaleString() + "+";
				userDisplay.classList.remove('animate-pulse');
			} catch (error) {
				userDisplay.innerText = "15,000+"; 
				userDisplay.classList.remove('animate-pulse');
			}
		}
		fetchStats();
	</script>
</Layout>