---
import Layout from '../layouts/layout.astro';
---

<Layout title="Home">
	<main class="w-full">
		
		<!-- HERO SECTION -->
		<div class="max-w-7xl mx-auto px-8 pt-32 pb-24 flex flex-col items-center text-center">
			<!-- Small Badge -->
			<div class="inline-flex items-center space-x-2 bg-gray-50 border border-gray-200 rounded-full px-4 py-1.5 mb-8">
				<span class="w-2 h-2 rounded-full bg-black animate-pulse"></span>
				<span class="text-xs font-semibold text-gray-600 tracking-wide uppercase">Engineering the future</span>
			</div>
			
			<!-- Massive Headline -->
			<h1 class="text-6xl md:text-8xl font-bold tracking-tighter text-black mb-8 leading-[1.05]">
				Software built for <br class="hidden md:block" />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-500 to-black">
					high stakes.
				</span>
			</h1>
			
			<!-- Subtitle -->
			<p class="text-lg md:text-xl text-gray-500 max-w-2xl mx-auto mb-12 leading-relaxed">
				RMG Technologies builds high-performance trading systems, military-grade software, and everyday tools that never fail.
			</p>

			<!-- Buttons -->
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<a href="/signup" class="w-full sm:w-auto bg-black hover:bg-gray-800 text-white px-8 py-3 rounded-full font-semibold transition-colors shadow-lg shadow-black/10">
					Deploy Now
				</a>
				<a href="/contact" class="w-full sm:w-auto bg-white border border-gray-200 hover:border-gray-400 text-black px-8 py-3 rounded-full font-semibold transition-colors">
					Talk to Sales
				</a>
			</div>
		</div>

		<!-- CORE DIVISIONS (ID RESTORED HERE) -->
		<section id="solutions" class="border-t border-gray-200 bg-gray-50 w-full">
			<div class="max-w-7xl mx-auto px-8 py-32">
				<div class="mb-16 md:flex md:items-end md:justify-between">
					<div>
						<h2 class="text-3xl font-bold tracking-tight text-black mb-2">Our Core Divisions</h2>
						<p class="text-gray-500">Reliability isn't a feature. It's the baseline.</p>
					</div>
				</div>

				<div class="grid md:grid-cols-3 gap-6">
					<!-- Card 1 -->
					<div class="group p-8 border border-gray-200 rounded-2xl bg-white hover:bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-gray-200/50">
						<div class="w-12 h-12 bg-gray-50 text-black rounded-xl flex items-center justify-center mb-6 border border-gray-200 group-hover:border-black transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" /></svg>
						</div>
						<h3 class="text-xl font-semibold text-black mb-3">Trading Systems</h3>
						<p class="text-gray-500 text-sm leading-relaxed">
							Ultra-low latency execution engines and algorithmic trading infrastructure built for financial markets.
						</p>
					</div>

					<!-- Card 2 -->
					<div class="group p-8 border border-gray-200 rounded-2xl bg-white hover:bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-gray-200/50">
						<div class="w-12 h-12 bg-gray-50 text-black rounded-xl flex items-center justify-center mb-6 border border-gray-200 group-hover:border-black transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
						</div>
						<h3 class="text-xl font-semibold text-black mb-3">Defense & Military</h3>
						<p class="text-gray-500 text-sm leading-relaxed">
							Secure, encrypted, and resilient software solutions for mission-critical defense operations.
						</p>
					</div>

					<!-- Card 3 -->
					<div class="group p-8 border border-gray-200 rounded-2xl bg-white hover:bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-gray-200/50">
						<div class="w-12 h-12 bg-gray-50 text-black rounded-xl flex items-center justify-center mb-6 border border-gray-200 group-hover:border-black transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
						</div>
						<h3 class="text-xl font-semibold text-black mb-3">Enterprise Tools</h3>
						<p class="text-gray-500 text-sm leading-relaxed">
							Day-to-day software, custom APIs, and automation that streamline operations for modern businesses.
						</p>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>