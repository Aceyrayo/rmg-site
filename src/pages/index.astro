---
import Layout from '../layouts/layout.astro';
const divisions = [
	{ t: 'Trading Systems', c: 'blue', d: 'Ultra-low latency execution engines and algorithmic trading infrastructure built for financial markets.', f: ['Deployable algorithmic bots', 'Live crypto & forex market data', 'Signed webhooks & REST API'], icon: 'M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5' },
	{ t: 'Defense & Military', c: 'emerald', d: 'Secure, encrypted, and resilient software solutions for mission-critical defense operations.', f: ['Client-side encrypted vault', 'IP allowlists & session control', 'Full audit trail of every action'], icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' },
	{ t: 'Enterprise Tools', c: 'purple', d: 'Day-to-day software, custom APIs, and automation that streamline operations for modern businesses.', f: ['CRM & sales pipeline', 'Workflow automation & alerts', 'Reports in CSV, JSON & PDF'], icon: 'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5' }
];
const features = [
	['Live market data', 'Crypto prices and forex rates, refreshed every 30 seconds, via dashboard or API.'],
	['Developer API', 'Scoped API keys, REST endpoints and signed webhooks to connect your own software.'],
	['Encrypted vault', 'Files are encrypted in your browser with AES-GCM before they ever reach our servers.'],
	['Security controls', 'IP allowlists, session length limits and one-click sign-out on every device.'],
	['Team & roles', 'Invite colleagues and assign Admin, Developer or Read-Only roles.'],
	['Audit & monitoring', 'Every action logged, with live status, threat monitoring and exportable reports.']
];
const faqs = [
	['How do I get started?', 'Create a free account, verify your email with the 6-digit code we send, and you land in your workspace where you can create API keys and deploy your first engine.'],
	['Is my data secure?', 'Traffic is encrypted with TLS, passwords are hashed with bcrypt, API keys are stored only as hashes, and vault files are encrypted in your browser so we never see their contents.'],
	['Can I try it before paying?', 'Yes. The Developer plan is free and includes 1,000 API calls per month. Upgrade any time from your billing page.'],
	['Do you offer custom or on-premise deployments?', 'Yes — our Enterprise plan includes on-premise deployment, a dedicated account manager and custom SLAs. Contact us and we will scope it with you.'],
	['How do I reach support?', 'Signed-in clients can open a ticket from the Support Center, or use the AI assistant in the corner for quick answers.']
];
---
<Layout title="Enterprise Software">
<main class="w-full relative overflow-hidden bg-slate-50">
	<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-blue-100/50 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

	<!-- HERO -->
	<div class="relative max-w-7xl mx-auto px-6 sm:px-8 pt-28 sm:pt-32 pb-20 flex flex-col items-center text-center">
		<div id="statusPill" class="inline-flex items-center space-x-2 bg-white border border-slate-200 rounded-full px-4 py-1.5 mb-8 shadow-sm pointer-events-none">
			<span id="statusDot" class="w-2 h-2 rounded-full bg-slate-300 animate-pulse"></span>
			<span id="statusText" class="text-xs font-semibold text-slate-600 tracking-widest uppercase">Checking systems…</span>
		</div>
		<h1 class="text-5xl sm:text-6xl md:text-8xl font-bold tracking-tighter text-slate-900 mb-8 leading-[1.05]">
			Software built for <br class="hidden md:block" /><span class="text-slate-400">high stakes.</span>
		</h1>
		<p class="text-lg md:text-xl text-slate-500 max-w-2xl mx-auto mb-10 leading-relaxed">
			RMG Technologies builds high-performance trading systems, military-grade software, and everyday tools that never fail. Engineered for zero downtime.
		</p>
		<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6 w-full sm:w-auto">
			<a href="/signup" class="w-full sm:w-auto bg-slate-900 hover:bg-slate-800 text-white px-8 py-3 rounded-md font-semibold transition-all shadow-md">Deploy Now — it's free</a>
			<a href="/contact" class="w-full sm:w-auto bg-white border border-slate-200 hover:border-slate-300 text-slate-900 px-8 py-3 rounded-md font-semibold transition-all shadow-sm">Talk to Sales</a>
		</div>
		<p class="text-sm text-slate-500 mb-16">No credit card required · <a href="/pricing" class="text-blue-600 hover:underline">See pricing</a> · <a href="/login" class="text-blue-600 hover:underline">Sign in</a></p>

		<div class="w-full max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8">
			<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm"><p id="liveUsers" class="text-3xl font-bold text-slate-900 mb-1 animate-pulse">…</p><p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Global Users</p></div>
			<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm"><p class="text-3xl font-bold text-slate-900 mb-1">99.99%</p><p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Uptime SLA</p></div>
			<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm"><p class="text-3xl font-bold text-slate-900 mb-1">&lt; 10ms</p><p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Latency</p></div>
			<div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm"><p class="text-3xl font-bold text-slate-900 mb-1">AES-256</p><p class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Encryption</p></div>
		</div>
	</div>

	<!-- DIVISIONS -->
	<section id="solutions" class="max-w-7xl mx-auto px-6 sm:px-8 py-20">
		<div class="text-center mb-14">
			<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">Our Core Divisions</h2>
			<p class="text-slate-500 max-w-2xl mx-auto">We don't build bloated software. We build lean, secure, and fast applications for environments where failure is not an option.</p>
		</div>
		<div class="grid md:grid-cols-3 gap-6">
			{divisions.map(d => (
				<a href="/signup" class="group p-8 rounded-2xl bg-white border border-slate-200 shadow-sm hover:bg-slate-900 hover:border-slate-900 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl block">
					<div class="w-12 h-12 bg-slate-100 text-slate-700 group-hover:bg-slate-800 group-hover:text-white rounded-lg flex items-center justify-center mb-6 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d={d.icon} /></svg>
					</div>
					<h3 class="text-xl font-bold text-slate-900 group-hover:text-white mb-3 transition-colors">{d.t}</h3>
					<p class="text-slate-500 group-hover:text-slate-400 text-sm leading-relaxed mb-5 transition-colors">{d.d}</p>
					<ul class="space-y-2 text-sm text-slate-600 group-hover:text-slate-300 transition-colors">
						{d.f.map(x => <li class="flex gap-2"><span class="text-blue-500 group-hover:text-blue-400 font-bold">✓</span>{x}</li>)}
					</ul>
					<p class="mt-6 text-sm font-semibold text-slate-900 group-hover:text-white transition-colors">Get started →</p>
				</a>
			))}
		</div>
	</section>

	<!-- HOW IT WORKS -->
	<section class="bg-white border-y border-slate-200">
		<div class="max-w-7xl mx-auto px-6 sm:px-8 py-20">
			<div class="text-center mb-14"><h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">Up and running in minutes</h2><p class="text-slate-500">Three steps from sign-up to your first deployment.</p></div>
			<div class="grid md:grid-cols-3 gap-10">
				{[['1', 'Create your account', 'Sign up with your work email and verify it with a 6-digit security code.'], ['2', 'Configure your workspace', 'Generate scoped API keys, invite your team and set your security policy.'], ['3', 'Deploy & monitor', 'Launch engines, connect webhooks and watch everything live from one dashboard.']].map(([n, t, d]) => (
					<div class="text-center"><div class="w-12 h-12 mx-auto rounded-full bg-slate-900 text-white font-bold flex items-center justify-center mb-5">{n}</div><h3 class="text-lg font-bold text-slate-900 mb-2">{t}</h3><p class="text-slate-500 text-sm leading-relaxed">{d}</p></div>
				))}
			</div>
		</div>
	</section>

	<!-- FEATURES -->
	<section class="max-w-7xl mx-auto px-6 sm:px-8 py-20">
		<div class="text-center mb-14"><h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">Everything you need, built in</h2><p class="text-slate-500 max-w-2xl mx-auto">A complete client platform — not a collection of add-ons.</p></div>
		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
			{features.map(([t, d]) => (
				<div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm"><h3 class="font-bold text-slate-900 mb-2">{t}</h3><p class="text-sm text-slate-500 leading-relaxed">{d}</p></div>
			))}
		</div>
	</section>

	<!-- FAQ -->
	<section class="max-w-3xl mx-auto px-6 sm:px-8 pb-20">
		<h2 class="text-3xl font-bold tracking-tight text-slate-900 text-center mb-10">Frequently asked questions</h2>
		<div class="bg-white border border-slate-200 rounded-2xl divide-y divide-slate-200 shadow-sm">
			{faqs.map(([q, a]) => (
				<details class="group p-6"><summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-slate-900">{q}<span class="text-slate-400 group-open:rotate-45 transition-transform text-xl leading-none">+</span></summary><p class="text-slate-500 text-sm leading-relaxed mt-3">{a}</p></details>
			))}
		</div>
	</section>

	<!-- FINAL CTA -->
	<section class="px-6 sm:px-8 pb-24">
		<div class="max-w-5xl mx-auto bg-slate-900 rounded-3xl p-10 sm:p-16 text-center relative overflow-hidden">
			<div class="absolute -top-24 -right-24 w-72 h-72 bg-blue-500/20 blur-[90px] rounded-full pointer-events-none"></div>
			<h2 class="relative text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">Ready to build on infrastructure that doesn't fail?</h2>
			<p class="relative text-slate-400 mb-8 max-w-xl mx-auto">Start free today, or talk to our team about a custom deployment.</p>
			<div class="relative flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/signup" class="bg-white text-slate-900 font-semibold px-8 py-3 rounded-md hover:bg-slate-100 transition-colors">Create free account</a>
				<a href="/contact" class="border border-slate-600 text-white font-semibold px-8 py-3 rounded-md hover:bg-slate-800 transition-colors">Contact sales</a>
			</div>
		</div>
	</section>
</main>

<script is:inline>
	(async () => {
		const u = document.getElementById('liveUsers');
		const r = await RMG.call('/api/stats');
		u.innerText = r.ok ? Number(r.data.global_users).toLocaleString() + (r.data.global_users >= 100 ? '+' : '') : '—';
		u.classList.remove('animate-pulse');
		const s = await RMG.call('/api/status');
		const dot = document.getElementById('statusDot'), txt = document.getElementById('statusText');
		dot.classList.remove('animate-pulse', 'bg-slate-300');
		if (s.ok) { const ok = s.data.components.every(c => ['Operational', 'Unknown', 'Not configured'].includes(c.status)); dot.classList.add(ok ? 'bg-emerald-500' : 'bg-amber-500'); txt.innerText = ok ? 'All systems operational' : 'Partial degradation'; }
		else { dot.classList.add('bg-slate-400'); txt.innerText = 'Status unavailable'; }
	})();
</script>
</Layout>
