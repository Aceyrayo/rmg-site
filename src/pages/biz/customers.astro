---
import BizLayout from '../../layouts/BizLayout.astro';
---
<BizLayout title="Customers">
	<div id="app" class="max-w-6xl mx-auto"></div>
	<script is:inline>
BIZ.ready.then(async () => {
 const app = document.getElementById('app'), g = id => document.getElementById(id); let all = [], view = [];
 const F = [{ k: 'name', l: 'Name / company', req: 1 }, { k: 'email', l: 'Email', t: 'email' }, { k: 'phone', l: 'Phone' }, { k: 'address', l: 'Address' }, { k: 'notes', l: 'Notes', t: 'textarea' }];
 app.innerHTML = pageHead('Customers', '<span id="cnt"></span>', '<button id="ex" class="btn">Export CSV</button>' + (BIZ.can('sell') ? '<button id="im" class="btn">Import CSV</button><button id="nw" class="btn btn-p">+ New customer</button>' : '')) + '<div class="card mt-6"><div class="p-4 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center gap-3"><input id="q" class="inp sm:max-w-xs" placeholder="Search customers…"><label class="flex items-center gap-2 text-sm"><input id="ow" type="checkbox"> Owing money only</label></div><div id="tb" class="overflow-x-auto"></div></div>';
 const draw = () => { const q = g('q').value.toLowerCase(); view = all.filter(c => (!g('ow').checked || c.balance > 0) && (c.name + c.email + c.phone).toLowerCase().includes(q));
  g('cnt').textContent = `${view.length} customers · ${fmt(all.reduce((s, c) => s + c.balance, 0))} owed to you`;
  table(g('tb'), [{ h: 'Customer', f: c => `<b>${esc(c.name)}</b><div class="text-xs text-slate-500">${esc(c.email || '')} ${esc(c.phone || '')}</div>` }, { h: 'Total billed', f: c => fmt(c.billed) }, { h: 'Owes', f: c => c.balance ? '<b class="text-amber-600">' + fmt(c.balance) + '</b>' : '—' }, { h: 'Documents', f: c => c.documents },
   { h: '', f: c => `<div class="flex gap-1 justify-end"><button class="btn" data-s="${c.id}">Statement</button>${BIZ.can('sell') ? `<a class="btn" href="/biz/pos?mode=invoice&customer=${c.id}">Invoice</a><button class="btn" data-e="${c.id}">Edit</button>` : ''}${BIZ.can('void') ? `<button class="btn btn-d" data-d="${c.id}">Delete</button>` : ''}</div>` }], view); };
 const load = async () => { all = await bapi('/customers'); draw(); };
 function parseCsv(text) {
  const rows = []; let row = [], cell = '', q = false;
  for (let i = 0; i < text.length; i++) { const c = text[i]; if (q) { if (c === '"') { if (text[i + 1] === '"') { cell += '"'; i++; } else q = false; } else cell += c; } else if (c === '"') q = true; else if (c === ',') { row.push(cell); cell = ''; } else if (c === '\n' || c === '\r') { if (c === '\r' && text[i + 1] === '\n') i++; row.push(cell); cell = ''; if (row.some(x => x.trim())) rows.push(row); row = []; } else cell += c; }
  if (cell || row.length) { row.push(cell); rows.push(row); }
  return rows;
 }
 g('tb').onclick = async e => { const b = e.target.closest('button'); if (!b) return; const id = b.dataset.s || b.dataset.e || b.dataset.d, c = all.find(x => x.id == id);
  try { if (b.dataset.e) { const v = await ask('Edit customer', F, c); if (!v) return; await bapi('/customers/' + id, bjson('PATCH', v)); toast('Saved'); load(); }
   else if (b.dataset.d) { if (!confirm('Delete ' + c.name + '?')) return; await bapi('/customers/' + id, { method: 'DELETE' }); toast('Deleted'); load(); }
   else if (b.dataset.s) { const docs = await bapi('/sales?customer_id=' + id), d = document.createElement('dialog'); d.className = 'card p-0 w-full max-w-2xl backdrop:bg-slate-900/60 text-slate-900 dark:text-slate-200';
    d.innerHTML = `<div class="p-6"><div class="flex justify-between mb-4"><div><h2 class="font-bold text-lg">${esc(c.name)}</h2><p class="text-sm text-slate-500">Billed ${fmt(c.billed)} · Owes <b>${fmt(c.balance)}</b></p></div><button class="btn" data-pr>Print</button></div><div id="sx" class="max-h-80 overflow-y-auto"></div><div class="flex justify-end mt-4"><button class="btn" data-x>Close</button></div></div>`; document.body.appendChild(d); d.showModal();
    d.querySelector('[data-x]').onclick = () => { d.close(); d.remove(); }; table(d.querySelector('#sx'), [{ h: 'Number', f: s => '<span class="font-mono text-xs">' + esc(s.number) + '</span>' }, { h: 'Date', f: s => esc(s.date) }, { h: 'Total', f: s => fmt(s.total) }, { h: 'Balance', f: s => fmt(s.balance) }, { h: '', f: s => docStatus(s) }], docs);
    d.querySelector('[data-pr]').onclick = () => printTable('Statement · ' + c.name, ['number', 'date', 'total', 'balance', 'status'], docs); } } catch (err) { toast(err.message, true); } };
 if (g('nw')) {
  g('nw').onclick = async () => { const v = await ask('New customer', F); if (!v) return; try { await bapi('/customers', bjson('POST', v)); toast('Customer added'); load(); } catch (e) { toast(e.message, true); } };
  g('im').onclick = () => {
   const d = document.createElement('dialog'); d.className = 'card p-0 w-full max-w-lg backdrop:bg-slate-900/60 text-slate-900 dark:text-slate-200';
   d.innerHTML = `<div class="p-6 space-y-4"><h2 class="text-lg font-bold">Import customers from CSV</h2><p class="text-sm text-slate-500">Columns: <code>name, email, phone, address, notes</code>. Only <b>name</b> is required.</p><a href="#" id="tpl" class="text-sm text-blue-500 hover:underline">Download Grace Pure Honey sample CSV</a><input type="file" id="fl" accept=".csv,text/csv" class="inp"><p id="pv" class="text-sm text-slate-500"></p><div class="flex justify-end gap-2"><button class="btn" data-x>Cancel</button><button class="btn btn-p" id="go" disabled>Import</button></div></div>`;
   document.body.appendChild(d); d.showModal(); let items = []; const close = () => { d.close(); d.remove(); }; d.querySelector('[data-x]').onclick = close;
   d.querySelector('#tpl').onclick = e => { e.preventDefault(); const sample = `name,email,phone,address,notes\n"Naivas Supermarket Ltd (Head Office)",procurement@naivas.co.ke,+254 711 082 000,"Sameer Business Park, Mombasa Rd, Nairobi","LPO required before delivery. 30-day credit terms."\n"Quickmart Supermarket (Supply Chain)",buyers@quickmart.co.ke,+254 709 740 000,"Ruaka / Kiambu Rd, Nairobi","Barcoded jars only (KEBS mark). Weekly restock Tuesday."\n"Chandarana Foodplus Supermarket",purchasing@foodplus.co.ke,+254 733 600 111,"Diamond Plaza, Parklands, Nairobi","Premium line: Comb honey, Bee pollen & Propolis."\n"State Dept. for Livestock — Apiculture Tender",tenders@kilimo.go.ke,+254 20 271 8870,"Kilimo House, Cathedral Rd, Nairobi","Tender Ref: MOALD/SDLD/042/2026 — 150 Langstroth hives & training."\n"Kenya National Hospital Nutrition Dept.",procurement@knh.or.ke,+254 20 272 6300,"Hospital Rd, Upper Hill, Nairobi","Quarterly bulk tender: 20L food-grade raw honey jerrycans."\n"County Govt. of Makueni — Agribusiness",supplychain@makueni.go.ke,+254 722 900 410,"Wote Town, Makueni County","Youth & Women Beekeeping Empowerment Program — 80 hives."\n"Artcaffe Coffee & Bakery (Central Kitchen)",purchasing@artcaffe.co.ke,+254 701 222 333,"Westlands, Nairobi","Monthly 20L bulk wildflower honey order."\n"Sarova Panafric Hotel",stores@sarovahotels.com,+254 709 111 000,"Valley Rd, Nairobi","Breakfast buffet 1kg jars + Comb honey. 14-day invoice terms."\n"Grace Wanjiku (Regular Customer)",grace.wanjiku@gmail.com,+254 721 445 890,"Kilimani, Nairobi","Orders 2x 1kg Acacia honey monthly via M-Pesa."\n"David Kamau (Regular / Reseller)",dkamau.ventures@gmail.com,+254 714 889 201,"Rongai, Kajiado","Buys 10x 500g jars cash on pickup."\n"Dr. Amina Hassan",amina.hassan@yahoo.com,+254 734 512 990,"South C, Nairobi","Regular buyer of Royal Jelly, Propolis dropper & Bee Pollen."\n`;
    const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([sample], { type: 'text/csv' })); a.download = 'grace-honey-customers.csv'; a.click(); };
   d.querySelector('#fl').onchange = async e => { const f = e.target.files[0]; if (!f) return; const rows = parseCsv(await f.text());
    const head = (rows.shift() || []).map(h => h.trim().toLowerCase()); const ix = k => head.indexOf(k);
    items = rows.map(r => ({ name: (r[ix('name')] || '').trim(), email: (r[ix('email')] || '').trim(), phone: (r[ix('phone')] || '').trim(), address: (r[ix('address')] || '').trim(), notes: (r[ix('notes')] || '').trim() })).filter(x => x.name);
    d.querySelector('#pv').textContent = ix('name') < 0 ? 'No "name" column found.' : items.length + ' customers ready to import.'; d.querySelector('#go').disabled = !items.length || ix('name') < 0; };
   d.querySelector('#go').onclick = async () => { const btn = d.querySelector('#go'); btn.disabled = true; btn.textContent = 'Importing…'; let ok = 0;
    for (const item of items) { try { await bapi('/customers', bjson('POST', item)); ok++; } catch (_) {} }
    toast(`${ok} customer(s) imported`); close(); load(); };
  };
 }
 g('q').oninput = draw; g('ow').onchange = draw; g('ex').onclick = () => downloadCsv('customers.csv', view.map(c => ({ name: c.name, email: c.email, phone: c.phone, address: c.address, billed: c.billed, owes: c.balance })));
 load().catch(e => toast(e.message, true));
});
	</script>
</BizLayout>