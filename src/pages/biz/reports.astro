---
import BizLayout from '../../layouts/BizLayout.astro';
---
<BizLayout title="Reports">
	<div id="app" class="max-w-6xl mx-auto"></div>
	<script is:inline>
BIZ.ready.then(async () => {
 const app = document.getElementById('app'), g = id => document.getElementById(id); let tab = 'pl', data = null;
 if (!BIZ.can('finance')) { app.innerHTML = '<div class="card p-8 text-center text-slate-500">Your role cannot view reports.</div>'; return; }
 const iso = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
 const PRE = { month: () => [monthStart(), today()], last: () => { const n = new Date(), a = new Date(n.getFullYear(), n.getMonth() - 1, 1), b = new Date(n.getFullYear(), n.getMonth(), 0); return [iso(a), iso(b)]; }, d30: () => { const n = new Date(); return [iso(new Date(n - 29 * 864e5)), today()]; }, year: () => [today().slice(0, 4) + '-01-01', today()] };
 app.innerHTML = pageHead('Reports', 'Profit, receivables and stock valuation', '<button id="ex" class="btn">Export CSV</button><button id="pr" class="btn btn-p">Print / PDF</button>') + `
  <div class="card mt-6 p-4 flex flex-wrap gap-3 items-center"><select id="pre" class="inp !w-auto"><option value="month">This month</option><option value="last">Last month</option><option value="d30">Last 30 days</option><option value="year">This year</option><option value="custom">Custom…</option></select><input id="f" type="date" class="inp !w-auto"><input id="t" type="date" class="inp !w-auto"><button id="run" class="btn">Run</button>
   <div class="ml-auto flex gap-1" id="tabs"></div></div><div id="out" class="mt-6"></div>`;
 const tabs = () => { g('tabs').innerHTML = [['pl', 'Profit & Loss'], ['ar', 'Receivables'], ['inv', 'Inventory']].map(([k, l]) => `<button data-t="${k}" class="btn ${k === tab ? 'btn-p' : ''}">${l}</button>`).join(''); };
 const cols = d => { const m = Math.max(1, ...d.map(x => Math.max(x[1], x[3]))); return `<div class="flex items-end gap-1 h-48 overflow-x-auto">${d.map(([dt, r, c, e]) => `<div class="flex-1 min-w-[10px] flex items-end justify-center gap-px h-full" title="${dt} · revenue ${fmt(r)} · expenses ${fmt(e)}"><div class="w-1/2 bg-blue-500 rounded-t" style="height:${Math.max(r / m * 100, r ? 2 : 0)}%"></div><div class="w-1/2 bg-rose-400 rounded-t" style="height:${Math.max(e / m * 100, e ? 2 : 0)}%"></div></div>`).join('')}</div><p class="text-xs text-slate-500 mt-2"><span class="inline-block w-2 h-2 bg-blue-500 rounded-sm"></span> Revenue &nbsp; <span class="inline-block w-2 h-2 bg-rose-400 rounded-sm"></span> Expenses</p>`; };
 const run = async () => { g('out').innerHTML = '<div class="p-10 text-center text-sm text-slate-500 animate-pulse">Loading…</div>';
  try { if (tab === 'pl') { data = await bapi('/reports/summary?' + new URLSearchParams({ date_from: g('f').value, date_to: g('t').value })); const t = data.totals, mg = t.revenue ? (t.net / t.revenue * 100).toFixed(1) : '0.0';
    g('out').innerHTML = `<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">${stat('Revenue (excl. tax)', fmt(t.revenue))}${stat('Cost of goods sold', fmt(t.cogs))}${stat('Gross profit', fmt(t.gross), 'text-emerald-500')}${stat('Expenses', fmt(t.expenses))}${stat('Net profit', fmt(t.net), t.net >= 0 ? 'text-emerald-500' : 'text-red-500')}${stat('Net margin', mg + '%')}</div>
     <div class="grid lg:grid-cols-2 gap-6 mt-6">${panel('Daily revenue vs expenses', cols(data.daily))}${panel('Expenses by category', bars(data.expenses_by_category, fmt))}${panel('Top customers', bars(data.top_customers, fmt))}${panel('Payments received by method', bars(data.payments_by_method, fmt))}</div>
     <div class="card mt-6"><div class="p-5 font-bold text-slate-900 dark:text-white">Best-selling products</div><div id="tp" class="overflow-x-auto"></div></div><p class="text-xs text-slate-500 mt-4">Sales tax collected in this period: ${fmt(t.tax)} (not counted as revenue). Void documents are excluded.</p>`;
    table(g('tp'), [{ h: 'Product', f: p => '<b>' + esc(p.name) + '</b>' }, { h: 'Units sold', f: p => p.qty }, { h: 'Revenue', f: p => fmt(p.revenue) }, { h: 'Profit', f: p => '<b class="text-emerald-500">' + fmt(p.profit) + '</b>' }], data.top_products); }
   else if (tab === 'ar') { data = await bapi('/reports/receivables?today=' + today()); g('out').innerHTML = `<div class="grid lg:grid-cols-3 gap-6">${stat('Total owed to you', fmt(data.total), 'text-amber-500')}<div class="lg:col-span-2">${panel('Aging', bars(data.buckets, fmt))}</div></div><div class="card mt-6"><div id="tb" class="overflow-x-auto"></div></div>`;
    table(g('tb'), [{ h: 'Document', f: r => '<span class="font-mono text-xs">' + esc(r.number) + '</span>' }, { h: 'Customer', f: r => esc(r.customer) }, { h: 'Due', f: r => esc(r.due_date) }, { h: 'Days late', f: r => r.days_late ? badge(r.days_late, r.days_late > 30 ? 'red' : 'amber') : '—' }, { h: 'Balance', f: r => '<b>' + fmt(r.balance) + '</b>' }], data.rows); if (!data.rows.length) g('tb').innerHTML = '<div class="p-10 text-center text-sm text-slate-500">Nobody owes you anything 🎉</div>'; }
   else { data = await bapi('/reports/inventory'); g('out').innerHTML = `<div class="grid grid-cols-3 gap-4">${stat('Stock value (cost)', fmt(data.cost_value))}${stat('Retail value', fmt(data.retail_value))}${stat('Low / out of stock', data.low_count, data.low_count ? 'text-amber-500' : '')}</div><div class="card mt-6"><div id="tb" class="overflow-x-auto"></div></div>`;
    table(g('tb'), [{ h: 'Product', f: r => '<b>' + esc(r.name) + '</b><div class="text-xs text-slate-500">' + esc(r.sku || '') + '</div>' }, { h: 'In stock', f: r => badge(r.stock, r.stock <= 0 ? 'red' : r.low ? 'amber' : 'green') }, { h: 'Cost value', f: r => fmt(r.cost_value) }, { h: 'Retail value', f: r => fmt(r.retail_value) }], data.rows); } } catch (e) { g('out').innerHTML = ''; toast(e.message, true); } };
 const preset = () => { const k = g('pre').value; if (k !== 'custom') { const [a, b] = PRE[k](); g('f').value = a; g('t').value = b; } };
 g('pre').onchange = () => { preset(); run(); }; g('run').onclick = () => { g('pre').value = 'custom'; run(); }; g('tabs').onclick = e => { const b = e.target.closest('[data-t]'); if (b) { tab = b.dataset.t; tabs(); run(); } };
 g('ex').onclick = () => { if (!data) return; if (tab === 'pl') downloadCsv('profit-and-loss.csv', data.daily.map(([date, revenue, cogs, expenses]) => ({ date, revenue, cogs, expenses, profit: +(revenue - cogs - expenses).toFixed(2) }))); else downloadCsv(tab === 'ar' ? 'receivables.csv' : 'inventory-valuation.csv', data.rows); };
 g('pr').onclick = () => { if (!data) return; if (tab === 'pl') printTable('Profit & Loss ' + data.from + ' to ' + data.to, ['date', 'revenue', 'cogs', 'expenses'], data.daily.map(([date, revenue, cogs, expenses]) => ({ date, revenue, cogs, expenses }))); else printTable(tab === 'ar' ? 'Receivables' : 'Inventory valuation', Object.keys(data.rows[0] || {}), data.rows); };
 preset(); tabs(); run();
});
	</script>
</BizLayout>
