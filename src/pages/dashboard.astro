---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Admin Command">
	<div class="max-w-7xl mx-auto space-y-6">
		
		<!-- HEADER: Dark Mode Alert -->
		<div class="bg-slate-900 border border-slate-700 rounded-xl p-6 shadow-2xl relative overflow-hidden">
			<div class="absolute top-0 right-0 w-64 h-64 bg-red-500/10 blur-3xl rounded-full pointer-events-none"></div>
			<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10">
				<div>
					<h1 class="text-2xl font-bold text-white tracking-tight flex items-center gap-3">
						System Administrator
						<span class="text-xs bg-red-500/20 text-red-400 border border-red-500/30 px-2.5 py-1 rounded-full uppercase tracking-wider font-bold flex items-center gap-1.5">
							<span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-ping"></span>
							Root Access
						</span>
					</h1>
					<p class="text-slate-400 mt-1 text-sm font-mono">Node: US-East-1 | Version: v2.4.1-stable</p>
				</div>
				<div class="flex gap-3">
					<button id="exportBtn" class="bg-slate-800 hover:bg-slate-700 text-white border border-slate-600 px-4 py-2 rounded-lg text-sm font-semibold transition-colors">Export Audit Log</button>
					<a href="/admin/broadcast" class="bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors shadow-lg shadow-red-900/20">Send Broadcast</a>
				</div>
			</div>
		</div>

		<!-- STATS GRID -->
		<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
			<!-- Stat 1 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm relative overflow-hidden">
				<div class="absolute -right-4 -top-4 w-16 h-16 bg-blue-500/10 rounded-full blur-xl"></div>
				<div class="flex justify-between items-start mb-4">
					<div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-900/30 text-blue-600 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
					</div>
					<span class="text-emerald-500 text-xs font-bold bg-emerald-50 dark:bg-emerald-900/20 px-2 py-1 rounded">+12%</span>
				</div>
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Total Registered Users</p>
				<p id="statUsers" class="text-3xl font-bold text-slate-900 dark:text-white">...</p>
			</div>

			<!-- Stat 2 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<div class="flex justify-between items-start mb-4">
					<div class="w-10 h-10 rounded-lg bg-purple-50 dark:bg-purple-900/30 text-purple-600 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
					</div>
				</div>
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Verified Accounts</p>
				<p id="statVerified" class="text-3xl font-bold text-slate-900 dark:text-white">...</p>
			</div>

			<!-- Stat 3 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<div class="flex justify-between items-start mb-4">
					<div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-900/30 text-amber-600 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
					</div>
				</div>
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Open Support Tickets</p>
				<p id="statTickets" class="text-3xl font-bold text-slate-900 dark:text-white">...</p>
			</div>

			<!-- Stat 4 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<div class="flex justify-between items-start mb-4">
					<div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>
					</div>
					<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mt-2"></span>
				</div>
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Server Health</p>
				<p class="text-3xl font-bold text-emerald-500">99.99%</p>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			
			<!-- LEFT COL: USER MANAGEMENT & INBOX -->
			<div class="lg:col-span-2 space-y-6">
				
				<!-- Inbox -->
				<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
					<div class="p-5 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center bg-slate-50 dark:bg-slate-900/50">
						<h2 class="text-lg font-bold text-slate-900 dark:text-white">Marketing Inbox</h2>
						<div class="flex gap-4 text-sm font-semibold"><a href="/admin/marketing-inbox" class="text-slate-500 hover:underline">View all</a><button id="refreshBtn" class="text-blue-600 dark:text-blue-400 hover:underline">Refresh</button></div>
					</div>
					<div id="messagesList" class="divide-y divide-slate-100 dark:divide-slate-800 max-h-[400px] overflow-y-auto">
						<div class="p-8 text-center text-slate-500 text-sm animate-pulse">Fetching secure data...</div>
					</div>
				</div>

			</div>

			<!-- RIGHT COL: LIVE TERMINAL LOGS -->
			<div class="lg:col-span-1 space-y-6">
				<div class="bg-slate-950 border border-slate-800 rounded-xl shadow-lg overflow-hidden flex flex-col h-[400px]">
					<div class="p-3 border-b border-slate-800 flex items-center justify-between bg-slate-900">
						<div class="flex items-center gap-2">
							<div class="w-3 h-3 rounded-full bg-red-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-green-500/80"></div>
							<span class="ml-2 text-xs font-mono text-slate-400">system.log</span>
						</div>
						<span class="text-xs text-emerald-400 font-mono animate-pulse">● LIVE</span>
					</div>
					<div class="p-4 flex-1 overflow-y-auto font-mono text-xs text-slate-300 space-y-2">
						<p><span class="text-slate-500">[10:42:01]</span> <span class="text-blue-400">INFO</span> DB connection established.</p>
						<p><span class="text-slate-500">[10:42:05]</span> <span class="text-emerald-400">SUCCESS</span> User authentication passed.</p>
						<p><span class="text-slate-500">[10:43:12]</span> <span class="text-amber-400">WARN</span> High latency detected on US-East.</p>
						<p><span class="text-slate-500">[10:43:15]</span> <span class="text-blue-400">INFO</span> Auto-scaling triggered (Node +2).</p>
						<p><span class="text-slate-500">[10:44:00]</span> <span class="text-emerald-400">SUCCESS</span> Backup completed (2.4GB).</p>
						<p class="animate-pulse"><span class="text-slate-500">[10:45:00]</span> <span class="text-slate-400">_</span></p>
					</div>
				</div>
			</div>

		</div>
	</div>

	<script is:inline>
		const $ = id => document.getElementById(id);
		async function fetchStats() {
			try {
				const s = await api('/api/admin/stats');
				$('statUsers').innerText = s.users;
				$('statVerified').innerText = s.verified;
				$('statTickets').innerText = s.open_tickets;
			} catch (e) { $('statUsers').innerText = 'Err'; }
		}
		async function fetchMessages() {
			$('messagesList').innerHTML = '<div class="p-8 text-center text-slate-500 text-sm animate-pulse">Fetching data...</div>';
			try {
				const data = await api('/api/messages');
				if (!data.length) { $('messagesList').innerHTML = '<div class="p-8 text-center text-slate-500 text-sm">No messages found.</div>'; return; }
				$('messagesList').innerHTML = data.slice(0, 8).map(m => `
					<div class="p-4 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
						<div class="flex justify-between items-start mb-2">
							<div><h3 class="text-sm font-bold text-slate-900 dark:text-white">${esc(m.name)}</h3>
							<a href="mailto:${esc(m.email)}" class="text-xs text-blue-500 hover:underline">${esc(m.email)}</a></div>
							<span class="text-[10px] font-mono text-slate-500">#${m.id}</span>
						</div>
						<p class="text-sm text-slate-600 dark:text-slate-400 bg-slate-50 dark:bg-slate-950 p-3 rounded border border-slate-100 dark:border-slate-800">${esc(m.message)}</p>
					</div>`).join('');
			} catch (e) { $('messagesList').innerHTML = '<div class="p-8 text-center text-red-500 text-sm">Failed to load messages.</div>'; }
		}
		$('exportBtn').addEventListener('click', async () => {
			try { downloadCsv('audit-log.csv', await api('/api/admin/audit')); toast('Audit log exported'); }
			catch (e) { toast(e.message, true); }
		});
		$('refreshBtn').addEventListener('click', () => { fetchStats(); fetchMessages(); });
		fetchStats(); fetchMessages();
	</script>
</AdminLayout>