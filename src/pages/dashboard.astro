---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Admin Command">
	<div class="max-w-6xl mx-auto space-y-8">
		
		<!-- Header -->
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
			<div>
				<h1 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
					Admin Command Center
					<span class="text-xs bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-900/50 px-2.5 py-1 rounded-full uppercase tracking-wider font-bold">Root Access</span>
				</h1>
				<p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Global overview of RMG infrastructure and client data.</p>
			</div>
		</div>

		<!-- Stats Grid -->
		<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Total Users</p>
				<p id="statUsers" class="text-3xl font-bold text-slate-900 dark:text-white">...</p>
			</div>
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Active Tickets</p>
				<p class="text-3xl font-bold text-slate-900 dark:text-white">0</p>
			</div>
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">API Requests</p>
				<p class="text-3xl font-bold text-slate-900 dark:text-white">0</p>
			</div>
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">System Status</p>
				<p class="text-lg font-bold text-emerald-500 mt-1 flex items-center gap-2">
					<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Online
				</p>
			</div>
		</div>

		<!-- Inbox (Contact Messages) -->
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
			<div class="p-6 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
				<div>
					<h2 class="text-lg font-bold text-slate-900 dark:text-white">Marketing Inbox</h2>
					<p class="text-sm text-slate-500 dark:text-slate-400">Messages from the public contact form.</p>
				</div>
				<button id="refreshBtn" class="bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 px-4 py-2 rounded-lg transition-colors text-sm font-semibold flex items-center gap-2">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
					Refresh
				</button>
			</div>

			<!-- Message List -->
			<div id="messagesList" class="divide-y divide-slate-100 dark:divide-slate-800">
				<!-- Loading State -->
				<div class="p-8 text-center text-slate-500 dark:text-slate-400 text-sm animate-pulse">
					Fetching secure data from API...
				</div>
			</div>
		</div>

	</div>

	<script is:inline>
		const token = localStorage.getItem('rmg_token');
		const API_URL = 'https://rmg-api-e46k.onrender.com';
		const messagesList = document.getElementById('messagesList');
		const statUsers = document.getElementById('statUsers');

		// 1. Fetch Stats
		async function fetchStats() {
			try {
				const res = await fetch(`${API_URL}/api/stats`);
				const data = await res.json();
				statUsers.innerText = data.global_users;
			} catch(e) { statUsers.innerText = "Err"; }
		}

		// 2. Fetch Contact Messages
		async function fetchMessages() {
			messagesList.innerHTML = '<div class="p-8 text-center text-slate-500 dark:text-slate-400 text-sm animate-pulse">Fetching data...</div>';
			
			try {
				const res = await fetch(`${API_URL}/api/messages`, {
					headers: { 'Authorization': `Bearer ${token}` }
				});
				
				if (res.status === 401 || res.status === 403) {
					alert("Admin access required.");
					window.location.href = '/login';
					return;
				}

				const data = await res.json();

				if (data.length === 0) {
					messagesList.innerHTML = '<div class="p-8 text-center text-slate-500 dark:text-slate-400 text-sm">No messages found.</div>';
					return;
				}

				messagesList.innerHTML = data.map(msg => `
					<div class="p-6 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
						<div class="flex justify-between items-start mb-2">
							<div class="flex items-center gap-3">
								<div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center text-slate-700 dark:text-slate-300 font-bold">
									${msg.name.charAt(0).toUpperCase()}
								</div>
								<div>
									<h3 class="text-sm font-bold text-slate-900 dark:text-white">${msg.name}</h3>
									<a href="mailto:${msg.email}" class="text-xs text-blue-500 hover:underline">${msg.email}</a>
								</div>
							</div>
							<span class="text-xs font-semibold text-slate-400 bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded">ID: #${msg.id}</span>
						</div>
						<p class="text-sm text-slate-600 dark:text-slate-400 mt-4 leading-relaxed bg-slate-50 dark:bg-slate-950 p-4 rounded-lg border border-slate-100 dark:border-slate-800">
							${msg.message}
						</p>
					</div>
				`).join('');

			} catch (error) {
				messagesList.innerHTML = '<div class="p-8 text-center text-red-500 text-sm">Failed to connect to API.</div>';
			}
		}

		// Initialize
		fetchStats();
		fetchMessages();
		document.getElementById('refreshBtn').addEventListener('click', fetchMessages);
	</script>
</AppLayout>