---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Admin Dashboard">
	<!-- Wrap in a dark, full-screen container -->
	<div class="bg-[#05080f] min-h-screen w-full py-12">
		<main class="max-w-7xl mx-auto px-8">
			
			<!-- Header -->
			<div class="flex items-center justify-between mb-10 pb-6 border-b border-slate-800">
				<div>
					<h1 class="text-3xl font-bold tracking-tight text-white flex items-center gap-3">
						Command Center
						<span class="text-xs bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2 py-1 rounded-full uppercase tracking-wider font-semibold">Admin</span>
					</h1>
					<p class="text-slate-400 mt-1">System overview and client communications.</p>
				</div>
				<div class="flex gap-3">
					<button id="refreshBtn" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white px-4 py-2 rounded-lg transition-all text-sm font-medium flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
						Refresh
					</button>
					<button id="logoutBtn" class="bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-red-500/20 px-4 py-2 rounded-lg transition-all text-sm font-medium flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
						Log Out
					</button>
				</div>
			</div>

			<!-- Stats Grid -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
				<!-- Stat 1 -->
				<div class="bg-slate-900 border border-slate-800 p-6 rounded-xl relative overflow-hidden group">
					<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 text-blue-500"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
					</div>
					<h3 class="text-slate-400 text-sm font-medium mb-1">Total Messages</h3>
					<p id="msgCount" class="text-4xl font-bold text-white">0</p>
				</div>

				<!-- Stat 2 -->
				<div class="bg-slate-900 border border-slate-800 p-6 rounded-xl relative overflow-hidden group">
					<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 text-emerald-500"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
					</div>
					<h3 class="text-slate-400 text-sm font-medium mb-1">Active Clients</h3>
					<p class="text-4xl font-bold text-white">—</p>
				</div>

				<!-- Stat 3 -->
				<div class="bg-slate-900 border border-slate-800 p-6 rounded-xl relative overflow-hidden group">
					<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 text-purple-500"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3V6.75a3 3 0 013-3h13.5a3 3 0 013 3v4.5a3 3 0 01-3 3m-13.5 0v3.75a3 3 0 003 3h7.5a3 3 0 003-3v-3.75" /></svg>
					</div>
					<h3 class="text-slate-400 text-sm font-medium mb-1">System Status</h3>
					<div class="flex items-center gap-2 mt-2">
						<span class="w-3 h-3 bg-emerald-500 rounded-full animate-pulse"></span>
						<p class="text-lg font-semibold text-white">Operational</p>
					</div>
				</div>
			</div>

			<!-- Data Table Section -->
			<div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
				<div class="px-6 py-5 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
					<h2 class="text-lg font-semibold text-white">Inbox Messages</h2>
				</div>
				
				<div id="messages-container" class="overflow-x-auto">
					<!-- Loading state -->
					<div class="p-8 text-center">
						<svg class="animate-spin h-8 w-8 text-blue-500 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
						<p class="text-slate-400">Fetching secure data...</p>
					</div>
				</div>
			</div>

		</main>
	</div>

	<script is:inline>
		// SECURITY CHECK
		const token = localStorage.getItem('rmg_token');
		const role = localStorage.getItem('rmg_role');

		if (!token || role !== 'admin') {
			window.location.href = '/login';
		}

		// LOGOUT
		document.getElementById('logoutBtn').addEventListener('click', () => {
			localStorage.removeItem('rmg_token');
			localStorage.removeItem('rmg_role');
			localStorage.removeItem('rmg_name');
			window.location.href = '/login';
		});

		// FETCH DATA
		async function fetchMessages() {
			const container = document.getElementById('messages-container');
			const countDisplay = document.getElementById('msgCount');
			
			container.innerHTML = '<div class="p-8 text-center"><p class="text-slate-400">Syncing...</p></div>';

			try {
				const response = await fetch('https://rmg-api-e46k.onrender.com/api/messages', {
					headers: {
						'Authorization': `Bearer ${localStorage.getItem('rmg_token')}`
					}
				});
				
				if (response.status === 401 || response.status === 403) {
					localStorage.removeItem('rmg_token');
					localStorage.removeItem('rmg_role');
					window.location.href = '/login';
					return;
				}

				const data = await response.json();
				countDisplay.innerText = data.length;

				if (data.length === 0) {
					container.innerHTML = '<div class="p-12 text-center text-slate-500"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 mx-auto mb-3 text-slate-700"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg><p>Inbox is clean. No messages found.</p></div>';
					return;
				}

				// Build the table
				let html = `
					<table class="w-full text-left border-collapse">
						<thead>
							<tr class="border-b border-slate-800 text-xs uppercase tracking-wider text-slate-500 bg-slate-900/30">
								<th class="px-6 py-4 font-medium">Client Details</th>
								<th class="px-6 py-4 font-medium">Message</th>
								<th class="px-6 py-4 font-medium text-right">Action</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-800/50">
				`;

				data.forEach(msg => {
					html += `
						<tr class="hover:bg-slate-800/30 transition-colors group">
							<td class="px-6 py-5">
								<div class="font-medium text-white mb-1">${msg.name}</div>
								<a href="mailto:${msg.email}" class="text-sm text-blue-400 hover:underline">${msg.email}</a>
							</td>
							<td class="px-6 py-5">
								<p class="text-sm text-slate-300 max-w-lg leading-relaxed">${msg.message}</p>
							</td>
							<td class="px-6 py-5 text-right">
								<a href="mailto:${msg.email}" class="inline-flex items-center gap-2 text-sm font-medium text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 px-3 py-1.5 rounded-md transition-colors opacity-0 group-hover:opacity-100">
									Reply
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" /></svg>
								</a>
							</td>
						</tr>
					`;
				});

				html += `</tbody></table>`;
				container.innerHTML = html;

			} catch (error) {
				container.innerHTML = '<div class="p-8 text-center text-red-400"><p>Error connecting to the secure API.</p></div>';
			}
		}

		fetchMessages();
		document.getElementById('refreshBtn').addEventListener('click', fetchMessages);
	</script>
</AppLayout>