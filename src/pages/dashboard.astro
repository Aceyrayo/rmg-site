---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Dashboard">
	<main class="max-w-5xl mx-auto px-8 py-16">
		<div class="flex items-center justify-between mb-8">
			<div>
				<h1 class="text-3xl font-bold text-white">Inbox</h1>
				<p class="text-slate-400">Messages from the contact form.</p>
			</div>
			<button id="refreshBtn" class="bg-slate-800 hover:bg-slate-700 text-white px-4 py-2 rounded-md transition-colors text-sm font-medium">
				Refresh Data
			</button>
		</div>

		<!-- This is where the messages will appear -->
		<div id="messages-container" class="space-y-4">
			<p class="text-slate-500 animate-pulse">Loading messages from database...</p>
		</div>
	</main>

	<script is:inline>
		async function fetchMessages() {
			const container = document.getElementById('messages-container');
			container.innerHTML = '<p class="text-slate-500 animate-pulse">Loading...</p>';

			try {
				// The waiter goes to the kitchen to get all messages
				const response = await fetch('https://rmg-api-e46k.onrender.com/api/messages');
				const data = await response.json();

				// If the database is empty
				if (data.length === 0) {
					container.innerHTML = '<p class="text-slate-500">No messages yet.</p>';
					return;
				}

				// Build the HTML for each message
				container.innerHTML = data.map(msg => `
					<div class="p-6 bg-slate-900 border border-slate-800 rounded-xl">
						<div class="flex justify-between items-start mb-2">
							<h3 class="font-bold text-white text-lg">${msg.name}</h3>
							<span class="text-xs text-slate-500 bg-slate-950 px-2 py-1 rounded border border-slate-800">
								ID: ${msg.id}
							</span>
						</div>
						<a href="mailto:${msg.email}" class="text-blue-400 text-sm hover:underline">${msg.email}</a>
						<p class="text-slate-300 mt-4 leading-relaxed text-sm">${msg.message}</p>
					</div>
				`).join('');

			} catch (error) {
				container.innerHTML = '<p class="text-red-400">Error connecting to the API.</p>';
			}
		}

		// Run on page load
		fetchMessages();

		// Add click event to the refresh button
		document.getElementById('refreshBtn').addEventListener('click', fetchMessages);
	</script>
</Layout>