---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Admin Command">
	<div class="max-w-7xl mx-auto space-y-6">

		<!-- HEADER: Dark Mode Alert -->
		<div class="bg-slate-900 border border-slate-700 rounded-xl p-6 shadow-2xl relative overflow-hidden">
			<div class="absolute top-0 right-0 w-64 h-64 bg-red-500/10 blur-3xl rounded-full pointer-events-none"></div>
			<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10">
				<div>
					<h1 class="text-2xl font-bold text-white tracking-tight flex items-center gap-3">
						System Administrator
						<span class="text-xs bg-red-500/20 text-red-400 border border-red-500/30 px-2.5 py-1 rounded-full uppercase tracking-wider font-bold flex items-center gap-1.5">
							<span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-ping"></span>
							Root Access
						</span>
					</h1>
					<p class="text-slate-400 mt-1 text-sm font-mono">Node: US-East-1 | Version: v2.4.1-stable</p>
				</div>
				<div class="flex gap-3">
					<button class="bg-slate-800 hover:bg-slate-700 text-white border border-slate-600 px-4 py-2 rounded-lg text-sm font-semibold transition-colors flex items-center gap-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
						Export Logs
					</button>
					<button class="bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors flex items-center gap-2 shadow-lg shadow-red-900/20">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
						Deploy Update
					</button>
				</div>
			</div>
		</div>

		<!-- STATS GRID -->
		<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
			<!-- Stat 1 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm relative overflow-hidden">
				<div class="absolute -right-4 -top-4 w-16 h-16 bg-blue-500/10 rounded-full blur-xl"></div>
				<div class="flex justify-between items-start mb-4">
					<div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-900/30 text-blue-600 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
					</div>
					<span class="text-emerald-500 text-xs font-bold bg-emerald-50 dark:bg-emerald-900/20 px-2 py-1 rounded">+12%</span>
				</div>
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Total Registered Users</p>
				<p id="statUsers" class="text-3xl font-bold text-slate-900 dark:text-white">...</p>
			</div>

			<!-- Stat 2 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<div class="flex justify-between items-start mb-4">
					<div class="w-10 h-10 rounded-lg bg-purple-50 dark:bg-purple-900/30 text-purple-600 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
					</div>
				</div>
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Total API Calls (24h)</p>
				<p class="text-3xl font-bold text-slate-900 dark:text-white">842.1k</p>
			</div>

			<!-- Stat 3 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<div class="flex justify-between items-start mb-4">
					<div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-900/30 text-amber-600 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
					</div>
				</div>
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Open Support Tickets</p>
				<p class="text-3xl font-bold text-slate-900 dark:text-white">3</p>
			</div>

			<!-- Stat 4 -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl shadow-sm">
				<div class="flex justify-between items-start mb-4">
					<div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 flex items-center justify-center">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>
					</div>
					<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mt-2"></span>
				</div>
				<p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Server Health</p>
				<p class="text-3xl font-bold text-emerald-500">99.99%</p>
			</div>
		</div>

		<!-- BIZMANAGER WORKSPACES CONTROL PANEL -->
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
			<div class="p-5 border-b border-slate-200 dark:border-slate-800 flex flex-wrap justify-between items-center gap-3 bg-slate-50 dark:bg-slate-900/50">
				<div>
					<h2 class="text-lg font-bold text-slate-900 dark:text-white">BizManager Workspaces</h2>
					<p id="bizSummary" class="text-xs text-slate-500 mt-0.5">Loading businesses...</p>
				</div>
				<div class="flex flex-wrap items-center gap-2">
					<input id="bizSearch" type="text" placeholder="Search business or owner..." class="px-3 py-1.5 text-sm rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white">
					<select id="bizPlanFilter" class="px-3 py-1.5 text-sm rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white">
						<option value="">All plans</option>
						<option value="active">Active</option>
						<option value="trial">Trial</option>
						<option value="suspended">Suspended</option>
					</select>
					<button id="bizRefresh" class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline px-2">Refresh</button>
				</div>
			</div>
			<div id="bizWorkspacesList" class="divide-y divide-slate-100 dark:divide-slate-800">
				<div class="p-8 text-center text-slate-500 text-sm animate-pulse">Loading workspaces...</div>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

			<!-- LEFT COL: USER MANAGEMENT & INBOX -->
			<div class="lg:col-span-2 space-y-6">

				<!-- Inbox -->
				<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden">
					<div class="p-5 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center bg-slate-50 dark:bg-slate-900/50">
						<h2 class="text-lg font-bold text-slate-900 dark:text-white">Marketing Inbox</h2>
						<button id="refreshBtn" class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline">Refresh</button>
					</div>
					<div id="messagesList" class="divide-y divide-slate-100 dark:divide-slate-800 max-h-[400px] overflow-y-auto">
						<div class="p-8 text-center text-slate-500 text-sm animate-pulse">Fetching secure data...</div>
					</div>
				</div>

			</div>

			<!-- RIGHT COL: LIVE TERMINAL LOGS -->
			<div class="lg:col-span-1 space-y-6">
				<div class="bg-slate-950 border border-slate-800 rounded-xl shadow-lg overflow-hidden flex flex-col h-[400px]">
					<div class="p-3 border-b border-slate-800 flex items-center justify-between bg-slate-900">
						<div class="flex items-center gap-2">
							<div class="w-3 h-3 rounded-full bg-red-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
							<div class="w-3 h-3 rounded-full bg-green-500/80"></div>
							<span class="ml-2 text-xs font-mono text-slate-400">system.log</span>
						</div>
						<span class="text-xs text-emerald-400 font-mono animate-pulse">● LIVE</span>
					</div>
					<div class="p-4 flex-1 overflow-y-auto font-mono text-xs text-slate-300 space-y-2">
						<p><span class="text-slate-500">[10:42:01]</span> <span class="text-blue-400">INFO</span> DB connection established.</p>
						<p><span class="text-slate-500">[10:42:05]</span> <span class="text-emerald-400">SUCCESS</span> User authentication passed.</p>
						<p><span class="text-slate-500">[10:43:12]</span> <span class="text-amber-400">WARN</span> High latency detected on US-East.</p>
						<p><span class="text-slate-500">[10:43:15]</span> <span class="text-blue-400">INFO</span> Auto-scaling triggered (Node +2).</p>
						<p><span class="text-slate-500">[10:44:00]</span> <span class="text-emerald-400">SUCCESS</span> Backup completed (2.4GB).</p>
						<p class="animate-pulse"><span class="text-slate-500">[10:45:00]</span> <span class="text-slate-400">_</span></p>
					</div>
				</div>
			</div>

		</div>
	</div>

	<!-- WORKSPACE INSPECTOR MODAL -->
	<dialog id="bizModal" class="w-full max-w-4xl rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 p-0 shadow-2xl backdrop:bg-slate-950/70">
		<div class="p-5 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
			<div>
				<h3 id="bizModalTitle" class="text-lg font-bold">Workspace Inspector</h3>
				<p id="bizModalSub" class="text-xs text-slate-500 font-mono"></p>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<button data-biz-tab="members" class="biz-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 text-white">Team & Roles</button>
				<button data-biz-tab="sales" class="biz-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">Sales & Invoices</button>
				<button data-biz-tab="expenses" class="biz-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">Expenses</button>
				<button id="bizModalClose" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Close</button>
			</div>
		</div>

		<div id="bizModalStats" class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 bg-slate-50 dark:bg-slate-950/60 border-b border-slate-200 dark:border-slate-800 text-xs"></div>

		<div id="bizModalBody" class="p-5 max-h-[65vh] overflow-y-auto space-y-4 text-sm"></div>
	</dialog>

	<script is:inline>
		const token = localStorage.getItem('rmg_token');
		const API_URL = 'https://rmg-api-e46k.onrender.com';
		const messagesList = document.getElementById('messagesList');
		const statUsers = document.getElementById('statUsers');

		let allWorkspaces = [];
		const bizModal = document.getElementById('bizModal');
		let activeWsId = null;
		let activeTab = 'members';
		let cachedMembers = [];
		let cachedLedger = null;

		const money = (cur, n) => `${cur || 'USD'} ${Number(n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

		// Fetch Stats
		async function fetchStats() {
			try {
				const res = await fetch(`${API_URL}/api/stats`);
				const data = await res.json();
				statUsers.innerText = data.global_users;
			} catch (e) {
				statUsers.innerText = "Err";
			}
		}

		// Fetch Messages
		async function fetchMessages() {
			messagesList.innerHTML = '<div class="p-8 text-center text-slate-500 text-sm animate-pulse">Fetching data...</div>';

			try {
				const res = await fetch(`${API_URL}/api/messages`, {
					headers: { 'Authorization': `Bearer ${token}` }
				});

				if (res.status === 401 || res.status === 403) {
					alert("Admin access required.");
					window.location.href = '/login';
					return;
				}

				const data = await res.json();

				if (data.length === 0) {
					messagesList.innerHTML = '<div class="p-8 text-center text-slate-500 text-sm">No messages found.</div>';
					return;
				}

				messagesList.innerHTML = data.map(msg => `
					<div class="p-4 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
						<div class="flex justify-between items-start mb-2">
							<div class="flex items-center gap-3">
								<div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center text-slate-700 dark:text-slate-300 font-bold text-xs">
									${msg.name.charAt(0).toUpperCase()}
								</div>
								<div>
									<h3 class="text-sm font-bold text-slate-900 dark:text-white">${msg.name}</h3>
									<a href="mailto:${msg.email}" class="text-xs text-blue-500 hover:underline">${msg.email}</a>
								</div>
							</div>
							<span class="text-[10px] font-mono text-slate-500">#${msg.id}</span>
						</div>
						<p class="text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed bg-slate-50 dark:bg-slate-950 p-3 rounded border border-slate-100 dark:border-slate-800">
							${msg.message}
						</p>
					</div>
				`).join('');
			} catch (error) {
				messagesList.innerHTML = '<div class="p-8 text-center text-red-500 text-sm">Failed to connect to API.</div>';
			}
		}

		// BizManager Workspaces
		async function fetchWorkspaces() {
			const box = document.getElementById('bizWorkspacesList');
			const sum = document.getElementById('bizSummary');
			try {
				const res = await fetch(`${API_URL}/api/biz/admin/workspaces`, {
					headers: { 'Authorization': `Bearer ${token}` }
				});
				if (!res.ok) throw new Error('Failed to load workspaces');
				allWorkspaces = await res.json();
				renderWorkspaces();
			} catch (err) {
				sum.textContent = 'Unable to load businesses';
				box.innerHTML = `<div class="p-6 text-center text-red-500 text-sm">${err.message}</div>`;
			}
		}

		function renderWorkspaces() {
			const box = document.getElementById('bizWorkspacesList');
			const sum = document.getElementById('bizSummary');
			const q = (document.getElementById('bizSearch')?.value || '').trim().toLowerCase();
			const pf = document.getElementById('bizPlanFilter')?.value || '';

			const filtered = allWorkspaces.filter(w =>
				(!pf || w.plan === pf) &&
				(!q || `${w.name} ${w.owner} #${w.id}`.toLowerCase().includes(q))
			);

			const activeCount = allWorkspaces.filter(w => w.plan === 'active').length;
			const trialCount = allWorkspaces.filter(w => w.plan === 'trial').length;
			sum.textContent = `${allWorkspaces.length} total · ${activeCount} active · ${trialCount} on trial`;

			if (!filtered.length) {
				box.innerHTML = '<div class="p-8 text-center text-slate-500 text-sm">No matching businesses found.</div>';
				return;
			}

			const badgeCls = {
				active: 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/30',
				trial: 'bg-blue-500/15 text-blue-600 dark:text-blue-400 border-blue-500/30',
				suspended: 'bg-red-500/15 text-red-600 dark:text-red-400 border-red-500/30'
			};

			box.innerHTML = filtered.map(w => `
				<div class="p-4 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
					<div class="space-y-1">
						<div class="flex items-center gap-2.5 flex-wrap">
							<span class="font-bold text-slate-900 dark:text-white">${w.name}</span>
							<span class="text-xs px-2 py-0.5 rounded-full border font-semibold uppercase ${badgeCls[w.plan] || ''}">${w.plan}</span>
							<span class="text-xs font-mono text-slate-400">#${w.id}</span>
						</div>
						<p class="text-xs text-slate-500">
							Owner: <b class="text-slate-700 dark:text-slate-300">${w.owner}</b> ·
							Trial ends: <span class="font-mono">${w.trial_ends || '—'}</span> ·
							${w.products} products · ${w.documents} docs · ${w.members} members
						</p>
					</div>
					<div class="flex flex-wrap items-center gap-2">
						<select data-plan-id="${w.id}" class="px-2.5 py-1.5 text-xs rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-white">
							<option value="trial" ${w.plan === 'trial' ? 'selected' : ''}>Trial</option>
							<option value="active" ${w.plan === 'active' ? 'selected' : ''}>Active</option>
							<option value="suspended" ${w.plan === 'suspended' ? 'selected' : ''}>Suspended</option>
						</select>
						<button data-extend="${w.id}" data-days="14" class="px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200">+14d trial</button>
						<button data-extend="${w.id}" data-days="30" class="px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200">+30d trial</button>
						<button data-inspect="${w.id}" class="px-2.5 py-1.5 text-xs font-semibold rounded-lg border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300">Inspect</button>
						<a href="/biz?ws=${w.id}" class="px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-blue-600 hover:bg-blue-500 text-white">Open Biz</a>
					</div>
				</div>
			`).join('');
		}

		async function patchWorkspace(wsId, payload) {
			const res = await fetch(`${API_URL}/api/biz/admin/workspaces/${wsId}`, {
				method: 'PATCH',
				headers: {
					'Authorization': `Bearer ${token}`,
					'Content-Type': 'application/json'
				},
				body: JSON.stringify(payload)
			});
			if (!res.ok) {
				const err = await res.json().catch(() => ({}));
				throw new Error(err.detail || 'Update failed');
			}
			await fetchWorkspaces();
		}

		async function openWorkspaceInspector(wsId, tab = 'members') {
			activeWsId = Number(wsId);
			activeTab = tab;
			const ws = allWorkspaces.find(w => w.id === activeWsId);
			document.getElementById('bizModalTitle').textContent = ws ? ws.name : `Workspace #${activeWsId}`;
			document.getElementById('bizModalSub').textContent = ws ? `ID #${ws.id} · Owner: ${ws.owner} · Plan: ${ws.plan.toUpperCase()}` : '';
			document.getElementById('bizModalBody').innerHTML = '<div class="py-10 text-center text-slate-500 animate-pulse">Loading workspace data...</div>';
			if (!bizModal.open) bizModal.showModal();

			const headers = { 'Authorization': `Bearer ${token}` };
			const [memRes, ledRes] = await Promise.all([
				fetch(`${API_URL}/api/biz/admin/workspaces/${activeWsId}/members`, { headers }),
				fetch(`${API_URL}/api/biz/admin/workspaces/${activeWsId}/ledger?limit=100`, { headers })
			]);
			if (!memRes.ok || !ledRes.ok) {
				document.getElementById('bizModalBody').innerHTML = '<div class="py-8 text-center text-red-500">Failed to load workspace details.</div>';
				return;
			}
			cachedMembers = await memRes.json();
			cachedLedger = await ledRes.json();
			renderInspectorTab();
		}

		function renderInspectorTab() {
			document.querySelectorAll('.biz-tab').forEach(btn => {
				const on = btn.dataset.bizTab === activeTab;
				btn.className = `biz-tab px-3 py-1.5 rounded-lg text-xs font-semibold ${on ? 'bg-blue-600 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'}`;
			});

			const cur = cachedLedger?.workspace?.currency || 'USD';
			const s = cachedLedger?.summary || {};
			document.getElementById('bizModalStats').innerHTML = `
				<div class="p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800"><span class="text-slate-500 block">Revenue (excl. tax)</span><b class="text-sm">${money(cur, s.revenue)}</b></div>
				<div class="p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800"><span class="text-slate-500 block">Outstanding</span><b class="text-sm text-amber-500">${money(cur, s.outstanding)}</b></div>
				<div class="p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800"><span class="text-slate-500 block">Expenses</span><b class="text-sm">${money(cur, s.expenses)}</b></div>
				<div class="p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800"><span class="text-slate-500 block">Net (Rev − Exp)</span><b class="text-sm ${s.net_cash_view >= 0 ? 'text-emerald-500' : 'text-red-500'}">${money(cur, s.net_cash_view)}</b></div>
			`;

			const body = document.getElementById('bizModalBody');
			if (activeTab === 'members') {
				body.innerHTML = `
					<form id="adminAddMemberForm" class="flex flex-wrap gap-2 p-3 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
						<input name="email" type="email" required placeholder="user@example.com" class="flex-1 min-w-[200px] px-3 py-1.5 text-xs rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900">
						<select name="role" class="px-3 py-1.5 text-xs rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900">
							<option value="Manager">Manager</option>
							<option value="Cashier" selected>Cashier</option>
							<option value="Accountant">Accountant</option>
						</select>
						<button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-blue-600 hover:bg-blue-500 text-white">+ Add Member</button>
					</form>
					<div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-lg">
						<table class="w-full text-left text-xs">
							<thead class="bg-slate-50 dark:bg-slate-950 text-slate-500 uppercase">
								<tr><th class="p-3">Member</th><th class="p-3">Role</th><th class="p-3">Status</th><th class="p-3 text-right">Actions</th></tr>
							</thead>
							<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
								${cachedMembers.map(m => `
									<tr>
										<td class="p-3"><b>${m.name || m.email}</b><div class="text-slate-500">${m.email}</div></td>
										<td class="p-3">${m.id === 0 ? '<span class="px-2 py-0.5 rounded bg-red-500/15 text-red-500 font-semibold">Owner</span>' : `
											<select data-mem-role="${m.id}" class="px-2 py-1 rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950">
												${['Manager', 'Cashier', 'Accountant'].map(r => `<option ${r === m.role ? 'selected' : ''}>${r}</option>`).join('')}
											</select>`}
										</td>
										<td class="p-3">
											<span class="px-2 py-0.5 rounded-full font-semibold ${m.status === 'Active' ? 'bg-emerald-500/15 text-emerald-500' : 'bg-amber-500/15 text-amber-500'}">${m.status}</span>
										</td>
										<td class="p-3 text-right space-x-1">
											${m.id !== 0 && m.status === 'Invited' ? `<button data-mem-activate="${m.id}" class="px-2 py-1 rounded bg-emerald-600 text-white font-semibold">Activate</button>` : ''}
											${m.id !== 0 ? `<button data-mem-del="${m.id}" class="px-2 py-1 rounded bg-red-600/15 text-red-500 hover:bg-red-600 hover:text-white font-semibold">Remove</button>` : '—'}
										</td>
									</tr>
								`).join('')}
							</tbody>
						</table>
					</div>
				`;
			} else if (activeTab === 'sales') {
				const rows = cachedLedger?.sales || [];
				body.innerHTML = rows.length ? `
					<div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-lg">
						<table class="w-full text-left text-xs">
							<thead class="bg-slate-50 dark:bg-slate-950 text-slate-500 uppercase">
								<tr><th class="p-3">Number</th><th class="p-3">Date</th><th class="p-3">Customer</th><th class="p-3">Total</th><th class="p-3">Balance</th><th class="p-3">Status</th></tr>
							</thead>
							<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
								${rows.map(x => `
									<tr>
										<td class="p-3 font-mono font-semibold">${x.number}</td>
										<td class="p-3">${x.date}</td>
										<td class="p-3">${x.customer_name || 'Walk-in'}</td>
										<td class="p-3 font-semibold">${money(cur, x.total)}</td>
										<td class="p-3 ${x.balance > 0 ? 'text-amber-500 font-semibold' : 'text-slate-400'}">${x.balance > 0 ? money(cur, x.balance) : '—'}</td>
										<td class="p-3">${x.status}</td>
									</tr>
								`).join('')}
							</tbody>
						</table>
					</div>` : '<div class="py-8 text-center text-slate-500">No sales or invoices recorded yet.</div>';
			} else {
				const rows = cachedLedger?.expenses || [];
				body.innerHTML = rows.length ? `
					<div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-lg">
						<table class="w-full text-left text-xs">
							<thead class="bg-slate-50 dark:bg-slate-950 text-slate-500 uppercase">
								<tr><th class="p-3">Date</th><th class="p-3">Category</th><th class="p-3">Vendor / Description</th><th class="p-3 text-right">Amount</th></tr>
							</thead>
							<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
								${rows.map(x => `
									<tr>
										<td class="p-3">${x.date}</td>
										<td class="p-3 font-semibold">${x.category}</td>
										<td class="p-3"><b>${x.vendor || '—'}</b> <span class="text-slate-500">${x.description || ''}</span></td>
										<td class="p-3 text-right font-semibold">${money(cur, x.amount)}</td>
									</tr>
								`).join('')}
							</tbody>
						</table>
					</div>` : '<div class="py-8 text-center text-slate-500">No expenses recorded yet.</div>';
			}
		}

		document.getElementById('bizWorkspacesList').addEventListener('change', async e => {
			const sel = e.target.closest('[data-plan-id]');
			if (!sel) return;
			try {
				await patchWorkspace(sel.dataset.planId, { plan: sel.value });
			} catch (err) {
				alert(err.message);
				fetchWorkspaces();
			}
		});

		document.getElementById('bizWorkspacesList').addEventListener('click', async e => {
			const ext = e.target.closest('[data-extend]');
			if (ext) {
				try {
					await patchWorkspace(ext.dataset.extend, { extend_days: Number(ext.dataset.days) });
				} catch (err) {
					alert(err.message);
				}
				return;
			}
			const inspectBtn = e.target.closest('[data-inspect]');
			if (inspectBtn) {
				openWorkspaceInspector(inspectBtn.dataset.inspect, 'members');
			}
		});

		document.getElementById('bizModalClose').addEventListener('click', () => bizModal.close());
		bizModal.addEventListener('click', async e => {
			const tabBtn = e.target.closest('[data-biz-tab]');
			if (tabBtn) {
				activeTab = tabBtn.dataset.bizTab;
				renderInspectorTab();
				return;
			}
			const actBtn = e.target.closest('[data-mem-activate]');
			if (actBtn) {
				const res = await fetch(`${API_URL}/api/biz/admin/workspaces/${activeWsId}/members/${actBtn.dataset.memActivate}`, {
					method: 'PATCH',
					headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
					body: JSON.stringify({ status: 'Active' })
				});
				if (!res.ok) return alert((await res.json().catch(() => ({}))).detail || 'Activation failed');
				await openWorkspaceInspector(activeWsId, 'members');
				return;
			}
			const delBtn = e.target.closest('[data-mem-del]');
			if (delBtn && confirm('Remove this member from the workspace?')) {
				const res = await fetch(`${API_URL}/api/biz/admin/workspaces/${activeWsId}/members/${delBtn.dataset.memDel}`, {
					method: 'DELETE',
					headers: { 'Authorization': `Bearer ${token}` }
				});
				if (!res.ok) return alert((await res.json().catch(() => ({}))).detail || 'Remove failed');
				await openWorkspaceInspector(activeWsId, 'members');
				fetchWorkspaces();
			}
		});

		bizModal.addEventListener('change', async e => {
			const sel = e.target.closest('[data-mem-role]');
			if (!sel) return;
			const res = await fetch(`${API_URL}/api/biz/admin/workspaces/${activeWsId}/members/${sel.dataset.memRole}`, {
				method: 'PATCH',
				headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
				body: JSON.stringify({ role: sel.value })
			});
			if (!res.ok) alert((await res.json().catch(() => ({}))).detail || 'Role update failed');
			await openWorkspaceInspector(activeWsId, 'members');
		});

		bizModal.addEventListener('submit', async e => {
			if (e.target.id !== 'adminAddMemberForm') return;
			e.preventDefault();
			const fd = new FormData(e.target);
			const res = await fetch(`${API_URL}/api/biz/admin/workspaces/${activeWsId}/members`, {
				method: 'POST',
				headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: fd.get('email'), role: fd.get('role'), activate_if_registered: true })
			});
			if (!res.ok) return alert((await res.json().catch(() => ({}))).detail || 'Failed to add member');
			await openWorkspaceInspector(activeWsId, 'members');
			fetchWorkspaces();
		});

		document.getElementById('bizSearch').addEventListener('input', renderWorkspaces);
		document.getElementById('bizPlanFilter').addEventListener('change', renderWorkspaces);
		document.getElementById('bizRefresh').addEventListener('click', fetchWorkspaces);

		fetchStats();
		fetchMessages();
		fetchWorkspaces();
		document.getElementById('refreshBtn').addEventListener('click', fetchMessages);
	</script>
</AppLayout>